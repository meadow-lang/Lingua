use Std.Test (assertEq)

fun v (s : String) : Version = M.unwrapOr (Version 0 0 0 "none") (versionOf s)

@test fun aVersionIsReadWithOrWithoutItsV () =
  assertEq
    (V.map versionOf ["1.2.3", "v1.2.3", "v1.2.3-rc1", "1.2.3+build7"])
    [
      Just (Version 1 2 3 ""),
      Just (Version 1 2 3 ""),
      Just (Version 1 2 3 "rc1"),
      Just (Version 1 2 3 "")
    ]
    "as Idyll's driver reads them"

@test fun whatIsNotAReleaseIsNoVersion () =
  assertEq
    (V.filter (\t -> M.isSome (versionOf t)) [
       "", "v", "1", "1.2", "1.2.3.4", "1.2.x", "v01.2.3", "1.2.-3", "release-1", "1.2.3-"
     ])
    []
    "none of them"

@test fun aReleaseOutranksItsPreReleases () =
  assertEq
    (
      compareVersions (v "1.0.0") (v "1.0.0-rc2"),
      compareVersions (v "1.0.0-rc2") (v "1.0.0-rc1"),
      compareVersions (v "1.0.0-rc.10") (v "1.0.0-rc.2"),
      compareVersions (v "1.0.0-rc10") (v "1.0.0-rc2"),
      compareVersions (v "1.0.0-1") (v "1.0.0-alpha"),
      compareVersions (v "0.2.0") (v "0.1.9")
    )
    (1, 1, 1, 0 - 1, 0 - 1, 1)
    "semver's order"

@test fun aRequirementTakesWhatDoesNotBreakIt () =
  let q = M.unwrapOr (Req (v "9.9.9")) (reqOf "1.2.0") in
  let z = M.unwrapOr (Req (v "9.9.9")) (reqOf "0.3.1") in
  assertEq
    (
      V.map (\s -> allows q (v s)) ["1.2.0", "1.9.3", "1.1.9", "2.0.0", "1.3.0-rc1"],
      V.map (\s -> allows z (v s)) ["0.3.1", "0.3.9", "0.4.0", "0.3.0"],
      reqOf "^1.2.0" == reqOf "1.2.0"
    )
    ([True, True, False, False, False], [True, True, False, False], True)
    "below the next breaking release, pre-releases only if asked for"

@test fun theBestIsTheNewestThatFits () =
  let have = V.map v ["0.9.0", "1.0.0", "1.4.2", "1.4.10", "2.0.0"] in
  assertEq
    (
      M.map showVersion (bestOf (Req (v "1.0.0")) have),
      M.map showVersion (bestOf (Req (v "3.0.0")) have)
    )
    (Just "1.4.10", None)
    "1.4.10, and nothing for 3"

@test fun aLockIsWrittenAsIdyllsDriverWritesItAndReadBack () =
  let entries =
    [
      Locked "text" "git+https://e.com/text?tag=v1" "bbb" "t2" "",
      Locked "json" "git+https://e.com/json?version=1.2.0" "aaa" "t1" "1.4.0"
    ]
  in
  let text = lockText "idyll" entries in
  let a =
    assertEq
      text
      "# Written by idyll. Commit this file: it is what makes a build on\n# another machine the build you tested. Change it with `idyll update`.\n\nversion = 1\n\n[[package]]\nname = \"json\"\nsource = \"git+https://e.com/json?version=1.2.0\"\nversion = \"1.4.0\"\nrev = \"aaa\"\ntree = \"t1\"\n\n[[package]]\nname = \"text\"\nsource = \"git+https://e.com/text?tag=v1\"\nrev = \"bbb\"\ntree = \"t2\"\n"
      "sorted by name, the version before the commit, as lock.rs renders it"
  in
  let b = assertEq (lockOf text) (V.reverse entries) "and read back" in
  assertEq
    (lockOf "version = 99\n\n[[package]]\nname = \"json\"\nsource = \"s\"\nrev = \"r\"\n")
    []
    "a lock from a later format is not guessed at"

@test fun aSourceSaysWhichReferenceWasAskedFor () =
  assertEq
    (
      sourceOf "https://e.com/j" (GitRef.Tag "v1"),
      sourceOf "https://e.com/j" GitRef.Default,
      sourceOf "https://e.com/j" (GitRef.Release (Req (v "1.2.0")))
    )
    ("git+https://e.com/j?tag=v1", "git+https://e.com/j", "git+https://e.com/j?version=1.2.0")
    "as lock.rs writes them"

@test fun aUrlThatWouldRunACommandIsRefused () =
  assertEq
    (V.map (\u -> match safeUrl u with | Ok _ -> True | Err _ -> False) [
       "https://e.com/r", "git@github.com:me/r.git", "/srv/r", "../r", "C:\\r", "-upload-pack=x",
       "ext::sh -c x", ""
     ])
    [True, True, True, True, True, False, False, False]
    "the ordinary transports and paths, and nothing that is an option or a helper"

@test fun aSlugIsReadableAndOneRepositoryIsOneSlug () =
  let a = slugOf "https://github.com/someone/idyll-json" in
  assertEq
    (
      S.startsWith "idyll-json-" a,
      a != slugOf "https://github.com/other/idyll-json",
      slugOf "https://github.com/someone/idyll-json.git" == a,
      slugOf "https://github.com/someone/idyll-json/" == a,
      S.startsWith "idyll-json-" (slugOf "git@github.com:someone/idyll-json.git")
    )
    (True, True, True, True, True)
    "named for the repository, apart from another of the same name, whatever the spelling"

-- --- with git ------------------------------------------------------------------
--
-- Repositories made on the spot, so these need git and no network.

use Std.Fs (removeFile)

-- A repository at `dir` with one file, tagged with each of `tags` in turn, a
-- commit each: `v1.0.0` then `v1.2.0` and so on.
fun repoWith (dir : String) (tags : [String]) =
  let w = removeDirAll dir in
  let u = createDirAll dir in
  let a = git (Just dir) ["init", "--quiet", "-b", "main"] in
  V.foldl
    (\acc t ->
      let x = writeString (Path.join dir "lib.txt", t) in
      let y = git (Just dir) ["add", "-A"] in
      let z =
        git (Just dir) ["-c", "user.email=t@t", "-c", "user.name=t", "commit", "--quiet", "-m", t]
      in
      let q = git (Just dir) ["tag", t] in
      ())
    ()
    tags

fun absolute (p : String) =
  match spawn ("git", ["-C", p, "rev-parse", "--show-toplevel"], None, []) with
  | Ok (0, out, _) -> S.trim out
  | _ -> p

@test fun aReleaseIsChosenFetchedAndLockedAndTheLockNeedsNoNetwork () =
  let base = "target/lingua-resolve-test" in
  let r0 = removeDirAll base in
  let repo = Path.join base "json" in
  let made = repoWith repo ["v1.0.0", "v1.2.0", "v2.0.0"] in
  let url = absolute repo in
  let cache = Path.join base "cache" in
  let lock = Path.join base "test.lock" in
  let dep = Dep.Git "json" url (GitRef.Release (Req (v "1.0.0"))) in
  let first = resolver cache lock False False False [] in
  let dir = resolve first base dep in
  let a =
    assertEq
      (M.map
         (\d -> S.trim (M.unwrapOr "" (okOf (readToString (Path.join d "lib.txt")))))
         (okOf dir))
      (Just "v1.2.0")
      "the newest release below 2.0, checked out"
  in
  let s = settle first "test" in
  let entries = lockOf (M.unwrapOr "" (okOf (readToString lock))) in
  let b =
    assertEq
      (V.map (\l -> match l with | Locked n src _ _ ver -> (n, src, ver)) entries)
      [("json", "git+${url}?version=1.0.0", "1.2.0")]
      "locked: the requirement as asked, and the release it was"
  in
  -- The repository goes: a build with the lock, offline, still has it.
  let gone = removeDirAll repo in
  let offline = resolver cache lock True False False [] in
  let again = resolve offline base dep in
  assertEq
    (M.isSome (okOf again), okOf again == okOf dir)
    (True, True)
    "the same checkout, from the cache alone"

@test fun aTagThatMovedIsRefusedAndALockedBuildChangesNothing () =
  let base = "target/lingua-resolve-moved" in
  let r0 = removeDirAll base in
  let repo = Path.join base "text" in
  let made = repoWith repo ["v1.0.0"] in
  let url = absolute repo in
  let lock = Path.join base "test.lock" in
  let dep = Dep.Git "text" url (GitRef.Tag "v1.0.0") in
  let first = resolver (Path.join base "cache-a") lock False False False [] in
  let d = resolve first base dep in
  let s = settle first "test" in
  -- The tag is moved, as a force-push moves it, and another machine with an
  -- empty cache builds from the lock.
  let x = writeString (Path.join repo "lib.txt", "different") in
  let y = git (Just repo) ["add", "-A"] in
  let z =
    git (Just repo) [
      "-c", "user.email=t@t", "-c", "user.name=t", "commit", "--quiet", "-m", "moved"
    ]
  in
  let q = git (Just repo) ["tag", "-f", "v1.0.0"] in
  let other = resolver (Path.join base "cache-b") lock False False False [] in
  let moved = resolve other base dep in
  let a =
    assertEq
      (match moved with
       | Err why -> S.contains "now names commit" why
       | Ok _ -> False)
      True
      "a moved tag is refused, not followed"
  in
  let locked = resolver (Path.join base "cache-a") lock False True False [] in
  let newDep = resolve locked base (Dep.Git "other" url GitRef.Default) in
  assertEq
    (match newDep with
     | Err why -> S.contains "the build is locked" why
     | Ok _ -> False)
    True
    "and a locked build refuses what the lock does not pin"

@test fun anUpdateTakesTheNewestAndSaysWhatMoved () =
  let base = "target/lingua-resolve-update" in
  let r0 = removeDirAll base in
  let repo = Path.join base "json" in
  let made = repoWith repo ["v1.0.0"] in
  let url = absolute repo in
  let cache = Path.join base "cache" in
  let lock = Path.join base "test.lock" in
  let dep = Dep.Git "json" url (GitRef.Release (Req (v "1.0.0"))) in
  let first = resolver cache lock False False False [] in
  let d = resolve first base dep in
  let s = settle first "test" in
  let more = repoWithMore repo "v1.3.0" in
  -- A build keeps what the lock has; an update takes the newer release.
  let build = resolver cache lock False False False [] in
  let kept = resolve build base dep in
  let k = settle build "test" in
  let keptVersion = V.map lockedVersion (lockOf (M.unwrapOr "" (okOf (readToString lock)))) in
  let update = resolver cache lock False False True [] in
  let u = resolve update base dep in
  let moved = movedBy update in
  let w = settle update "test" in
  assertEq
    (keptVersion, moved, V.map lockedVersion (lockOf (M.unwrapOr "" (okOf (readToString lock)))))
    (["1.0.0"], [("json", "1.0.0", "1.3.0")], ["1.3.0"])
    "the lock kept by a build, moved by an update, and the move said"

fun repoWithMore (dir : String) (tag : String) =
  let x = writeString (Path.join dir "lib.txt", tag) in
  let y = git (Just dir) ["add", "-A"] in
  let z =
    git (Just dir) ["-c", "user.email=t@t", "-c", "user.name=t", "commit", "--quiet", "-m", tag]
  in git (Just dir) ["tag", tag]
