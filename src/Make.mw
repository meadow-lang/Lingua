-- `make!`: a build system over compilation units.
--
--   make! {
--     pub Build "miniml"
--     | sources = ".ml"
--     | manifest = "Unit"
--     | compile = compileUnit
--   }
--
-- A **unit** is a directory with a manifest in it: a file named by
-- `manifest`, each line of which is a unit it depends on, as a path from it.
-- Its sources are its files ending in `sources`. The build system works out
-- the graph of units from the one it is asked to build, and gives each to the
-- compiler -- `compile`, a function of a `Given`: its sources, the interfaces
-- of the units it depends on, and a directory of its own to write into -- in
-- dependency order, each on a thread of its own as soon as the units it
-- depends on are done: it waits for those, and for no other. A build is
-- parallel unless it says otherwise: `| parallel = false` compiles one unit
-- after another, and is a build with no thread in it.
--
-- What happens between units is the build system's: a unit is compiled again
-- only if its sources, or an interface it was compiled against, are not what
-- they were -- so a change to a unit that leaves its interface as it was
-- compiles that unit and nothing that depends on it. What was built is kept
-- between runs under `target`: fingerprints in `lingua-build.json`, and each
-- unit's interface -- `Reflect`, so that it can be -- in a file of its own
-- under `interfaces`, read only when something needs it. What happens inside a unit is the
-- compiler's: its own queries, its own threads, its own cache in the
-- directory it is given.
--
-- The compiler is held to that. It runs under a handler for `Fs` through
-- which it can read its unit's sources and what is in its own directory, and
-- write only in that directory; anything else it asks for fails, so a read
-- the build system did not know about cannot leave a unit's answer stale.
--
-- A language whose units say more than a list of paths -- Meadow's
-- `Meadow.toml`, with packages fetched from elsewhere -- says how to read one:
-- `| dependencies = depsOf`, a function of the root unit, a unit's directory
-- and its manifest's text, answering the directories it depends on; and one
-- whose sources are not the files beside the manifest -- a `src/` of modules --
-- says where they are: `| files = sourcesOf`, a function of a unit's directory
-- answering its sources' paths.
--
-- A language whose program is more than its units' interfaces -- one made by
-- a back end that is another program, from what every unit wrote -- says how
-- it is put together: `| link = linkProgram`, a function of a `Linking`: the
-- root unit, every unit of the build in dependency order -- each with its
-- interface and the directory it wrote into -- and a directory of the link's
-- own, `target/link`. It runs once every unit is built, and again only if a
-- unit was compiled from something else than it was the last time it ran:
-- what it leaves in its directory is the program until then, so what an
-- outside back end made is not made again. It may read what any unit wrote
-- and write only in its own directory.
--
-- What is written is `buildBuild root`: build the unit at `root` and every
-- unit it depends on, say how each went, and answer whether all of them did.
-- And `givenBuild root dir`: what the unit at `dir` was compiled from in
-- `root`'s last build -- its sources, and the interfaces it imported -- for a
-- tool that asks the compiler about a unit again.

use Std.Collections.Vector as V
use Std.Collections.HashMap as HashMap
use Std.String as S
use Std.Maybe as M
use Std.Path as Path
use Std.Json as J
use Std.Json (Json)
use Std.Thread as Thread
use Std.Compact as Compact
use Std.Fs (
  Fs, FileMeta, readToString, readBytes, writeString, writeBytes, appendString, removeFile,
  removeDirAll, createDirAll, readDir, isDir, exists, metadata, rename
)
use Std.Process (Process, currentExe, currentPid)
use Std.Console (Console, writeOutput)
use Std.Macro (Datum, Reflect, toDatum, fromDatum)
use Std.Sort (sort, sortOn)
use Lingua.Query (datumJson, jsonDatum)
use Lingua.Resolve as R

fun okOf r = match r with | Ok x -> Just x | Err _ -> None

-- --- a unit ------------------------------------------------------------------

-- What the compiler is given: the unit's directory, its sources -- each path
-- and its text -- the interface of each unit it depends on, by directory,
-- and the directory it may write into.
@pub data Given i
  = Given String [(String, String)] [(String, i)] String

use Given.*

@pub fun unitDir (u : Given i) : String = match u with | Given d _ _ _ -> d

@pub fun unitSources (u : Given i) : [(String, String)] = match u with | Given _ s _ _ -> s

@pub fun unitImports (u : Given i) : [(String, i)] = match u with | Given _ _ i _ -> i

@pub fun unitOut (u : Given i) : String = match u with | Given _ _ _ o -> o

-- What a link is given: the root unit's directory, every unit of the build
-- in dependency order -- its directory, its interface and the directory it
-- wrote into -- and the directory the link may write into.
@pub data Linking i = Linking String [(String, i, String)] String

use Linking.*

@pub fun linkRoot (l : Linking i) : String = match l with | Linking r _ _ -> r

@pub fun linkUnits (l : Linking i) : [(String, i, String)] = match l with | Linking _ us _ -> us

@pub fun linkOut (l : Linking i) : String = match l with | Linking _ _ o -> o

-- --- the graph ---------------------------------------------------------------

-- How units are found, `us`: the manifest's name, the sources' ending, and --
-- when the language says -- how to read a manifest (`deps`) and where a unit's
-- sources are (`files`).

-- The units `dir` depends on, as its manifest names them -- or why they
-- cannot be read.
fun depsOf us (root : String) (dir : String) : Result String [String] ! { Fs | e } =
  match readToString (Path.join dir us.manifest) with
  | Err _ -> Err "${dir} is not a unit: it has no `${us.manifest}`"
  | Ok text ->
      (match us.deps with
       | Just read ->
           (match read root dir text with
            | Ok ds -> Ok (V.map Path.normalize ds)
            | Err e -> Err e)
       | None ->
           Ok
             (V.map
                (\l -> Path.normalize (Path.join dir (S.trim l)))
                (V.filter
                   (\l -> not (S.isEmpty (S.trim l)) and not (S.startsWith "#" (S.trim l)))
                   (S.lines text))))

-- A unit's sources: where the language says, or its files ending in `ext`.
fun filesOf us (dir : String) : [String] ! { Fs | e } =
  match us.files with
  | Just list -> sort (list dir)
  | None ->
      sort
        (V.map
           (\f -> Path.join dir f)
           (V.filter (\f -> S.endsWith us.ext f) (M.unwrapOr [] (okOf (readDir dir)))))

-- Every unit `root` reaches, each with the units it depends on -- or the
-- first thing wrong: a unit that is not one, or units that depend on each
-- other in a circle.
fun graph us (root : String) : Result String [(String, [String])] ! { Fs | e } =
  visit us (Path.normalize root) [] [] (Path.normalize root)

fun visit us root (path : [String]) (done : [(String, [String])]) (dir : String) =
  if V.any (\d -> fst d == dir) done then Ok done
  else if V.elem dir path then
    Err
      "the units ${S.join " -> " (V.pushBack (V.drop path (V.foldl (\at i -> if V.get path i == Just dir then i else at) 0 (V.range 0 (V.len path)))) dir)} depend on each other in a circle"
  else
    match depsOf us root dir with
    | Err why -> Err why
    | Ok deps ->
        (match V.foldl
           (\acc d ->
             match acc with
             | Err e -> Err e
             | Ok ds -> visit us root (V.pushBack path dir) ds d)
           (Ok done)
           deps with
         | Err e -> Err e
         | Ok ds -> Ok (V.pushBack ds (dir, deps)))

-- The units in rounds: each round's units depend only on earlier rounds'.
-- The order a build in turn takes them in.
fun rounds (units : [(String, [String])]) : [[String]] = roundsFrom units []

fun roundsFrom units (placed : [String]) =
  let left = V.filter (\u -> not (V.elem (fst u) placed)) units in
  if V.isEmpty left then []
  else
    let ready = V.map fst (V.filter (\u -> V.all (\d -> V.elem d placed) (snd u)) left) in
    V.pushFront (roundsFrom units (V.append placed ready)) ready

-- --- what was built before ---------------------------------------------------

-- For each unit built: the fingerprint of its sources, of each interface it
-- was compiled against, and of its own interface. The interface itself is in
-- a file of its own (`interfacePath`), read only when something needs it: a
-- unit that depends on it and is compiled again, or the link.
data Built = Built Int [(String, Int)] Int

use Built.*

-- How what is kept is laid out: a build by another layout is no build.
def layout : Int = 4

-- Where a build keeps what it builds: `target`, or -- for a build with
-- profiles -- a directory of the profile's own in it, so that a build as one
-- profile leaves what was built as another where it was.
fun home root (sub : String) : String =
  if S.isEmpty sub then Path.joinAll [root, "target"] else Path.joinAll [root, "target", sub]

fun statePath root (sub : String) = Path.join (home root sub) "lingua-build.json"

-- What the units were compiled from when the build was last linked, as one
-- number -- if it was, by this compiler.
fun loadLinked (root : String) (sub : String) : Maybe Int ! { Fs, Process | e } =
  match M.andThen (\text -> okOf (J.parse text)) (okOf (readToString (statePath root sub))) with
  | None -> None
  | Just state ->
      if M.andThen J.asString (J.get "compiler" state) != Just (compilerId ())
        or M.andThen J.asInt (J.get "lingua" state) != Just layout then None
      else M.andThen J.asInt (J.get "linked" state)

fun loadState (root : String) (sub : String) : HashMap String Built ! { Fs, Process | e } =
  match readToString (statePath root sub) with
  | Err _ -> HashMap.empty
  | Ok text ->
      let state = okOf (J.parse text) in
      -- What another compiler built says nothing about what this one would:
      -- an interface is the compiler's as much as the sources'.
      if M.andThen (\j -> M.andThen J.asString (J.get "compiler" j)) state != Just (compilerId ())
        or M.andThen (\j -> M.andThen J.asInt (J.get "lingua" j)) state != Just layout then
        HashMap.empty
      else
        (match M.andThen J.asObject (M.andThen (J.get "units") state) with
         | None -> HashMap.empty
         | Just us ->
             V.foldl
               (\m u ->
                 match builtOf (snd u) with
                 | Just b -> HashMap.insert (fst u) b m
                 | None -> m)
               HashMap.empty
               us)

-- The compiler running this build, as far as it can tell: the program it is
-- (`currentExe` -- the process's arguments do not say), how long it is, and
-- when it was written, which a rebuilt compiler always changes. Its length
-- alone let a rebuild that came out the same size pass for the old one, and
-- the old one's interfaces be taken for its own.
fun compilerId () : String ! { Fs, Process | e } =
  match (let exe = currentExe () in if S.isEmpty exe then None else Just exe) with
  | None -> ""
  | Just exe ->
      let found = V.find (\p -> exists p) [exe, exe ++ ".exe"] in
      match M.andThen (\p -> okOf (metadata p)) found with
      | Just (m : FileMeta) ->
          "${Path.normalize (M.unwrapOr exe found)}#${show m.len}#${show m.modified}"
      | None -> exe

fun builtOf (j : Json) : Maybe Built =
  let int = \k -> M.andThen J.asInt (J.get k j) in
  match (int "sources", M.andThen J.asArray (J.get "against" j), int "fingerprint") with
  | (Just s, Just ds, Just f) ->
      Just
        (Built
           s
           (V.concatMap
              (\d ->
                match (M.andThen J.asString (J.index 0 d), M.andThen J.asInt (J.index 1 d)) with
                | (Just n, Just h) -> [(n, h)]
                | _ -> [])
              ds)
           f)
  | _ -> None

-- Where the interface of unit `dir` is kept: beside the units' own
-- directories and not in one, so that no compiler can read another's but
-- through what the build gives it.
fun interfacePath root (sub : String) dir =
  Path.joinAll [home (Path.normalize root) sub, "interfaces", outName root dir ++ ".json"]

-- A unit's interface, as it was written when the unit was last compiled.
fun readInterface root (sub : String) dir decode =
  M.andThen
    (\d -> okOf (decode d))
    (M.andThen
       jsonDatum
       (M.andThen
          (\text -> okOf (J.parse text))
          (okOf (readToString (interfacePath root sub dir)))))

-- Whether it was written: `Err` says why not.
fun writeInterface (path : String) (d : Datum) : Result String () ! { Fs, Process | e } =
  let u = M.map createDirAll (Path.parent path) in
  let aside = "${path}.${show (currentPid ())}" in
  match writeString (aside, J.render (datumJson d)) with
  | Err why -> Err "could not write ${path}: ${why}\n"
  | Ok _ ->
      (match rename (aside, path) with
       | Err why -> Err "could not write ${path}: ${why}\n"
       | Ok _ -> Ok ())

-- Remove what is under `target/units` that no unit of the build owns: a unit
-- no longer depended on, or one named another way by an older Lingua.
fun prune (root : String) (sub : String) (owned : [String]) =
  let units = Path.join (home (Path.normalize root) sub) "units" in
  let interfaces = Path.join (home (Path.normalize root) sub) "interfaces" in
  let a =
    V.foldl
      (\u name ->
        if V.elem name owned then u else (let r = removeDirAll (Path.join units name) in u))
      ()
      (M.unwrapOr [] (okOf (readDir units)))
  in V.foldl
       (\u name ->
         -- A unit's interface, or one being written beside it -- by this
         -- build or by another of the same units running now, whose file is
         -- not this build's to take from under it.
         if V.any (\o -> S.startsWith (o ++ ".json") name) owned then u
         else (let r = removeFile (Path.join interfaces name) in u))
       ()
       (M.unwrapOr [] (okOf (readDir interfaces)))

fun saveState (root : String) (sub : String) (state : HashMap String Built) (linked : Maybe Int) =
  let units =
    V.map
      (\p ->
        match snd p with
        | Built s ds f ->
            (
              fst p,
              J.jObject [
                ("sources", J.jInt s),
                (
                  "against",
                  J.jArray (V.map (\d -> J.jArray [J.jString (fst d), J.jInt (snd d)]) ds)
                ),
                ("fingerprint", J.jInt f)
              ]
            ))
      (HashMap.toVec state)
  in
  let u = createDirAll (home root sub) in
  -- Written aside and moved into place, so that a build running beside this
  -- one never reads half of it.
  let aside = "${statePath root sub}.${show (currentPid ())}" in
  -- Unindented: every build reads all of it.
  let w =
    writeString (
      aside,
      J.render
        (J.jObject
           (V.append
              [
                ("lingua", J.jInt layout),
                ("compiler", J.jString (compilerId ())),
                ("units", J.jObject units)
              ]
              (match linked with
               | Just f -> [("linked", J.jInt f)]
               | None -> [])))
    )
  in rename (aside, statePath root sub)

-- --- building ----------------------------------------------------------------

-- How a unit went.
@pub data Outcome
  = Compiled
  | Fresh
  | Broke String
  | Blocked String

use Outcome.*

-- The unit at `root`, and every unit it depends on, brought up to date: each
-- said as it goes, and whether all of them are.
-- `schedule` is when each is compiled: `onThreads`, or `inTurn`. `link`, if
-- the language has one, puts the program together once they all are.
--
-- `opts` is the build's options: what a unit's are, from its directory and
-- its manifest's text (`resolve`) -- or why they cannot be read -- and what
-- of them compiling and linking each depend on, as a number (`compileKey`,
-- `linkKey`). A unit is compiled with its own, and they are part of what it
-- is compiled from: change one a unit's compiling depends on and that unit is
-- compiled again; change one only the link reads and only the link is run.
@pub fun makeUnits schedule lang us root opts compile link encode decode =
  let sub = us.sub in
  let rootOptions =
    opts.resolve
      (Path.normalize root)
      (M.unwrapOr "" (okOf (readToString (Path.join (Path.normalize root) us.manifest))))
  in match (graph us root, rootOptions) with
     | (Err why, _) -> (let u = writeOutput "error: ${why}\n" in False)
     | (_, Err why) -> (let u = writeOutput "error: ${why}\n" in False)
     | (Ok units, Ok linkOptions) ->
         let before = loadState root sub in
         let done =
           schedule
             (\done dir ->
               plan
                 us
                 root
                 before
                 done
                 dir
                 (M.unwrapOr [] (M.map snd (V.find (\u -> fst u == dir) units)))
                 decode
                 opts)
             (\p -> carryOut compile p)
             (\r -> keeping root sub encode r)
             (\r ->
               match r with
               | (dir, outcome, b, i) ->
                   (let u = writeOutput (said lang root dir outcome) in (dir, outcome, b, i)))
             units
         in
         let dirs = V.map fst units in
         let kept =
           V.foldl
             (\m kv -> if V.elem (fst kv) dirs then HashMap.insert (fst kv) (snd kv) m else m)
             HashMap.empty
             (HashMap.toVec before)
         in
         let state =
           V.foldl
             (\m d ->
               match d with
               | (dir, _, Just b, _) -> HashMap.insert dir b m
               | _ -> m)
             kept
             done
         in
         let p = prune root sub (V.map (outName root) dirs) in
         let counts = \p -> V.len (V.filter (\d -> match d with | (_, o, _, _) -> p o) done) in
         let compiled = counts (\o -> match o with | Compiled -> True | _ -> False) in
         let fresh = counts (\o -> match o with | Fresh -> True | _ -> False) in
         let failed =
           counts (\o ->
             match o with
             | Broke _ -> True
             | Blocked _ -> True
             | _ -> False)
         in
         let w =
           writeOutput
             "${lang}: ${show compiled} compiled, ${show fresh} up to date${if failed > 0 then ", ${show failed} failed" else ""}\n"
         in
         -- The link, once every unit is built: unless the units are compiled
         -- from what they were when it last ran, and what it wrote is there.
         let inOrder = V.concat (rounds units) in
         let from =
           hash (
             opts.linkKey linkOptions,
             V.concatMap
               (\dir ->
                 match HashMap.lookup dir state with
                 | Just (Built s ds _) -> [(dir, s, ds)]
                 | None -> [])
               inOrder
           )
         in
         let was = loadLinked root sub in
         let out = linkDirIn root sub in
         -- What is kept is written again only when it is not what was read: a
         -- build that compiled nothing writes nothing.
         let same = compiled == 0 and HashMap.size state == HashMap.size before in
         let keep =
           \linked ->
             if same and linked == was then () else (let w = saveState root sub state linked in ())
         in match link with
            | None -> (let u = keep None in failed == 0)
            | Just put ->
                if failed > 0 then (let u = keep was in False)
                else if was == Just from and exists out then
                  (let u = keep was in
                   let v = writeOutput "   Fresh link\n" in
                   True)
                else
                  (let linking =
                     Linking
                       (Path.normalize root)
                       (V.concatMap
                          (\dir ->
                            match interfaceIn root sub decode done dir with
                            | Just c -> [(dir, Compact.get c, outDir root sub dir)]
                            | None -> [])
                          inOrder)
                       out
                   in match linkingIn (V.map (\dir -> outDir root sub dir) inOrder) out (\() ->
                        put linkOptions linking) with
                      | Ok _ ->
                          (let u = keep (Just from) in
                           let v =
                             writeOutput "   Linked ${relative root (Path.normalize root)}\n"
                           in True)
                      | Err report ->
                          (let u = keep None in
                           let v = writeOutput "   Failed link\n${report}" in
                           False))

-- Where a build's link may write: a directory of its own under `target`.
@pub fun linkDir (root : String) : String = linkDirIn root ""

-- The same, of a build as profile `sub`.
@pub fun linkDirIn (root : String) (sub : String) : String =
  Path.join (home (Path.normalize root) sub) "link"

-- A scheduler is given how a unit is planned from what is done so far --
-- which reads the interfaces of the units it depends on -- how a plan is
-- carried out, how what came of it is said, and the units, each with the
-- units it depends on; and answers what came of each.

-- Each unit on a thread of its own, started as soon as every unit it depends
-- on is done -- not when every unit that could have started with those is.
-- A thread says what came of its unit on a channel, and each answer starts
-- whatever it was the last thing in the way of. What a build does unless it
-- is told not to.
@pub fun onThreads planOf work keep report units =
  let ch = Thread.newChannel () in
  running ch planOf work keep report units [] [] [] []

fun running ch planOf work keep report units started tasks keepers done =
  let finished = \d -> V.any (\x -> match x with | (n, _, _, _) -> n == d) done in
  let ready = V.filter (\u -> not (V.elem (fst u) started) and V.all finished (snd u)) units in
  let begun =
    V.map
      (\u ->
        let p = planOf done (fst u) in
        Thread.spawn (\() -> Thread.send ch (work p)))
      ready
  in
  let started2 = V.append started (V.map fst ready) in
  let tasks2 = V.append tasks begun in
  -- Nothing running and nothing to start: every unit is done -- or what is
  -- left waits for itself, which `graph` has already refused.
  if V.len started2 == V.len done then
    -- Every thread is waited for: a build is not done while a unit's
    -- interface is still being kept, and a unit whose could not be is not
    -- built.
    (let u = Thread.awaitAll tasks2 in
     let ends = Thread.awaitAll keepers in
     V.map
       (\d ->
         match V.find (\e -> fst e == dirOf d) ends with
         | Just (dir, Err why) -> report (unkept dir why)
         | _ -> d)
       done)
  else
    -- What came of a unit goes on to whatever waited for it at once; what is
    -- left to do about it is done on a thread of its own, beside them. The
    -- thread that compiled it is over by then, and so is all it held.
    let r = report (Thread.receive ch) in
    let keepers2 =
      (match keep r with
       | Just later -> V.pushBack keepers (Thread.spawn (\() -> (dirOf r, later ())))
       | None -> keepers)
    in running ch planOf work keep report units started2 tasks2 keepers2 (V.pushBack done r)

-- The units one after another, in an order that has each after the units it
-- depends on: `| parallel = false`.
@pub fun inTurn planOf work keep report units =
  V.foldl
    (\done dir ->
      let r = work (planOf done dir) in
      match M.map (\later -> later ()) (keep r) with
      | Just (Err why) -> V.pushBack done (report (unkept dir why))
      | _ -> V.pushBack done (report r))
    []
    (V.concat (rounds units))

fun said lang root dir outcome =
  let name = relative root dir in
  match outcome with
  | Compiled -> "   Compiled ${name}\n"
  | Fresh -> "   Fresh ${name}\n"
  | Broke report -> "   Failed ${name}\n${report}"
  | Blocked why -> "   Blocked ${name}: ${why}\n"

-- Where unit `dir` of `root`'s build may write: a directory of its own under
-- `target/units`, named for its path from the directory the root unit is in
-- (`lib`, `app`) -- or, for one elsewhere, for its last part and a hash of the
-- whole, since a path from another drive or directory would reach out of
-- `units` altogether.
fun outDir root (sub : String) dir =
  Path.joinAll [home (Path.normalize root) sub, "units", outName root dir]

fun outName root dir =
  let d = Path.normalize dir in
  let name = relative root d in
  if name != d then S.join "_" (Path.components name)
  else
    let h = hash d in
    "${Path.fileName d}-${show (if h < 0 then 0 - h else h)}"

-- A unit's name: its path from the directory the root unit is in -- `lib`
-- and `app`, side by side -- or the whole of it, for one elsewhere.
fun relative root dir =
  let base = M.unwrapOr "." (Path.parent (Path.normalize root)) in
  if base == "." or base == "" then dir
  else if S.startsWith (base ++ "/") dir then S.drop dir (stringByteLength base + 1)
  else dir

-- What is to be done about a unit: nothing can be, since something it
-- depends on failed; nothing need be, since what it would be compiled from
-- is what it was; or it is to be compiled -- from its sources, read, and the
-- interfaces it depends on, each with its fingerprint -- and its interface
-- written where the build keeps it.
data Plan o i
  = Blocked2 String String
  | Kept String Built
  | Ready String [(String, String)] Int [(String, Compact i, Int)] String o

use Plan.*

-- What came of a unit already: its interface's fingerprint, if it was built.
fun fingerprintIn done (d : String) : Maybe Int =
  V.get
    (V.concatMap
       (\x ->
         match x with
         | (n, _, Just (Built _ _ f), _) -> if n == d then [f] else []
         | _ -> [])
       done)
    0

-- The interface of a unit that is done: the one its compiler just answered,
-- or -- for a unit that was not compiled again -- the one kept from when it
-- was.
fun interfaceIn root (sub : String) decode done (d : String) =
  match V.find (\x -> match x with | (n, _, _, _) -> n == d) done with
  | Just (_, _, _, Just c) -> Just c
  | Just (_, _, Just _, None) -> M.map Compact.make (readInterface root sub d decode)
  | _ -> None

fun plan us root before done dir deps decode opts =
  let sub = us.sub in
  let failedDep =
    V.find (\d -> V.any (\x -> match x with | (n, _, None, _) -> n == d | _ -> False) done) deps
  in match failedDep with
     | Just d -> Blocked2 dir "${relative root d} did not build"
     | None ->
         let sources = V.map (\f -> (f, M.unwrapOr "" (okOf (readToString f)))) (filesOf us dir) in
         let manifest = M.unwrapOr "" (okOf (readToString (Path.join dir us.manifest))) in
         match opts.resolve dir manifest with
         | Err why -> Blocked2 dir why
         | Ok o ->
             -- What a unit is compiled from: its sources, and what of its
             -- options compiling depends on.
             let fp = hash (sources, opts.compileKey o) in
             let against =
               V.concatMap
                 (\d -> M.unwrapOr [] (M.map (\f -> [(d, f)]) (fingerprintIn done d)))
                 deps
             in
             -- Fresh by fingerprints alone: no interface is read to say so,
             -- its own or another's -- only that its own is still there.
             match HashMap.lookup dir before with
             | Just (Built s ds f) ->
                 if s == fp and ds == against and exists (interfacePath root sub dir) then
                   Kept dir (Built s ds f)
                 else compiling root sub decode done dir deps sources fp o
             | None -> compiling root sub decode done dir deps sources fp o

fun compiling root (sub : String) decode done dir deps sources (fp : Int) o =
  let imports =
    V.map
      (\d ->
        match (interfaceIn root sub decode done d, fingerprintIn done d) with
        | (Just i, Just f) -> Ok (d, i, f)
        | _ -> Err d)
      deps
  in match V.find (\x -> match x with | Err _ -> True | Ok _ -> False) imports with
     | Just (Err d) ->
         Blocked2
           dir
           "the interface kept for ${relative root d} cannot be read: remove ${Path.join (home root sub) "interfaces"} and build again"
     | _ ->
         Ready
           dir
           sources
           fp
           (V.concatMap (\x -> match x with | Ok t -> [t] | Err _ -> []) imports)
           (outDir root sub dir)
           o

-- Compile the unit, unless what it would be compiled from is what it was.
--
-- An interface is held once. The thread that compiled a unit puts its
-- interface in a compact region, which belongs to no thread: sending it to
-- the scheduler copies nothing, each unit that depends on it is given the
-- same region to read, and so is whoever keeps it for the next build. Held
-- as an ordinary value it was copied onto every thread it was handed to --
-- once for the scheduler and once more for each unit that imported it. So an
-- interface holds data alone: a region refuses a function or anything that
-- can change.
--
-- The fingerprint is of the interface itself, not of what it is kept as:
-- a unit that depends on this one needs both the moment its compiler
-- answers, and neither should wait for a `Datum` to be made.
fun carryOut compile p =
  match p with
  | Blocked2 dir why -> (dir, Blocked why, None, None)
  | Kept dir b -> (dir, Fresh, Just b, None)
  | Ready dir sources fp imports out o ->
      let against = V.map (\x -> match x with | (d, _, f) -> (d, f)) imports in
      let unit =
        Given dir sources (V.map (\x -> match x with | (d, c, _) -> (d, Compact.get c)) imports) out
      in match sandboxed (V.map fst sources) out (\() -> compile o unit) with
         | Err report -> (dir, Broke report, None, None)
         | Ok i -> (dir, Compiled, Just (Built fp against (hash i)), Just (Compact.make i))

-- What is left to do about a unit once what came of it is known: keep its
-- interface for the next build -- as a `Datum`, as text, in its file -- if
-- it was compiled. The slower part, and nothing waits for it but the end of
-- the build: so it is done after the answer has gone to whoever waited.
fun keeping root (sub : String) encode r =
  match r with
  | (dir, Compiled, _, Just c) ->
      Just (\() -> writeInterface (interfacePath root sub dir) (encode (Compact.get c)))
  | _ -> None

-- What came of a unit whose interface could not be kept: it is not built,
-- whatever its compiler answered, since the next build could not read it.
fun unkept dir (why : String) = (dir, Broke why, None, None)

fun dirOf r = match r with | (dir, _, _, _) -> dir

-- What the unit at `dir` was compiled from in `root`'s last build: its
-- sources as they are now, and the interfaces of the units it depends on as
-- that build left them -- or why there is none: the build did not reach it, or
-- something it depends on did not build.
@pub fun givenOf us root dir decode : Result String (Given i) ! { Fs | e } =
  let r = Path.normalize root in
  let d = Path.normalize dir in
  match graph us r with
  | Err why -> Err why
  | Ok units ->
      let state = loadState r us.sub in
      let deps = M.unwrapOr [] (M.map snd (V.find (\u -> fst u == d) units)) in
      let imports =
        V.foldl
          (\acc x ->
            match acc with
            | Err e -> Err e
            | Ok is ->
                (match M.andThen
                   (\b -> readInterface r us.sub x decode)
                   (HashMap.lookup x state) with
                 | Just i -> Ok (V.pushBack is (x, i))
                 | None -> Err "${relative r x} has not been built"))
          (Ok [])
          deps
      in match imports with
         | Err e -> Err e
         | Ok is ->
             let sources =
               V.map (\f -> (f, M.unwrapOr "" (okOf (readToString f)))) (filesOf us d)
             in Ok (Given d sources is (outDir r us.sub d))

-- --- the parts of a unit ------------------------------------------------------
--
-- A unit whose sources import each other is not one thing to check: what
-- imports nothing of the rest is checked first, and sources that import each
-- other in a circle are checked together. Those groups -- the import graph's
-- strongly connected components -- are a unit's parts. A build that says how
-- a unit's sources import each other (`parts`) compiles each part on its own
-- (`compilePart`), in dependency order, those that do not depend on each other
-- at once, and each again only if its sources, or the interface of a part it
-- imports, changed; then makes the unit's interface of its parts'
-- (`assemble`). What a part was compiled from, and its interface, are kept
-- under the unit's own directory, `parts/`.

-- What a part is compiled from: the unit's directory, the part's sources --
-- each path and its text -- the interface of each part it imports, by that
-- part's name, the interface of each unit the unit depends on, the
-- directory it may write into, the unit's, and the paths of every source of
-- the unit, sorted: where the part stands among them.
@pub data Part i p
  = Part String [(String, String)] [(String, p)] [(String, i)] String [String]

use Part.*

@pub fun partDir (x : Part i p) : String = match x with | Part d _ _ _ _ _ -> d

@pub fun partSources (x : Part i p) : [(String, String)] = match x with | Part _ s _ _ _ _ -> s

@pub fun partImports (x : Part i p) : [(String, p)] = match x with | Part _ _ ps _ _ _ -> ps

@pub fun partUnitImports (x : Part i p) : [(String, i)] = match x with | Part _ _ _ is _ _ -> is

@pub fun partOut (x : Part i p) : String = match x with | Part _ _ _ _ o _ -> o

-- The paths of every source of the unit, sorted: what a part may name its
-- things after so that no other part of the unit names its own the same --
-- its place among them -- though it can read only its own.
@pub fun partUnitPaths (x : Part i p) : [String] = match x with | Part _ _ _ _ _ ps -> ps

-- What each node of `table` reaches, itself included, among `known`.
fun reachFrom table known (start : String) =
  let rec walk frontier seen =
    match V.get frontier 0 with
    | None -> seen
    | Just n ->
        if HashMap.member n seen then walk (V.drop frontier 1) seen
        else
          walk
            (V.append
               (V.drop frontier 1)
               (V.filter (\d -> HashMap.member d known) (HashMap.getOr [] n table)))
            (HashMap.insert n True seen)
  in walk [start] HashMap.empty

-- The strongly connected components of `graph` -- each node and the nodes it
-- has an edge to -- each its nodes in the order the graph names them, and
-- every component after those it reaches: the order to check them in. An
-- edge to a node the graph does not name is left out.
@pub fun sccs (graph : [(String, [String])]) : [[String]] =
  let nodes = V.map fst graph in
  let known = V.foldl (\m n -> HashMap.insert n True m) HashMap.empty nodes in
  let table = V.foldl (\m g -> HashMap.insert (fst g) (snd g) m) HashMap.empty graph in
  let reach = V.foldl (\m n -> HashMap.insert n (reachFrom table known n) m) HashMap.empty nodes in
  let reaches = \a b -> HashMap.member b (HashMap.getOr HashMap.empty a reach) in
  let comps =
    V.foldl
      (\acc n ->
        if V.any (\c -> V.elem n c) acc then acc
        else V.pushBack acc (V.filter (\m -> reaches n m and reaches m n) nodes))
      []
      nodes
  in
  -- A component reaches strictly more than any it depends on, which does
  -- not reach it back: by how much each reaches is an order to check them in.
  let size = \c -> V.len (HashMap.keys (HashMap.getOr HashMap.empty (V.getOr "" c 0) reach)) in
  V.map
    snd
    (sortOn
       (\x -> fst x)
       (V.map
          (\i -> ((size (V.getOr [] comps i), i), V.getOr [] comps i))
          (V.range 0 (V.len comps))))

-- A part's name: of its sources, so the same sources are the same part from
-- one build to the next.
@pub fun partName (members : [String]) : String =
  let h = hash (sort members) in
  "p${show (if h < 0 then 0 - h else h)}"

-- What was kept of each part: what it was compiled from -- its sources, and
-- the interface of each part it imports -- and its own interface's
-- fingerprint, by its name.
fun partsKept (dir : String) =
  match M.andThen (\t -> okOf (J.parse t)) (okOf (readToString (Path.join dir "parts.json"))) with
  | None -> HashMap.empty
  | Just j ->
      V.foldl
        (\m e ->
          let n = \k -> M.unwrapOr 0 (M.andThen J.asInt (J.get k e)) in
          match M.andThen J.asString (J.get "name" e) with
          | None -> m
          | Just name ->
              let against =
                V.concatMap
                  (\a ->
                    match (
                      M.andThen J.asString (J.get "name" a),
                      M.andThen J.asInt (J.get "interface" a)
                    ) with
                    | (Just an, Just af) -> [(an, af)]
                    | _ -> [])
                  (M.unwrapOr [] (M.andThen J.asArray (J.get "against" e)))
              in HashMap.insert name (n "sources", against, n "interface") m)
        HashMap.empty
        (M.unwrapOr [] (J.asArray j))

fun keepParts (dir : String) (kept : [(String, Int, [(String, Int)], Int)]) =
  let u = createDirAll dir in
  writeString (
    Path.join dir "parts.json",
    J.render
      (J.jArray
         (V.map
            (\k ->
              match k with
              | (name, src, against, f) ->
                  J.jObject [
                    ("name", J.jString name),
                    ("sources", J.jInt src),
                    (
                      "against",
                      J.jArray
                        (V.map
                           (\a ->
                             J.jObject [("name", J.jString (fst a)), ("interface", J.jInt (snd a))])
                           against)
                    ),
                    ("interface", J.jInt f)
                  ])
            kept))
  )

-- What became of a part: its name, its sources' fingerprint, what it was
-- compiled against, and its interface and that interface's fingerprint --
-- or why it has none: its compiler said why, or a part it imports has none.
type PartDone p = (String, Int, [(String, Int)], Result (Bool, String) (p, Int))

-- The unit `u` compiled a part at a time and its interface made of its
-- parts' -- or the reports of the parts that failed. `key` is what of the
-- unit's options compiling depends on.
@pub fun inParts
    (parallel : Bool)
    (key : Int)
    partsOf
    compilePart
    assemble
    encode
    decode
    (u : Given i) =
  let out = unitOut u in
  let dir = Path.join out "parts" in
  let sources = unitSources u in
  let paths = V.map fst sources in
  let said = partsOf sources in
  let graph =
    V.map
      (\path ->
        (
          path,
          V.filter
            (\d -> V.elem d paths)
            (M.unwrapOr [] (M.map snd (V.find (\g -> fst g == path) said)))
        ))
      paths
  in
  let comps = sccs graph in
  let names = V.map partName comps in
  let partOfPath =
    V.foldl
      (\m i ->
        V.foldl (\m2 path -> HashMap.insert path (V.getOr "" names i) m2) m (V.getOr [] comps i))
      HashMap.empty
      (V.range 0 (V.len comps))
  in
  -- The parts each part imports: those its sources import, but itself.
  let importsOf =
    \i ->
      let me = V.getOr "" names i in
      V.foldl
        (\acc path ->
          V.foldl
            (\acc2 d ->
              let n = HashMap.getOr "" d partOfPath in
              if n == me or V.elem n acc2 then acc2 else V.pushBack acc2 n)
            acc
            (HashMap.getOr
               []
               path
               (V.foldl (\m g -> HashMap.insert (fst g) (snd g) m) HashMap.empty graph)))
        []
        (V.getOr [] comps i)
  in
  let before = partsKept dir in
  -- How deep each part is: one more than the deepest it imports. Parts of
  -- one depth do not import each other, and are compiled at once.
  let depths =
    V.foldl
      (\m i ->
        HashMap.insert
          (V.getOr "" names i)
          (1 + V.foldl (\d n -> max d (HashMap.getOr 0 n m)) 0 (importsOf i))
          m)
      HashMap.empty
      (V.range 0 (V.len comps))
  in
  let deepest = V.foldl (\d n -> max d (HashMap.getOr 0 n depths)) 0 names in
  let step =
    \done i -> partStep key compilePart encode decode u dir comps names importsOf before done i
  in
  let stepped =
    V.foldl
      (\done depth ->
        let here =
          V.filter
            (\i -> HashMap.getOr 0 (V.getOr "" names i) depths == depth)
            (V.range 0 (V.len comps))
        in if parallel and V.len here > 1 then
             -- A thread starts with no handlers: each part's compiler is held to
             -- the unit there as the unit's own is.
             V.append
               done
               (Thread.awaitAll
                  (V.map
                     (\i -> Thread.spawn (\() -> sandboxed paths out (\() -> step done i)))
                     here))
           else V.append done (V.map (\i -> step done i) here))
      []
      (V.range 1 (deepest + 1))
  in
  let failed =
    V.concatMap
      (\d ->
        match d with
        | (_, _, _, Err (False, why)) -> [why]
        | _ -> [])
      stepped
  in if not (V.isEmpty failed) then Err (S.join "\n" failed)
     else
       let kept =
         V.concatMap
           (\d ->
             match d with
             | (n, src, against, Ok (_, f)) -> [(n, src, against, f)]
             | _ -> [])
           stepped
       in
       let w = keepParts dir kept in
       -- What is kept of a part no longer in the unit goes.
       let gone =
         V.foldl
           (\acc f ->
             if f != "parts.json"
               and S.startsWith "p" f
               and S.endsWith ".json" f
               and not (V.elem (S.take f (stringByteLength f - 5)) names) then
               (let r = removeFile (Path.join dir f) in acc)
             else acc)
           ()
           (M.unwrapOr [] (okOf (readDir dir)))
       in assemble
            u
            (V.concatMap (\d -> match d with | (_, _, _, Ok (x, _)) -> [x] | _ -> []) stepped)

-- Part `i`, compiled -- unless what it would be compiled from is what it was,
-- and its interface is still kept -- given what became of the parts before it.
fun partStep key compilePart encode decode u dir comps names importsOf before done i =
  let name = V.getOr "" names i in
  let members = V.getOr [] comps i in
  let deps = importsOf i in
  let outcome = \n -> V.find (\d -> match d with | (m, _, _, _) -> m == n) done in
  let blocker =
    V.find
      (\n ->
        match outcome n with
        | Just (_, _, _, Ok _) -> False
        | _ -> True)
      deps
  in
  -- A part is given every path of the unit, so a source added or removed
  -- anywhere in it is something every part was compiled from.
  let src =
    hash (
      V.filter (\x -> V.elem (fst x) members) (unitSources u),
      key,
      sort (V.map fst (unitSources u))
    )
  in match blocker with
     | Just n -> (name, src, [], Err (True, "${name} imports ${n}, which did not build"))
     | None ->
         let imported =
           V.concatMap
             (\n ->
               match outcome n with
               | Just (_, _, _, Ok (x, f)) -> [(n, x, f)]
               | _ -> [])
             deps
         in
         let against = V.map (\x -> match x with | (n, _, f) -> (n, f)) imported in
         let file = Path.join dir "${name}.json" in
         let keptOf =
           \f ->
             M.andThen
               (\d -> okOf (decode d))
               (M.andThen jsonDatum (M.andThen (\t -> okOf (J.parse t)) (okOf (readToString file))))
         in
         let fresh =
           (match HashMap.lookup name before with
            | Just (s0, a0, f0) ->
                if s0 == src and a0 == against then M.map (\x -> (x, f0)) (keptOf f0) else None
            | None -> None)
         in match fresh with
            | Just (x, f) -> (name, src, against, Ok (x, f))
            | None ->
                let part =
                  Part
                    (unitDir u)
                    (V.filter (\x -> V.elem (fst x) members) (unitSources u))
                    (V.map (\x -> match x with | (n, p, _) -> (n, p)) imported)
                    (unitImports u)
                    (unitOut u)
                    (sort (V.map fst (unitSources u)))
                in match compilePart part with
                   | Err why -> (name, src, against, Err (False, why))
                   | Ok x ->
                       (match writeInterface file (encode x) with
                        | Err why -> (name, src, against, Err (False, why))
                        | Ok _ -> (name, src, against, Ok (x, hash x)))

-- --- options ------------------------------------------------------------------

-- A build with no options: every unit's are nothing, and nothing depends on
-- them.
@pub def noOptions = { resolve = \dir manifest -> Ok (), compileKey = \o -> 0, linkKey = \o -> 0 }

-- Say that a build cannot be made, as `makeUnits` says it.
@pub fun sayError (why : String) : () ! { Console | e } = writeOutput "error: ${why}\n"

-- --- dependencies fetched --------------------------------------------------------

-- The resolver of the build of the unit at `root`: what it fetches kept in
-- `cache` -- or, when the variable `env` is set, under it -- and what it
-- resolved recorded in the lock file `lock`, beside the root unit's manifest.
-- See `Lingua.Resolve`.
@pub fun resolverOf
    (cache : String)
    (env : String)
    (lock : String)
    (root : String)
    (offline : Bool)
    (locked : Bool)
    (update : Bool)
    (only : [String]) =
  R.resolver
    (R.cacheDir cache env)
    (Path.join (Path.normalize root) lock)
    offline
    locked
    update
    only

-- The directories the dependencies a manifest names are, for the unit at
-- `from`: each path beside it, each repository fetched or found in the cache.
@pub fun resolvedDirs (r : R.Resolver) (from : String) (deps : Result String [R.Dep]) =
  R.dirsOf r from deps

-- Every unit `root` reaches, the dependencies its manifests name resolved by
-- `r`, and the lock file brought to what they resolved to: whether it could
-- be, the first thing wrong said.
@pub fun settled (r : R.Resolver) (lang : String) us (root : String) =
  match graph us root with
  | Err why -> (let u = sayError why in False)
  | Ok _ ->
      (match R.settle r lang with
       | Err why -> (let u = sayError why in False)
       | Ok _ -> True)

-- An update of the build of the unit at `root`: the dependencies it reaches
-- brought to the newest their manifests take -- those in `names`, or every one
-- when it is empty -- what moved said, and the lock file written unless this
-- is a dry run. Whether it could be.
@pub fun updated
    (r : R.Resolver)
    (lang : String)
    us
    (root : String)
    (names : [String])
    (dryRun : Bool) =
  match graph us root with
  | Err why -> (let u = sayError why in False)
  | Ok _ ->
      let known = R.seenNames r in
      match V.find (\n -> not (V.elem n known)) names with
      | Just n ->
          let u =
            sayError
              "`${n}` is not a git dependency of this unit.\nIts dependencies are: ${if V.isEmpty known then "none" else S.join ", " known}"
          in False
      | None ->
          let moved = R.movedBy r in
          let one = V.len moved == 1 in
          let u =
            writeOutput
              "   Locking ${show (V.len moved)} ${if one then "dependency" else "dependencies"} to the latest commit${if one then "" else "s"}\n"
          in if V.isEmpty moved then
               (let w = writeOutput "   Unchanged every git dependency is already current\n" in
                True)
             else
               let w =
                 V.foldl
                   (\acc m ->
                     match m with
                     | (n, was, now) ->
                         writeOutput
                           (if S.isEmpty was then "   Adding ${n} ${now}\n"
                            else "   Updating ${n} ${was} -> ${now}\n"))
                   ()
                   moved
               in if dryRun then
                    (let x =
                       writeOutput "warning: not updating the lock file, as this is a dry run\n"
                     in True)
                  else
                    match R.settle r lang with
                    | Err why -> (let x = sayError why in False)
                    | Ok _ -> True

-- A truth, as an option is given one on a command line or in a manifest.
@pub fun asBool (value : String) : Maybe Bool =
  if V.elem value ["true", "True", "yes", "on", "1"] then Just True
  else if V.elem value ["false", "False", "no", "off", "0"] then Just False
  else None

-- Several texts, given as one with commas between: none, for an empty one.
@pub fun asList (value : String) : [String] =
  V.filter (\x -> not (S.isEmpty x)) (V.map S.trim (S.split "," value))

-- `pairs` applied in turn to `o`, by `set` -- an option's name and what it
-- is given as -- or the first thing wrong.
@pub fun withAll set o (pairs : [(String, String)]) =
  V.foldl
    (\acc p ->
      match acc with
      | Err e -> Err e
      | Ok x -> set x (fst p) (snd p))
    (Ok o)
    pairs

-- --- the compiler, held to its unit ------------------------------------------

-- `act`, able to read `sources` and what is under `out`, and to write only
-- under `out`: anything else it asks the file system for fails, saying why.
@pub fun sandboxed (sources : [String]) (out : String) act =
  let made = \p -> M.map createDirAll (Path.parent p) in
  let readable = \p -> V.elem (Path.normalize p) (V.map Path.normalize sources) or under out p in
  let refused = \p -> Err "${p} is not an input of this unit" in
  handle act () with {
    readToString p resume -> resume (if readable p then readToString p else refused p),
    readBytes p resume -> resume (if readable p then readBytes p else refused p),
    readDir p resume ->
      resume (if under out p then (if exists p then readDir p else Ok []) else refused p),
    writeString w resume ->
      resume
        (if under out (fst w) then (let u = made (fst w) in writeString w) else refused (fst w)),
    writeBytes w resume ->
      resume
        (if under out (fst w) then (let u = made (fst w) in writeBytes w) else refused (fst w)),
    appendString w resume ->
      resume
        (if under out (fst w) then (let u = made (fst w) in appendString w) else refused (fst w)),
    removeFile p resume -> resume (if under out p then removeFile p else refused p),
    createDirAll p resume -> resume (if under out p then createDirAll p else refused p),
    return x -> x
  }

-- A link, able to read what is under each of `units` -- the directories the
-- units wrote into -- and under `out`, and to write only under `out`.
@pub fun linkingIn (units : [String]) (out : String) act =
  let made = \p -> M.map createDirAll (Path.parent p) in
  let readable = \p -> under out p or V.any (\d -> under d p) units in
  let refused = \p -> Err "${p} is not what a unit of this build wrote" in
  handle act () with {
    readToString p resume -> resume (if readable p then readToString p else refused p),
    readBytes p resume -> resume (if readable p then readBytes p else refused p),
    readDir p resume ->
      resume (if readable p then (if exists p then readDir p else Ok []) else refused p),
    writeString w resume ->
      resume
        (if under out (fst w) then (let u = made (fst w) in writeString w) else refused (fst w)),
    writeBytes w resume ->
      resume
        (if under out (fst w) then (let u = made (fst w) in writeBytes w) else refused (fst w)),
    appendString w resume ->
      resume
        (if under out (fst w) then (let u = made (fst w) in appendString w) else refused (fst w)),
    removeFile p resume -> resume (if under out p then removeFile p else refused p),
    createDirAll p resume -> resume (if under out p then createDirAll p else refused p),
    return x -> x
  }

fun under (dir : String) (p : String) : Bool =
  let d = Path.normalize dir in
  let q = Path.normalize p in
  q == d or S.startsWith (d ++ "/") q

-- An interface, written down and read back -- at whatever `Reflect` type the
-- compiler's interfaces are.

@pub fun encodeReflect x = toDatum x

@pub fun decodeReflect d = fromDatum d

-- --- make! -------------------------------------------------------------------

use Std.Macro (TokenTree, Loc, isPunct, spaced)
use Std.Macro.TokenTree.*
use Std.Macro.Loc.*
use Std.Macro.Parse (Tokens, parseTokens, ident, keyword, punct, stringLit, group, treesUntil)
use Std.Macro.Delim.*
use Std.String.Parse as P
use Std.String.Parse (Parser)
use Std.String.Parse (keep, skip)
use Lingua.Pipe (named)
use Std.Macro (Expand)
use Std.Collections.HashMap (HashMap)

-- `| sources = ".ml"` or `| compile = compileUnit`: a setting, where it was
-- written, and what it is.
def setting : Parser Tokens Item =
  P.pure (\k v -> Setting k v)
    |> skip (punct "|")
    |> keep named
    |> skip (punct "=")
    |> keep (P.alt stringLit ident)

-- `| options { … }`: the options a build has.
def optionsItem : Parser Tokens Item =
  P.pure (\at body -> Options (snd at) body)
    |> skip (punct "|")
    |> keep
      (P.label
         "`options`"
         (P.token
            (\t ->
              match t with
              | Word "options" at -> Just ("", at)
              | _ -> None)
            []))
    |> keep (group Brace (treesUntil (\t -> False)))

-- `| profile release { opt = O2 }`: a named set of them.
def profileItem : Parser Tokens Item =
  P.pure (\n body -> Profile n body)
    |> skip (punct "|")
    |> skip (keyword "profile")
    |> keep named
    |> keep (group Brace (treesUntil (\t -> False)))

-- What a build's declaration is made of.
data Item
  = Setting (String, Loc) String
  | Options Loc [TokenTree]
  | Profile (String, Loc) [TokenTree]

use Item.*

def buildCall : Parser Tokens (Bool, String, String, [Item]) =
  P.pure (\pub name lang ss -> (M.isSome pub, name, lang, ss))
    |> keep (P.optional (keyword "pub"))
    |> keep ident
    |> keep stringLit
    |> keep (P.some (P.choice [P.try optionsItem, P.try profileItem, setting]))

-- The settings a build needs, and those it may add.
def settings : [String] = ["sources", "manifest"]

def optional : [String] =
  [
    "compile", "dependencies", "files", "parallel", "link", "overrides", "pinned", "parts",
    "compilePart", "assemble", "lock", "cache", "cacheEnv"
  ]

-- An option's type: a truth, a number, a text, maybe one of the last two,
-- several texts, or one of the names written.
data Kind
  = Truth
  | Number
  | Text
  | MaybeNumber
  | MaybeText
  | Texts
  | Choice [String]

use Kind.*

-- An option as it is declared: its name and where that was written, its
-- type, what it is unless something says otherwise -- an expression, as it
-- was written -- what help says of it, and what depends on it: `compile`,
-- `link` or `nothing`.
data Opt = Opt String Loc Kind [TokenTree] String String

fun optName o = match o with | Opt n _ _ _ _ _ -> n
fun optKind o = match o with | Opt _ _ k _ _ _ -> k
fun optAffects o = match o with | Opt _ _ _ _ _ a -> a

fun kindOf (ts : [TokenTree]) : Maybe Kind =
  match (V.get ts 0, V.get ts 1, V.len ts) with
  | (Just (Word "Bool" _), _, 1) -> Just Truth
  | (Just (Word "Int" _), _, 1) -> Just Number
  | (Just (Word "String" _), _, 1) -> Just Text
  | (Just (Word "Maybe" _), Just (Word "Int" _), 2) -> Just MaybeNumber
  | (Just (Word "Maybe" _), Just (Word "String" _), 2) -> Just MaybeText
  | (Just (Group Bracket inner _), _, 1) ->
      (match (V.get inner 0, V.len inner) with
       | (Just (Word "String" _), 1) -> Just Texts
       | _ -> None)
  | _ ->
      -- `O0 | O1 | O2`: names, a `|` between each two.
      let names = V.concatMap (\t -> match t with | Word w _ -> [w] | _ -> []) ts in
      let bars = V.len (V.filter (isPunct "|") ts) in
      if V.len names >= 2 and bars == V.len names - 1 and V.len ts == V.len names + bars then
        Just (Choice names)
      else None

-- Where the entry that starts at `i` ends: at the next name with a `:` after
-- it, or at the end.
fun entryEnd (ts : [TokenTree]) (i : Int) : Int =
  match (V.get ts i, V.get ts (i + 1)) with
  | (None, _) -> i
  | (Just (Word _ _), Just t) -> if isPunct ":" t then i else entryEnd ts (i + 1)
  | _ -> entryEnd ts (i + 1)

fun firstWhere (p : TokenTree -> Bool) (ts : [TokenTree]) (i : Int) (stop : Int) : Int =
  if i >= stop then stop
  else
    match V.get ts i with
    | Just t -> if p t then i else firstWhere p ts (i + 1) stop
    | None -> stop

def optionShape : String =
  "an option is `name : Type = default \"what it is\"`, and may end `for link` or `for nothing`; a type is `Bool`, `Int`, `String`, `Maybe Int`, `Maybe String`, `[String]` or names with `|` between"

-- The options a `{ … }` declares, or what is wrong with one.
fun optionsOf (ts : [TokenTree]) (i : Int) (acc : [Opt]) : Result [TokenTree] [Opt] =
  match (V.get ts i, V.get ts (i + 1)) with
  | (None, _) -> Ok acc
  | (Just (Word name at), Just colon) ->
      if not (isPunct ":" colon) then Err [Fail optionShape at]
      else
        let stop = entryEnd ts (i + 2) in
        let eq = firstWhere (isPunct "=") ts (i + 2) stop in
        -- `for link`, if the entry ends with it.
        let marked =
          (match (V.get ts (stop - 2), V.get ts (stop - 1)) with
           | (Just (Word "for" _), Just (Word w _)) -> Just w
           | _ -> None)
        in
        let last = if M.isSome marked then stop - 2 else stop in
        (match (kindOf (V.take (V.drop ts (i + 2)) (eq - i - 2)), V.get ts (last - 1)) with
         | (None, _) -> Err [Fail optionShape at]
         | (Just kind, Just (Str help _)) ->
             let affects = M.unwrapOr "compile" marked in
             if eq >= last - 1 then
               Err [Fail "`${name}` needs what it is by default, after its `=`" at]
             else if not (V.elem affects ["compile", "link", "nothing"]) then
               Err
                 [Fail
                    "an option is `for link` or `for nothing`, or for compiling, which is not said; not `for ${affects}`"
                    at]
             else if V.any (\o -> optName o == name) acc then
               Err [Fail "there is an option `${name}` already" at]
             else
               optionsOf
                 ts
                 stop
                 (V.pushBack
                    acc
                    (Opt
                       name
                       at
                       kind
                       (V.take (V.drop ts (eq + 1)) (last - 1 - eq - 1))
                       help
                       affects))
         | _ -> Err [Fail optionShape at])
  | (Just (Word _ at), None) -> Err [Fail optionShape at]
  | _ -> Err [Fail optionShape Nowhere]

-- `opt = O2, strict = True`: the fields a profile sets, each with its value
-- as it was written.
fun fieldsOf (ts : [TokenTree]) : [(String, Loc, [TokenTree])] =
  let parts =
    (match V.foldl
       (\acc t ->
         match acc with
         | (done, cur) ->
             (if isPunct "," t then (V.pushBack done cur, []) else (done, V.pushBack cur t)))
       ([], [])
       ts with
     | (done, cur) -> if V.isEmpty cur then done else V.pushBack done cur)
  in V.concatMap
       (\part ->
         match (V.get part 0, V.get part 1) with
         | (Just (Word n at), Just t) -> if isPunct "=" t then [(n, at, V.drop part 2)] else []
         | _ -> [])
       parts

fun capital (s : String) : String =
  S.toUpper (stringSlice s 0 1) ++ stringSlice s 1 (stringByteLength s)

fun small (s : String) : String =
  S.toLower (stringSlice s 0 1) ++ stringSlice s 1 (stringByteLength s)

-- The type an option's choice is: the build's name and the option's.
fun choiceTy (name : String) o : String = "${name}${capital (optName o)}"

fun kindTy (name : String) o : String =
  match optKind o with
  | Truth -> "Bool"
  | Number -> "Int"
  | Text -> "String"
  | MaybeNumber -> "Maybe Int"
  | MaybeText -> "Maybe String"
  | Texts -> "[String]"
  | Choice _ -> choiceTy name o

fun kindSaid o : String =
  match optKind o with
  | Truth -> "true or false"
  | Number -> "a number"
  | Text -> "a text"
  | MaybeNumber -> "a number, or none"
  | MaybeText -> "a text, or none"
  | Texts -> "texts, with commas between"
  | Choice names -> "one of ${S.join ", " names}"

-- A value as it was written, as code: a choice's name by its type.
fun valueCode (name : String) o (ts : [TokenTree]) : String =
  match (optKind o, V.get ts 0, V.len ts) with
  | (Choice names, Just (Word w _), 1) ->
      if V.elem w names then "${choiceTy name o}.${w}" else spaced ts
  | _ -> spaced ts

-- How option `o` of a record `lingua_o` is set from a text `lingua_v`.
fun setCode (name : String) o : String =
  let n = optName o in
  let wrong = "Err \"`${n}` is ${kindSaid o}, not `\${lingua_v}`\"" in
  match optKind o with
  | Truth ->
      "(match LinguaMake.asBool lingua_v with | Just lingua_x -> Ok { lingua_o | ${n} = lingua_x } | None -> ${wrong})"
  | Number ->
      "(match LinguaS.toInt lingua_v with | Just lingua_x -> Ok { lingua_o | ${n} = lingua_x } | None -> ${wrong})"
  | Text -> "Ok { lingua_o | ${n} = lingua_v }"
  | MaybeNumber ->
      "(if lingua_v == \"none\" or lingua_v == \"\" then Ok { lingua_o | ${n} = None } else (match LinguaS.toInt lingua_v with | Just lingua_x -> Ok { lingua_o | ${n} = Just lingua_x } | None -> ${wrong}))"
  | MaybeText ->
      "Ok { lingua_o | ${n} = (if lingua_v == \"none\" or lingua_v == \"\" then None else Just lingua_v) }"
  | Texts -> "Ok { lingua_o | ${n} = LinguaMake.asList lingua_v }"
  | Choice names ->
      "(match lingua_v with${S.join "" (V.map (\c -> " | \"${c}\" -> Ok { lingua_o | ${n} = ${choiceTy name o}.${c} }") names)} | _ -> ${wrong})"

-- What a build's options are written as: a type for each choice, the record
-- of them, what they are by default, each profile, how one is set from a
-- text, and what compiling and linking each depend on.
fun optionsCode
    (pub : String)
    (name : String)
    (lang : String)
    (opts : [Opt])
    (profiles : [((String, Loc), [(String, Loc, [TokenTree])])])
    : [TokenTree] =
  let lower = small name in
  let choices =
    S.join
      ""
      (V.concatMap
         (\o ->
           match optKind o with
           | Choice names ->
               ["\n@derive(Debug, PartialEq)\n${pub}data ${choiceTy name o} = ${S.join " | " names}\n"]
           | _ -> [])
         opts)
  in
  let fields = S.join ", " (V.map (\o -> "${optName o} : ${kindTy name o}") opts) in
  let defaults =
    S.join
      ", "
      (V.map
         (\o ->
           match o with
           | Opt n _ _ d _ _ -> "${n} = (${valueCode name o d})")
         opts)
  in
  let valueOf =
    \f ->
      match f with
      | (fn, _, value) ->
          (match V.find (\o -> optName o == fn) opts with
           | Just o -> "${fn} = (${valueCode name o value})"
           | None -> "${fn} = (${spaced value})")
  in
  let profileArm =
    \pr ->
      match pr with
      | ((pn, _), fs) ->
          let made =
            if V.isEmpty fs then "lingua_d" else "{ lingua_d | ${S.join ", " (V.map valueOf fs)} }"
          in " | \"${pn}\" -> Just (let lingua_d = ${lower}Defaults () in ${made})"
  in
  let keyOf =
    \what ->
      let mine = V.filter (\o -> optAffects o == what) opts in
      if V.isEmpty mine then "0"
      else "hash [${S.join ", " (V.map (\o -> "hash lingua_o.${optName o}") mine)}]"
  in
  let names = S.join ", " (V.map (\o -> "`${optName o}`") opts) in
  [Code "use Lingua.Make as LinguaMake
use Std.Collections.Vector as LinguaV
use Std.String as LinguaS
${choices}
-- ${lang}'s options: what a build of it can be told.
${pub}record ${name}Options = { ${fields} }

-- What each is unless a profile, a manifest or the command line says.
${pub}fun ${lower}Defaults () = ${name}Options { ${defaults} }

-- The profiles a build can be made as.
${pub}def ${lower}Profiles : [String] = [${S.join ", " (V.map (\pr -> "\"${fst (fst pr)}\"") profiles)}]

-- A profile's options, by its name.
${pub}fun ${lower}Profile (lingua_p : String) =
  match lingua_p with${S.join "" (V.map profileArm profiles)} | _ -> None

-- `lingua_o` with the option called `lingua_n` set from a text -- as a
-- command line or a manifest gives one -- or what is wrong with that.
${pub}fun ${lower}Set (lingua_o : ${name}Options) (lingua_n : String) (lingua_v : String) : Result String ${name}Options =
  match lingua_n with${S.join "" (V.map (\o -> "\n  | \"${optName o}\" -> ${setCode name o}") opts)}
  | _ -> Err \"${lang} has no option `\${lingua_n}`: it has ${names}\"

-- The same, of several in turn.
${pub}fun ${lower}With (lingua_o : ${name}Options) (lingua_ps : [(String, String)]) : Result String ${name}Options =
  LinguaMake.withAll ${lower}Set lingua_o lingua_ps

-- Each option's name, what it may be, and what help says of it.
${pub}def ${lower}OptionHelp : [(String, String, String)] =
  [${S.join ", " (V.map (\o -> match o with | Opt n _ _ _ h _ -> "(\"${n}\", \"${kindSaid o}\", ${textCode h})") opts)}]

fun lingua${name}_compileKey (lingua_o : ${name}Options) : Int = ${keyOf "compile"}

fun lingua${name}_linkKey (lingua_o : ${name}Options) : Int = ${keyOf "link"}
"]

-- A text as code: in quotes, what would end it or splice into it escaped.
fun textCode (s : String) : String =
  "\""
    ++ S.join
      ""
      (V.map
         (\i ->
           let c = stringSlice s i (i + 1) in
           if c == "\"" then "\\\""
           else if c == "\\" then "\\\\"
           else if c == "$" then "\\$"
           else c)
         (V.range 0 (stringByteLength s)))
    ++ "\""

@macro
@pub fun make (ts : [TokenTree]) : [TokenTree] ! { Expand | e } =
  match parseTokens buildCall ts with
  | Err failed -> failed
  | Ok (pub, name, lang, items) ->
      let ss = V.concatMap (\x -> match x with | Setting k v -> [(k, v)] | _ -> []) items in
      let declared =
        V.concatMap (\x -> match x with | Options at body -> [(at, body)] | _ -> []) items
      in
      let profiles =
        V.concatMap
          (\x ->
            match x with
            | Profile n body -> [(n, fieldsOf body)]
            | _ -> [])
          items
      in match V.find (\s -> not (V.elem (fst (fst s)) (V.append settings optional))) ss with
         | Just s ->
             [Fail
                "a build has no setting `${fst (fst s)}`: they are ${S.join ", " (V.map (\x -> "`${x}`") (V.append settings optional))}, and `options { … }` and `profile name { … }`"
                (snd (fst s))]
         | None ->
             let has = \k -> V.any (\s -> fst (fst s) == k) ss in
             match V.find (\k -> not (has k)) settings with
             | Just k -> [Fail "a build needs `${k}`" Nowhere]
             | None ->
                 if has "parts" and not (has "compilePart" and has "assemble") then
                   [Fail
                      "a build whose units are compiled in parts needs `compilePart`, which compiles a part, and `assemble`, which makes a unit's interface of its parts'"
                      Nowhere]
                 else if not (has "parts") and (has "compilePart" or has "assemble") then
                   [Fail "`compilePart` and `assemble` are for a build that says `parts`" Nowhere]
                 else if not (has "parts") and not (has "compile") then
                   [Fail
                      "a build needs `compile`, or `parts` with `compilePart` and `assemble`"
                      Nowhere]
                 else if has "lock" and not (has "dependencies") then
                   [Fail
                      "a build with a `lock` fetches what its manifests depend on, and says how a manifest names it: `dependencies`, which answers each as a `Dep`"
                      Nowhere]
                 else if (has "cache" or has "cacheEnv") and not (has "lock") then
                   [Fail
                      "`cache` and `cacheEnv` say where a build with a `lock` keeps what it fetches"
                      Nowhere]
                 else
                   match V.find
                     (\s -> fst (fst s) == "parallel" and not (V.elem (snd s) ["true", "false"]))
                     ss with
                   | Just s ->
                       [Fail
                          "`parallel` is `true` or `false`: whether units that do not depend on each other are compiled at once, which they are unless it says `false`"
                          (snd (fst s))]
                   | None ->
                       match optionsOf (M.unwrapOr [] (M.map snd (V.get declared 0))) 0 [] with
                       | Err failed -> failed
                       | Ok opts -> written pub name lang ss declared profiles opts

-- What a build's declaration writes, once its settings and options are read.
fun written (pub : Bool) (name : String) (lang : String) ss declared profiles (opts : [Opt])
    : [TokenTree] =
  let get = \k -> M.unwrapOr "" (M.map snd (V.find (\s -> fst (fst s) == k) ss)) in
  let given = \k -> M.map snd (V.find (\s -> fst (fst s) == k) ss) in
  let vis = if pub then "@pub " else "" in
  let schedule =
    if given "parallel" == Just "false" then "LinguaMake.inTurn" else "LinguaMake.onThreads"
  in
  -- How a unit is compiled: by `compile`, or a part at a time. `withOpts` is
  -- whether the build has options, which a part's compiler is given first.
  let compiled =
    \withOpts ->
      match given "parts" with
      | None ->
          if withOpts then "(\\o u -> ${get "compile"} o u)" else "(\\o u -> ${get "compile"} u)"
      | Just ps ->
          let o = if withOpts then "o " else "" in
          let key = if withOpts then "(lingua${name}_compileKey o)" else "0" in
          "(\\o u -> LinguaMake.inParts ${if given "parallel" == Just "false" then "False" else "True"} ${key} (\\lingua_s -> ${ps} lingua_s) (\\lingua_p -> ${get "compilePart"} ${o}lingua_p) (\\lingua_u lingua_ps -> ${get "assemble"} ${o}lingua_u lingua_ps) LinguaMake.encodeReflect LinguaMake.decodeReflect u)"
  in
  -- A build with a lock file resolves what its manifests name, by
  -- `lingua_resolver`, before it reads the units they are.
  let lock = given "lock" in
  let deps =
    \f ->
      if M.isSome lock then
        "Just (\\r d t -> LinguaMake.resolvedDirs lingua_resolver d (${f} r d t))"
      else "Just (\\r d t -> ${f} r d t)"
  in
  let unitsIn =
    \sub ->
      "{ manifest = \"${get "manifest"}\", ext = \"${get "sources"}\", sub = ${sub}, deps = ${M.unwrapOr "None" (M.map deps (given "dependencies"))}, files = ${M.unwrapOr "None" (M.map (\f -> "Just (\\d -> ${f} d)") (given "files"))} }"
  in
  let resolverWith =
    \args ->
      "LinguaMake.resolverOf \"${M.unwrapOr "~/.${lang}/git" (given "cache")}\" \"${get "cacheEnv"}\" \"${get "lock"}\" root ${args}"
  in
  -- What a build with a lock file does first: resolve, and settle the lock.
  let settle =
    \sub ->
      if M.isSome lock then
        "let lingua_resolver = ${resolverWith "lingua_offline lingua_locked False []"} in\n  if not (LinguaMake.settled lingua_resolver \"${lang}\" (${unitsIn sub}) root) then False\n  else\n  "
      else ""
  in
  -- What it was compiled from is read with what is in the cache alone.
  let givenResolver =
    if M.isSome lock then "let lingua_resolver = ${resolverWith "True False False []"} in\n  "
    else ""
  in
  let withName = if M.isSome lock then "With" else "" in
  let flags = if M.isSome lock then "(lingua_offline : Bool) (lingua_locked : Bool) " else "" in
  -- The build as it is called without the flags, and the update.
  let lockCode = \params args -> if M.isNone lock then "" else "
-- ${lang}'s build, fetching what it must, and with the lock file `${get "lock"}`
-- kept as it resolved: `build${name}With` not `offline` and not `locked`.
${vis}fun build${name} ${params}(root : String) = build${name}With False False ${args}root

-- ${lang}'s update: what the units depend on brought to the newest each
-- manifest takes -- those in `lingua_names`, or every one when it is empty --
-- what moved said, and the lock file written unless it is a dry run.
${vis}fun update${name} (root : String) (lingua_names : [String]) (lingua_dryRun : Bool) =
  let lingua_resolver = ${resolverWith "False False True lingua_names"} in
  LinguaMake.updated lingua_resolver \"${lang}\" (${unitsIn "\"\""}) root lingua_names lingua_dryRun
" in
  let unknown =
    V.concatMap
      (\pr ->
        V.concatMap
          (\f ->
            match f with
            | (fn, at, _) ->
                if V.any (\o -> optName o == fn) opts then []
                else
                  [Fail
                     "${lang} has no option `${fn}`: a profile sets the options the build has"
                     at])
          (snd pr))
      profiles
  in if V.len declared > 1 then
       [Fail
          "a build's options are one `options { … }`"
          (M.unwrapOr Nowhere (M.map fst (V.get declared 1)))]
     else if V.isEmpty declared and not (V.isEmpty profiles) then
       [Fail
          "a profile sets a build's options, and this build has none: say them in `options { … }`"
          (M.unwrapOr Nowhere (M.map (\pr -> snd (fst pr)) (V.get profiles 0)))]
     else if V.isEmpty declared and (M.isSome (given "overrides") or M.isSome (given "pinned")) then
       [Fail
          "`overrides` and `pinned` say what a unit's options are, and this build has none: say them in `options { … }`"
          Nowhere]
     else if not (V.isEmpty unknown) then V.take unknown 1
     else if V.isEmpty declared then [Code "use Lingua.Make as LinguaMake

-- ${lang}'s build: the unit at `root` and every unit it depends on, each
-- compiled only if what it would be compiled from has changed.${if M.isSome lock then " Offline, it\n-- reaches no network: what it depends on must be in the cache. Locked, it\n-- fails rather than change the lock file." else ""}
${vis}fun build${name}${withName} ${flags}(root : String) =
  ${settle "\"\""}LinguaMake.makeUnits ${schedule} \"${lang}\" (${unitsIn "\"\""}) root LinguaMake.noOptions ${compiled False} (${M.unwrapOr "None" (M.map (\f -> "Just (\\o l -> ${f} l)") (given "link"))}) LinguaMake.encodeReflect LinguaMake.decodeReflect

-- What the unit at `dir` was compiled from in `root`'s last build.
${vis}fun given${name} (root : String) (dir : String) =
  ${givenResolver}LinguaMake.givenOf (${unitsIn "\"\""}) root dir LinguaMake.decodeReflect
${lockCode "" ""}"]
     else
       -- A build with options and no profile written has one, `debug`: what
       -- the options are by default.
       let named = if V.isEmpty profiles then [(("debug", Nowhere), [])] else profiles in
       let lower = small name in
       let over =
         (match given "overrides" with
          | Just f -> "(${f} root lingua_dir lingua_manifest lingua_profile)"
          | None -> "[]")
       in
       -- What a unit's options are whatever the build was told: applied
       -- last, over the command line's.
       let last =
         (match given "pinned" with
          | Just f ->
              "(match lingua_r with | Err lingua_e -> Err lingua_e | Ok lingua_o -> ${lower}With lingua_o (${f} root lingua_dir lingua_manifest lingua_profile))"
          | None -> "lingua_r")
       in V.concat [optionsCode vis name lang opts named, [Code "
-- ${lang}'s build, as profile `lingua_profile` and with `lingua_set` over
-- it: the unit at `root` and every unit it depends on, each compiled with
-- its own options and only if what it would be compiled from -- those
-- among it -- has changed. What it builds is under `target/<profile>`.${if M.isSome lock then " Offline,\n-- it reaches no network: what it depends on must be in the cache. Locked, it\n-- fails rather than change the lock file." else ""}
${vis}fun build${name}${withName} ${flags}(lingua_profile : String) (lingua_set : [(String, String)]) (root : String) =
  match ${lower}Profile lingua_profile with
  | None -> (let lingua_u = LinguaMake.sayError \"${lang} has no profile `\${lingua_profile}`: it has \${LinguaS.join \", \" ${lower}Profiles}\" in False)
  | Just lingua_base ->
      ${settle "lingua_profile"}LinguaMake.makeUnits ${schedule} \"${lang}\" (${unitsIn "lingua_profile"}) root
        { resolve = \\lingua_dir lingua_manifest -> (let lingua_r = (match ${lower}With lingua_base ${over} with | Err lingua_e -> Err lingua_e | Ok lingua_o -> ${lower}With lingua_o lingua_set) in ${last}), compileKey = lingua${name}_compileKey, linkKey = lingua${name}_linkKey }
        ${compiled True} (${M.unwrapOr "None" (M.map (\f -> "Just (\\o l -> ${f} o l)") (given "link"))}) LinguaMake.encodeReflect LinguaMake.decodeReflect

-- What the unit at `dir` was compiled from in `root`'s last build as that
-- profile.
${vis}fun given${name} (lingua_profile : String) (root : String) (dir : String) =
  ${givenResolver}LinguaMake.givenOf (${unitsIn "lingua_profile"}) root dir LinguaMake.decodeReflect
${lockCode "(lingua_profile : String) (lingua_set : [(String, String)]) " "lingua_profile lingua_set "}"]]

-- --- tests ---------------------------------------------

use Std.Test (assertEq)
@test fun aCompilerCanReadOnlyItsUnit () =
  let read =
    sandboxed ["src/a.ml"] "target/out" (\() ->
      (readToString "src/b.ml", writeString ("elsewhere/x", "y")))
  in assertEq
       read
       (Err "src/b.ml is not an input of this unit", Err "elsewhere/x is not an input of this unit")
       "a read and a write outside it"
@test fun unitsAreBuiltInRoundsOfWhatTheyDependOn () =
  assertEq
    (rounds [("a", []), ("b", ["a"]), ("c", ["a"]), ("d", ["b", "c"])])
    [["a"], ["b", "c"], ["d"]]
    "b and c together"

@test fun partsAreTheComponentsOfTheImportsInTheOrderToCheckThem () =
  let parts = sccs [("c", ["a"]), ("a", ["b"]), ("b", ["a", "z"]), ("d", [])] in
  let a = assertEq (V.len parts) 3 "a and b import each other, and are one; `z` is no source" in
  let at =
    \n ->
      M.unwrapOr (0 - 1) (V.find (\i -> V.elem n (V.getOr [] parts i)) (V.range 0 (V.len parts)))
  in
  let b = assertEq (V.getOr [] parts (at "a")) ["a", "b"] "together, as the graph names them" in
  assertEq (at "a" < at "c") True "and what imports them after them"

-- A unit of four sources: `a` and `b` import each other, `c` imports `a`,
-- and `d` imports nothing. A source's imports are the words of its text
-- after `use`, and a part's interface is its sources' names -- not their
-- texts, so a change to a text that leaves the names alone changes no
-- interface.
fun sourcesOf (texts : [(String, String)]) : [(String, [String])] =
  V.map
    (\t ->
      (
        fst t,
        V.concatMap (\w -> if S.startsWith "use:" w then [S.drop w 4] else []) (S.split " " (snd t))
      ))
    texts

fun inTestParts (out : String) (texts : [(String, String)]) (compiled : Ref [String]) =
  inParts
    False
    0
    sourcesOf
    (\(x : Part String String) ->
      let names = S.join "+" (V.map fst (partSources x)) in
      let u = setRef compiled (V.pushBack (getRef compiled) names) in
      Ok "${names}[${S.join "," (V.map (\ip -> snd ip) (partImports x))}]")
    (\(g : Given String) ps -> Ok (S.join " | " ps))
    encodeReflect
    decodeReflect
    (Given "unit" texts [] out)

@test fun aPartIsCompiledAgainOnlyIfWhatItWasCompiledFromChanged () =
  let out = "target/lingua-parts-test" in
  let r = removeDirAll out in
  let texts = [("a", "use:b one"), ("b", "use:a"), ("c", "use:a"), ("d", "x")] in
  let compiled = newRef [] in
  let first = inTestParts out texts compiled in
  let a =
    assertEq
      (first, getRef compiled)
      (Ok "d[] | a+b[] | c[a+b[]]", ["d", "a+b", "c"])
      "each part compiled once, in order, and the unit's interface made of theirs"
  in
  let u = setRef compiled [] in
  let again = inTestParts out texts compiled in
  let b = assertEq (again, getRef compiled) (first, []) "nothing compiled when nothing changed" in
  let w = setRef compiled [] in
  let edited =
    inTestParts out [("a", "use:b two"), ("b", "use:a"), ("c", "use:a"), ("d", "x")] compiled
  in
  let c =
    assertEq
      (getRef compiled)
      ["a+b"]
      "a text changed, so its part is compiled again; its interface did not change, so what imports it is not"
  in
  let x = setRef compiled [] in
  let regrouped =
    inTestParts out [("a", "use:b two"), ("b", "y"), ("c", "use:a"), ("d", "x")] compiled
  in assertEq
       (regrouped, getRef compiled)
       (Ok "b[] | d[] | a[b[]] | c[a[b[]]]", ["b", "a", "c"])
       "b no longer imports a: two parts where there was one, and what imports them again"

@test fun aPartThatFailsBlocksWhatImportsItAndTheUnit () =
  let out = "target/lingua-parts-fail" in
  let r = removeDirAll out in
  let failing =
    inParts
      False
      0
      sourcesOf
      (\(x : Part String String) ->
        if V.any (\s -> fst s == "a") (partSources x) then Err "a is wrong" else Ok "fine")
      (\(g : Given String) ps -> Ok (S.join " | " ps))
      encodeReflect
      decodeReflect
      (Given "unit" [("a", "x"), ("c", "use:a"), ("d", "x")] [] out)
  in assertEq
       failing
       (Err "a is wrong")
       "the unit fails with what its compiler said, and `c` is not compiled"

@test fun aPartIsGivenEveryPathOfItsUnitAndCompiledAgainWhenOneIsAdded () =
  let out = "target/lingua-parts-paths" in
  let r = removeDirAll out in
  let seen = newRef [] in
  let run =
    \texts ->
      inParts
        False
        0
        sourcesOf
        (\(x : Part String String) ->
          let u = setRef seen (V.pushBack (getRef seen) (S.join "," (partUnitPaths x))) in
          Ok (S.join "+" (V.map fst (partSources x))))
        (\(g : Given String) ps -> Ok (S.join " | " ps))
        encodeReflect
        decodeReflect
        (Given "unit" texts [] out)
  in
  let first = run [("b", "x"), ("a", "x")] in
  let a = assertEq (getRef seen) ["a,b", "a,b"] "every path of the unit, sorted, to each part" in
  let u = setRef seen [] in
  let added = run [("b", "x"), ("a", "x"), ("c", "x")] in
  assertEq
    (V.len (getRef seen))
    3
    "a source added: every part is compiled again, since each was given the paths"
