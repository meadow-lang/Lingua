-- `lsp!`: a language server, from what a Lingua compiler already has.
--
--   lsp! {
--     pub Server "miniml" for Session
--     | text = setSessionSource
--     | diagnostics = diagnosticsOf
--     | tree = treeOf
--     | hover = hoverAt
--     | definition = definitionAt
--     | references = referencesAt
--     | completion = completionAt
--     | symbols = symbolsOf
--     | format = formattedOf
--   }
--
-- A server keeps its compiler's database -- `for Session` makes it with
-- `newSession` -- and answers the editor from its queries: an edit sets a
-- file's text, and what it changed is all that is worked out again. Each
-- feature is a function of the database, a file, and -- where the editor
-- points at something -- a byte offset into it:
--
--   text          db -> Int -> String -> ()        set a file's text
--   diagnostics   db -> Int -> [Diagnostic]        what is wrong in it
--   tree          db -> Int -> Green k             its lossless tree: semantic
--                                                  tokens, folding and
--                                                  selection ranges, all read
--                                                  off it here
--   hover         db -> Int -> Int -> Maybe (Meta, String)
--   definition    db -> Int -> Int -> [(Int, Meta)]
--   references    db -> Int -> Int -> [(Int, Meta)]  -- highlights, rename too
--   completion    db -> Int -> Int -> [(String, String)]
--   symbols       db -> Int -> [(String, String, Meta)]
--   format        db -> Int -> String              its text, set out: what a
--                                                  formatter (`format!`) makes
--                                                  of its tree
--
-- Only `text` is needed; the server says it can do what it was given.
--
-- **On threads.** `for Session threaded` is a server that reads on one
-- thread, looks for what is wrong on another, and answers on a third: a
-- request is answered while a file is still being looked at, and an edit
-- that arrives then stops the looking (`interrupt<Db>`) before it sets the
-- text. `diagnostics` is then run on a thread of its own, and must answer
-- and not raise -- a query stopped raises `Interrupted`. Such a server also
-- writes `serve<Name>InTurn`, the same server a message at a time, which is
-- what a test tells (`told`).
--
-- **Requests of the language's own** are `requests`: each a method and what
-- answers it, a function of the database and what was `Asked` -- the file,
-- its text, the byte the editor points at, and the request's parameters as
-- they came:
--
--   requests      [(String, db -> Asked -> Json)]
--   capabilities  [(String, Json)]                 what else the server says
--                                                  it can do
--
-- A method of the protocol's that Lingua answers nothing for -- inlay hints,
-- code lenses, workspace symbols, resolving a completion -- is answered this
-- way, and the server says it can; so is a method only this language has
-- (`miniml/type`). One given for a method Lingua does answer is asked in its
-- place. A request about no open file is asked with file `-1`.
--
-- **Colour** is the tree's tokens, each a class -- a keyword, a name, a
-- number -- by its kind and its spelling; and, with `resolved`, by what the
-- compiler knows of that occurrence:
--
--   resolved      db -> Int -> [(Int, String)]     the byte a token starts
--                                                  at, and what it resolved
--                                                  to: `function`, `type`,
--                                                  `enumMember`, `namespace`
--                                                  or `variable`
--
-- as Meadow's own server colours a file: what a spelling cannot say, name
-- resolution does. A server with a `tree` writes `tokensServer db file` --
-- each coloured token's bytes and class -- which is what it answers an
-- editor with, and what a prompt over the same database (`repl!`) colours
-- what is typed with. Where
-- a feature answers places, each is a file and a `Meta` in it. What is
-- written is `serveServer ()`, the server, on standard input and output.
--
-- The protocol is below: messages framed by `Content-Length`, positions in
-- UTF-16 code units, and the documents the editor has open.

use Std.Collections.Vector as V
use Std.Collections.HashMap as HashMap
use Std.String as S
use Std.Maybe as M
use Std.Char as C
use Std.Json as J
use Std.Json (Json)
use Std.Console (Console, readLine, readExact, writeOutput, writeError, withOutput)
use Std.Thread as Thread
use Std.Stm as Stm
use Lingua.Lang (Meta)
use Lingua.Lang.Meta.*
use Lingua.Diagnostic (Diagnostic, Severity)
use Lingua.Diagnostic.Diagnostic.*
use Lingua.Green as G
use Lingua.Green (Green)
use Lingua.Red as R

-- --- messages ----------------------------------------------------------------

-- The next message, or `None` when the editor has gone.
@pub fun readMessage () : Maybe Json ! { Console | e } =
  match contentLength 0 with
  | None -> None
  | Just n ->
      (match readExact n with
       | None -> None
       | Just body -> Just (match J.parse body with | Ok j -> j | Err _ -> J.jNull ()))

fun contentLength (n : Int) : Maybe Int ! { Console | e } =
  match readLine () with
  | None -> None
  | Just line ->
      if S.trim line == "" then (if n > 0 then Just n else contentLength n)
      else if S.startsWith "Content-Length:" line then
        contentLength (M.unwrapOr 0 (S.toInt (S.trim (S.drop line 15))))
      else contentLength n

-- A message, written. A body ends with no line break, and standard output
-- is written a line at a time, so the body would wait for whatever is written
-- next -- the next message's header -- and an editor would have each answer
-- only when the one after it came. Writing nothing to standard error sends
-- what standard output holds first.
@pub fun send (j : Json) : () ! { Console | e } =
  let body = J.render j in
  let u = writeOutput "Content-Length: ${show (stringByteLength body)}\r\n\r\n${body}" in
  writeError ""

fun reply id result =
  send (J.jObject [("jsonrpc", J.jString "2.0"), ("id", id), ("result", result)])

fun replyError id code message =
  send
    (J.jObject [
       ("jsonrpc", J.jString "2.0"),
       ("id", id),
       ("error", J.jObject [("code", J.jInt code), ("message", J.jString message)])
     ])

fun notify method params =
  send (J.jObject [("jsonrpc", J.jString "2.0"), ("method", J.jString method), ("params", params)])

-- --- positions ---------------------------------------------------------------

-- Where each line of `t` starts, in bytes.
@pub fun lineStarts (t : String) : [Int] =
  V.foldl
    (\acc i -> if toInt (stringByteAt t i) == 10 then V.pushBack acc (i + 1) else acc)
    [0]
    (V.range 0 (stringByteLength t))

fun lineOf (starts : [Int]) (offset : Int) : Int =
  V.foldl (\acc i -> if V.getOr 0 starts i <= offset then i else acc) 0 (V.range 0 (V.len starts))

-- How many UTF-16 code units `s` is: what the protocol counts a column in.
fun units (s : String) : Int =
  V.foldl (\n c -> n + (if C.code c >= 65536 then 2 else 1)) 0 (S.chars s)

fun clamp t offset = max 0 (min offset (stringByteLength t))

-- Byte `offset` of `t` as a line and a column.
@pub fun position (t : String) (starts : [Int]) (offset : Int) : (Int, Int) =
  let o = clamp t offset in
  let l = lineOf starts o in
  (l, units (stringSlice t (V.getOr 0 starts l) o))

-- A line and a column of `t` as a byte offset.
@pub fun offsetOf (t : String) (starts : [Int]) (line : Int) (col : Int) : Int =
  let len = stringByteLength t in
  let st = min len (V.getOr len starts line) in
  let stop = V.getOr len starts (line + 1) in
  let walked =
    V.foldl
      (\acc c ->
        match acc with
        | (u, b) ->
            if u >= col then acc
            else (u + (if C.code c >= 65536 then 2 else 1), b + utf8Len (C.code c)))
      (0, 0)
      (S.chars (stringSlice t st stop))
  in st + snd walked

fun utf8Len n = if n < 128 then 1 else if n < 2048 then 2 else if n < 65536 then 3 else 4

fun posJson p = J.jObject [("line", J.jInt (fst p)), ("character", J.jInt (snd p))]

@pub fun rangeJson (t : String) (starts : [Int]) (m : Meta) : Json =
  match m with
  | Meta a b ->
      J.jObject [("start", posJson (position t starts a)), ("end", posJson (position t starts b))]

-- The byte a request's `position` is at.
@pub fun offsetIn (t : String) (params : Json) : Int =
  let p = J.get "position" params in
  let n = \k -> M.unwrapOr 0 (M.andThen J.asInt (M.andThen (J.get k) p)) in
  offsetOf t (lineStarts t) (n "line") (n "character")

-- --- the documents open ------------------------------------------------------

-- Each open document's file and text, by its URI; and its URI, by its file.
@pub data Docs
  = Docs (HashMap String Int) (HashMap Int String) (HashMap Int String) Int

fun emptyDocs () = Docs HashMap.empty HashMap.empty HashMap.empty 1

@pub fun uriOf (d : Docs) (file : Int) : String =
  match d with | Docs _ u _ _ -> HashMap.getOr "" file u

@pub fun textOf (d : Docs) (file : Int) : String =
  match d with | Docs _ _ t _ -> HashMap.getOr "" file t

@pub fun fileOf (d : Docs) (uri : String) : Maybe Int =
  match d with | Docs f _ _ _ -> HashMap.lookup uri f

@pub fun openFiles (d : Docs) : [Int] = match d with | Docs _ u _ _ -> HashMap.keys u

-- `uri` holding `text`: its file, a new one the first time.
fun withText (d : Docs) (uri : String) (text : String) : (Docs, Int) =
  match d with
  | Docs f u t next ->
      (match HashMap.lookup uri f with
       | Just file -> (Docs f u (HashMap.insert file text t) next, file)
       | None ->
           (
             Docs
               (HashMap.insert uri next f)
               (HashMap.insert next uri u)
               (HashMap.insert next text t)
               (next + 1),
             next
           ))

-- --- what a language's own request is asked ---------------------------------

-- A request, as a language's own answer to it is given it: its method, the
-- file it is about -- `-1` for one about none that is open -- that file's
-- text, the byte its `position` is at, its parameters as they came, and the
-- documents open.
@pub record Asked = {
  @pub method : String,
  @pub file : Int,
  @pub text : String,
  @pub offset : Int,
  @pub params : Json,
  @pub docs : Docs,
}

@pub fun asked
    (docs : Docs)
    (method : String)
    (file : Int)
    (text : String)
    (offset : Int)
    (params : Json)
    : Asked =
  Asked { method, file, text, offset, params, docs }

-- Where `m` is in the file asked about, as the protocol says a range.
@pub fun rangeIn (a : Asked) (m : Meta) : Json = rangeJson a.text (lineStarts a.text) m

-- Byte `offset` of the file asked about, as the protocol says a position.
@pub fun positionIn (a : Asked) (offset : Int) : Json =
  posJson (position a.text (lineStarts a.text) offset)

-- A place in any open file, as the protocol says a location.
@pub fun locationIn (a : Asked) (place : (Int, Meta)) : Json = locationJson a.docs place

-- The byte of the file asked about that a position among the parameters is
-- at: `byteIn a ["range", "start"]`.
@pub fun byteIn (a : Asked) (path : [String]) : Int =
  let p = J.path path a.params in
  let n = \k -> M.unwrapOr 0 (M.andThen J.asInt (M.andThen (J.get k) p)) in
  offsetOf a.text (lineStarts a.text) (n "line") (n "character")

-- The methods a language answers itself.
@pub fun methodsOf requests : [String] = V.map (\r -> match r with | (m, _) -> m) requests

-- A language's own answer to `method`, if it has one.
@pub fun answered requests db (a : Asked) =
  M.map (\r -> match r with | (_, act) -> act db a) (V.find (\r -> fst r == a.method) requests)

-- --- serving -----------------------------------------------------------------

-- A language server, until the editor says `exit`: `opened` told of each
-- file the editor opens -- its number and its uri, before its text -- and
-- `setText` of every edit, `diagnose` asked what is wrong in each open file
-- after it, and `answer` given every other request -- its method, the file
-- it is about, the file's text and the byte it points at -- answering `None`
-- for one it cannot. `own` are the methods the language answers itself,
-- which may be about no file, and `extra` what else it says the server can
-- do.
@pub fun serve name features (own : [String]) extra opened setText diagnose answer =
  loop (name, features, own, extra) (edited opened setText) diagnose answer (emptyDocs ())

-- What a server does with a file's text: told first where the file is, if
-- the editor has just opened it.
fun edited opened setText =
  \opening file t ->
    let u =
      (match opening with
       | Just uri -> opened file uri
       | None -> ())
    in setText file t

-- The path of a `file:` uri, as the disk has it -- `file:///c%3A/a%20b` is
-- `c:/a b` -- and any other uri as it is.
@pub fun pathOf (uri : String) : String =
  if not (S.startsWith "file://" uri) then uri
  else
    let p = decoded (S.drop uri 7) in
    -- A drive's path is written after a `/`: `/c:/x`.
    let cs = S.chars p in
    if V.len cs >= 3 and V.getOr ' ' cs 0 == '/' and V.getOr ' ' cs 2 == ':' then S.drop p 1 else p

-- `%XX` escapes as the bytes they are, read as UTF-8.
fun decoded (s : String) : String =
  let cs = S.chars s in
  let hex = \i -> M.andThen (\c -> C.hexDigitToInt c) (V.get cs i) in
  let rec go (i : Int) (bytes : [Int]) (out : [Char]) =
    if i >= V.len cs then V.append out (utf8 bytes)
    else
      match (V.get cs i, hex (i + 1), hex (i + 2)) with
      | (Just '%', Just a, Just b) -> go (i + 3) (V.pushBack bytes (a * 16 + b)) out
      | (Just c, _, _) -> go (i + 1) [] (V.pushBack (V.append out (utf8 bytes)) c)
      | _ -> out
  in S.fromChars (go 0 [] [])

-- The characters of UTF-8 bytes; a byte that begins none is itself.
fun utf8 (bytes : [Int]) : [Char] =
  let b = \i -> V.getOr 0 bytes i in
  let rec go (i : Int) (out : [Char]) =
    if i >= V.len bytes then out
    else
      let x = b i in
      if x >= 240 and i + 3 < V.len bytes then
        go
          (i + 4)
          (V.pushBack
             out
             (C.fromCode
                ((x - 240) * 262144
                   + (b (i + 1) - 128) * 4096
                   + (b (i + 2) - 128) * 64
                   + (b (i + 3) - 128))))
      else if x >= 224 and i + 2 < V.len bytes then
        go
          (i + 3)
          (V.pushBack
             out
             (C.fromCode ((x - 224) * 4096 + (b (i + 1) - 128) * 64 + (b (i + 2) - 128))))
      else if x >= 192 and i + 1 < V.len bytes then
        go (i + 2) (V.pushBack out (C.fromCode ((x - 192) * 64 + (b (i + 1) - 128))))
      else go (i + 1) (V.pushBack out (C.fromCode x))
  in go 0 []

fun loop about setText diagnose answer docs =
  match about with
  | (name, features, own, extra) -> looping about name own setText diagnose answer docs

fun looping about name own setText diagnose answer docs =
  match readMessage () with
  | None -> ()
  | Just msg ->
      let method = M.unwrapOr "" (M.andThen J.asString (J.get "method" msg)) in
      let id = J.get "id" msg in
      let params = M.unwrapOr (J.jNull ()) (J.get "params" msg) in
      let uri = M.unwrapOr "" (M.andThen J.asString (J.path ["textDocument", "uri"] params)) in
      if method == "exit" then ()
      else if method == "initialize" then
        (let u =
           (match about with
            | (_, features, _, extra) ->
                reply (M.unwrapOr (J.jNull ()) id) (initialized name features own extra))
         in loop about setText diagnose answer docs)
      else if method == "shutdown" then
        (let u = reply (M.unwrapOr (J.jNull ()) id) (J.jNull ()) in
         loop about setText diagnose answer docs)
      else if method == "textDocument/didOpen" or method == "textDocument/didChange" then
        (let text =
           (if method == "textDocument/didOpen" then
              M.andThen J.asString (J.path ["textDocument", "text"] params)
            else lastChange params)
         in match text with
            | None -> loop about setText diagnose answer docs
            | Just t ->
                (match withText docs uri t with
                 | (d2, file) ->
                     (let u =
                        setText (if method == "textDocument/didOpen" then Just uri else None) file t
                      in
                      let w = publishAll name diagnose d2 in
                      loop about setText diagnose answer d2)))
      else if method == "textDocument/didClose" then
        (let u =
           notify
             "textDocument/publishDiagnostics"
             (J.jObject [("uri", J.jString uri), ("diagnostics", J.jArray [])])
         in loop about setText diagnose answer docs)
      else
        match id with
        | None -> loop about setText diagnose answer docs
        | Just i ->
            (let u = answering own answer docs method i uri params in
             loop about setText diagnose answer docs)

-- A request answered: by `answer`, of the file it is about; or, about no
-- open file, only if its method is one of the language's `own`.
fun answering (own : [String]) answer docs method i uri params =
  match fileOf docs uri with
  | None ->
      if V.elem method own then
        reply i (M.unwrapOr (J.jNull ()) (answer docs method (0 - 1) "" 0 params))
      else reply i (J.jNull ())
  | Just file ->
      (let t = textOf docs file in
       match answer docs method file t (offsetIn t params) params with
       | Just r -> reply i r
       | None -> replyError i (0 - 32601) "`${method}` is not something this server does")

-- The whole text of the last change: the server asks for whole documents.
fun lastChange params =
  match M.andThen J.asArray (J.get "contentChanges" params) with
  | Just cs -> M.andThen (\c -> M.andThen J.asString (J.get "text" c)) (V.get cs (V.len cs - 1))
  | None -> None

-- What is wrong in every open file: one edit can change what another says.
fun publishAll name diagnose docs =
  published name docs (V.map (\file -> (file, diagnose file)) (openFiles docs))

-- The editor told what was `found` wrong, file by file.
fun published name docs (found : [(Int, [Diagnostic])]) =
  V.foldl
    (\u f ->
      match f with
      | (file, wrong) ->
          let t = textOf docs file in
          let starts = lineStarts t in
          notify
            "textDocument/publishDiagnostics"
            (J.jObject [
               ("uri", J.jString (uriOf docs file)),
               (
                 "diagnostics",
                 J.jArray (V.map (diagnosticJson name (uriOf docs file) t starts) wrong)
               )
             ]))
    ()
    found

-- --- serving, on threads -----------------------------------------------------
--
-- One thread reads what the editor sends, so that nothing waits to be read;
-- one looks for what is wrong after an edit; and this one, which keeps the
-- documents and is the only one that writes, answers. A request is answered
-- while a file is still being looked at. An edit that arrives then stops the
-- looking first -- `interrupt`, wait for the thread, `allow` -- since an
-- input is set between asks and not during one; what the thread had found is
-- for a text that is no longer there, and is not sent.

-- What reaches the thread that answers: a message; no more of them; or word
-- that the thread started at an edit has looked at every open file.
data Arrived = Got Json | NoMore | Found Int

-- A language server as `serve` is one, on threads. `diagnose` is run on a
-- thread of its own, so it must answer and not raise; `interrupt` stops what
-- that thread is working out and `allow` lets the database be asked again.
@pub fun serveOnThreads
    name
    features
    (own : [String])
    extra
    opened
    setText
    diagnose
    answer
    interrupt
    allow =
  let inbox = Thread.newChannel () in
  let reader = Thread.spawn (\() -> reading inbox) in
  attending
    (name, features, own, extra)
    (edited opened setText)
    diagnose
    answer
    interrupt
    allow
    inbox
    (emptyDocs ())
    0
    None

-- Each message, handed on as it is read. The thread gives way after each:
-- one that went straight back to waiting on the editor would, on a runtime
-- whose threads take turns, keep the thread it had just woken from running.
fun reading inbox =
  match readMessage () with
  | None -> Thread.send inbox Arrived.NoMore
  | Just msg ->
      let u = Thread.send inbox (Arrived.Got msg) in
      let w = Thread.yieldNow () in
      -- Nothing is read after `exit`: a thread left waiting on the editor
      -- would keep the server from ending.
      if M.andThen J.asString (J.get "method" msg) == Just "exit" then () else reading inbox

-- What the thread looking at the files found, published -- waiting for it,
-- if it has not finished.
fun finishing name docs working =
  match working with
  | None -> ()
  | Just task -> published name docs (Thread.await task)

-- The thread looking at the files, stopped: nothing it found is wanted.
fun stopping working interrupt allow =
  match working with
  | None -> ()
  | Just task ->
      let a = interrupt () in
      let b = Thread.await task in
      allow ()

-- `edit` counts the edits so far, and `working` is the thread looking at the
-- files as the last of them left them, if it has not been heard from.
fun attending about setText diagnose answer interrupt allow inbox docs (edit : Int) working =
  let again = \d e w -> attending about setText diagnose answer interrupt allow inbox d e w in
  match about with
  | (name, features, own, extra) ->
      match Thread.receive inbox with
      | Arrived.NoMore -> finishing name docs working
      | Arrived.Found at ->
          if at != edit then again docs edit working
          else (let u = finishing name docs working in again docs edit None)
      | Arrived.Got msg ->
          let method = M.unwrapOr "" (M.andThen J.asString (J.get "method" msg)) in
          let id = J.get "id" msg in
          let params = M.unwrapOr (J.jNull ()) (J.get "params" msg) in
          let uri = M.unwrapOr "" (M.andThen J.asString (J.path ["textDocument", "uri"] params)) in
          if method == "exit" then ()
          else if method == "initialize" then
            (let u = reply (M.unwrapOr (J.jNull ()) id) (initialized name features own extra) in
             again docs edit working)
          else if method == "shutdown" then
            (let u = reply (M.unwrapOr (J.jNull ()) id) (J.jNull ()) in again docs edit working)
          else if method == "textDocument/didOpen" or method == "textDocument/didChange" then
            (let text =
               (if method == "textDocument/didOpen" then
                  M.andThen J.asString (J.path ["textDocument", "text"] params)
                else lastChange params)
             in match text with
                | None -> again docs edit working
                | Just t ->
                    (let s = stopping working interrupt allow in
                     match withText docs uri t with
                     | (d2, file) ->
                         let u =
                           setText
                             (if method == "textDocument/didOpen" then Just uri else None)
                             file
                             t
                         in
                         let files = openFiles d2 in
                         let at = edit + 1 in
                         let task =
                           Thread.spawn (\() ->
                             let found = V.map (\f -> (f, diagnose f)) files in
                             let w = Thread.send inbox (Arrived.Found at) in
                             found)
                         in again d2 at (Just task)))
          else if method == "textDocument/didClose" then
            (let u =
               notify
                 "textDocument/publishDiagnostics"
                 (J.jObject [("uri", J.jString uri), ("diagnostics", J.jArray [])])
             in again docs edit working)
          else
            match id with
            | None -> again docs edit working
            | Just i ->
                (let u = answering own answer docs method i uri params in again docs edit working)

fun diagnosticJson name uri t starts (d : Diagnostic) =
  match d with
  | Diagnostic sev msg at labels notes ->
      J.jObject [
        ("range", rangeJson t starts at),
        ("severity", J.jInt (severityCode sev)),
        ("source", J.jString name),
        ("message", J.jString (S.join "\n" (V.pushFront notes msg))),
        (
          "relatedInformation",
          J.jArray
            (V.map
               (\l ->
                 J.jObject [
                   (
                     "location",
                     J.jObject [("uri", J.jString uri), ("range", rangeJson t starts (fst l))]
                   ),
                   ("message", J.jString (snd l))
                 ])
               labels)
        )
      ]

fun severityCode s =
  match s with
  | Severity.Error -> 1
  | Severity.Warning -> 2
  | Severity.Advice -> 3

-- What a language that answers `own` itself can do that the features do not
-- say: the methods of the protocol an editor has to be told of.
fun owned (own : [String]) : [(String, Json)] =
  let has = \m -> V.elem m own in
  V.concat [
    if has "textDocument/inlayHint" then [("inlayHintProvider", J.jBool True)] else [],
    if has "textDocument/codeLens" then
      [("codeLensProvider", J.jObject [("resolveProvider", J.jBool (has "codeLens/resolve"))])]
    else [],
    if has "workspace/symbol" then [("workspaceSymbolProvider", J.jBool True)] else []
  ]

-- What the server can do, from the features it was given, the methods the
-- language answers itself, and what else it says: of two that say the same
-- thing, the later.
fun initialized name features (own : [String]) (extra : [(String, Json)]) =
  let has = \f -> V.elem f features in
  let when = \f fields -> if has f then fields else [] in
  let said = V.append (owned own) extra in
  let over = \fields -> V.filter (\f -> not (V.any (\x -> fst x == fst f) said)) fields in
  J.jObject [
    (
      "capabilities",
      J.jObject
        (V.concat [
           [
             ("positionEncoding", J.jString "utf-16"),
             ("textDocumentSync", J.jObject [("openClose", J.jBool True), ("change", J.jInt 1)])
           ],
           when "tree" [
             (
               "semanticTokensProvider",
               J.jObject [
                 (
                   "legend",
                   J.jObject [
                     ("tokenTypes", J.jArray (V.map J.jString tokenTypes)),
                     ("tokenModifiers", J.jArray [])
                   ]
                 ),
                 ("full", J.jBool True)
               ]
             ),
             ("foldingRangeProvider", J.jBool True),
             ("selectionRangeProvider", J.jBool True)
           ],
           when "hover" [("hoverProvider", J.jBool True)],
           when "definition" [("definitionProvider", J.jBool True)],
           when "references" [
             ("referencesProvider", J.jBool True),
             ("documentHighlightProvider", J.jBool True),
             ("renameProvider", J.jObject [("prepareProvider", J.jBool True)])
           ],
           if has "completion" or V.elem "textDocument/completion" own then
             [(
               "completionProvider",
               J.jObject
                 (if V.elem "completionItem/resolve" own then [("resolveProvider", J.jBool True)]
                  else [])
             )]
           else [],
           when "symbols" [("documentSymbolProvider", J.jBool True)],
           when "format" [("documentFormattingProvider", J.jBool True)]
         ]
           |> over
           |> (\fields -> V.append fields said))
    ),
    ("serverInfo", J.jObject [("name", J.jString name)])
  ]

-- --- answers -----------------------------------------------------------------

@pub fun hoverReply (t : String) (h : Maybe (Meta, String)) : Json =
  match h with
  | None -> J.jNull ()
  | Just (m, what) ->
      J.jObject [
        ("contents", J.jObject [("kind", J.jString "markdown"), ("value", J.jString what)]),
        ("range", rangeJson t (lineStarts t) m)
      ]

-- The file set out: one edit putting `formatted` where the whole of `t` is,
-- and none when they are the same.
@pub fun formatReply (t : String) (formatted : String) : Json =
  if formatted == t then J.jArray []
  else
    J.jArray
      [J.jObject [
         ("range", rangeJson t (lineStarts t) (Meta 0 (stringByteLength t))),
         ("newText", J.jString formatted)
       ]]

fun locationJson docs (p : (Int, Meta)) =
  let t = textOf docs (fst p) in
  J.jObject [("uri", J.jString (uriOf docs (fst p))), ("range", rangeJson t (lineStarts t) (snd p))]

@pub fun locationsReply (docs : Docs) (ps : [(Int, Meta)]) : Json =
  J.jArray (V.map (locationJson docs) ps)

-- The places in `file` among `ps`, for the editor to light up.
@pub fun highlightsReply (t : String) (file : Int) (ps : [(Int, Meta)]) : Json =
  let starts = lineStarts t in
  J.jArray
    (V.map
       (\p -> J.jObject [("range", rangeJson t starts (snd p))])
       (V.filter (\p -> fst p == file) ps))

-- The name the editor is on, if it is one that can be renamed: one of `ps`.
@pub fun prepareRenameReply (t : String) (file : Int) (offset : Int) (ps : [(Int, Meta)]) : Json =
  match V.find (\p -> fst p == file and within offset (snd p)) ps with
  | Just p -> rangeJson t (lineStarts t) (snd p)
  | None -> J.jNull ()

fun within o m = match m with | Meta a b -> a <= o and o <= b

@pub fun newName (params : Json) : String =
  M.unwrapOr "" (M.andThen J.asString (J.get "newName" params))

-- Every one of `ps` made `name`.
@pub fun renameReply (docs : Docs) (ps : [(Int, Meta)]) (name : String) : Json =
  let files =
    V.foldl (\acc p -> if V.elem (fst p) acc then acc else V.pushBack acc (fst p)) [] ps
  in J.jObject
       [(
         "changes",
         J.jObject
           (V.map
              (\f ->
                let t = textOf docs f in
                let starts = lineStarts t in
                (
                  uriOf docs f,
                  J.jArray
                    (V.map
                       (\p ->
                         J.jObject [
                           ("range", rangeJson t starts (snd p)),
                           ("newText", J.jString name)
                         ])
                       (V.filter (\p -> fst p == f) ps))
                ))
              files)
       )]

@pub fun completionReply (items : [(String, String)]) : Json =
  J.jArray
    (V.map (\i -> J.jObject [("label", J.jString (fst i)), ("detail", J.jString (snd i))]) items)

@pub fun symbolsReply (t : String) (xs : [(String, String, Meta)]) : Json =
  let starts = lineStarts t in
  J.jArray
    (V.map
       (\x ->
         match x with
         | (n, k, m) ->
             J.jObject [
               ("name", J.jString n),
               ("kind", J.jInt (symbolKind k)),
               ("range", rangeJson t starts m),
               ("selectionRange", rangeJson t starts m)
             ])
       xs)

fun symbolKind k =
  if k == "function" then 12
  else if k == "variable" then 13
  else if k == "module" then 2
  else if k == "type" then 5
  else if k == "constant" then 14
  else 13

-- --- read off the tree -------------------------------------------------------

-- What a token can be, to an editor's colours.
-- The classes a token may be, in the order the protocol indexes them:
-- Meadow's own server's, and `comment`, which a Lingua lexer keeps as a
-- token.
@pub def tokenTypes : [String] =
  [
    "keyword", "type", "enumMember", "function", "variable", "number", "string", "operator",
    "namespace", "comment"
  ]

-- A class's place among them: -1 for a name that is none of them.
@pub fun classOf (name : String) : Int =
  V.foldl
    (\at i -> if at < 0 and V.get tokenTypes i == Just name then i else at)
    (0 - 1)
    (V.range 0 (V.len tokenTypes))

-- What token `t`, of a kind called `name`, is -- read off the name the
-- grammar gave its kind, and the text: a word the grammar spells out is a
-- keyword, anything else it spells out an operator. `None` for what an
-- editor does not colour.
@pub fun tokenClass (name : String) (t : String) : Maybe Int =
  let has = \w -> S.contains w name in
  if has "Whitespace" or has "Error" or S.trim t == "" then None
  else if has "Comment" then Just (classOf "comment")
  else if has "Ident" or has "Name" then Just (classOf "variable")
  else if has "String" or has "Str" then Just (classOf "string")
  else if has "Number" or has "Int" or has "Float" or V.all C.isDigit (S.chars t) then
    Just (classOf "number")
  else if V.all (\c -> C.isAlpha c or c == '_') (S.chars t) then Just (classOf "keyword")
  else Just (classOf "operator")

-- Every token of `s`, where it is.
fun allTokens s = if R.isTokenOf s then [s] else V.concatMap allTokens (R.children s)

fun allNodes s = if R.isTokenOf s then [] else V.pushFront (V.concatMap allNodes (R.children s)) s

-- The tokens of a tree that are coloured, in order: the bytes each is from
-- and to, and which of `tokenTypes` it is. What an editor is told, and what
-- a prompt colours an entry with (`Lingua.Repl`): one answer to what a
-- token is, wherever it is shown.
@pub fun classified (kindName : k -> String) (g : Green k) : [(Int, Int, Int)] =
  V.concatMap
    (\tok ->
      match tokenClass (kindName (R.kindOf tok)) (R.text tok) with
      | None -> []
      | Just c -> (match R.range tok with | (a, b) -> [(a, b, c)]))
    (allTokens (R.root g))

-- Those tokens, each as what it resolved to where the compiler knows: a
-- token that starts at a byte `resolved` says something of is that class,
-- and every other is what its spelling made it. What a spelling cannot say
-- -- that a name is a function's, a capital a type and not a constructor --
-- name resolution does, of that one occurrence.
@pub fun refined (classes : [(Int, Int, Int)]) (resolved : [(Int, String)]) : [(Int, Int, Int)] =
  let known =
    V.foldl
      (\m r ->
        let c = classOf (snd r) in
        if c < 0 then m else HashMap.insert (fst r) c m)
      HashMap.empty
      resolved
  in V.map
       (\x ->
         match x with
         | (a, b, c) -> (a, b, M.unwrapOr c (HashMap.lookup a known)))
       classes

-- Those tokens, as the protocol encodes them: each line by line, from where
-- the last one was.
@pub fun tokensReply (t : String) (classes : [(Int, Int, Int)]) : Json =
  let starts = lineStarts t in
  let pieces =
    V.concatMap
      (\x ->
        match x with
        | (a, b, c) -> V.map (\seg -> (fst seg, snd seg, c)) (lineSegments t starts a b))
      classes
  in J.jObject [("data", J.jArray (V.map J.jInt (encode pieces)))]

fun encode pieces =
  match V.foldl
    (\acc p ->
      match (acc, p) with
      | ((out, pl, pc), (pos, len, c)) ->
          (match pos with
           | (l, col) ->
               (V.append out [l - pl, (if l == pl then col - pc else col), len, c, 0], l, col)))
    ([], 0, 0)
    pieces with
  | (out, _, _) -> out

-- Bytes `a` to `b` of `t`, a piece per line: where each starts, and how
-- long it is -- the protocol's tokens do not cross lines.
fun lineSegments t starts a b =
  let first = lineOf starts a in
  let last = lineOf starts (max a (b - 1)) in
  V.concatMap
    (\l ->
      let from = max a (V.getOr 0 starts l) in
      let lineEnd = V.getOr (stringByteLength t) starts (l + 1) in
      let to = min b lineEnd in
      let piece = S.trimEnd (stringSlice t from to) in
      if S.isEmpty piece then [] else [(position t starts from, units piece)])
    (V.range first (last + 1))

-- A fold for every node that takes more than one line.
@pub fun foldingReply (t : String) (g : Green k) : Json =
  let starts = lineStarts t in
  let spans =
    V.concatMap
      (\n ->
        match R.range n with
        | (a, b) ->
            (let l1 = lineOf starts a in
             let l2 = lineOf starts (max a (b - 1)) in
             if l2 > l1 then [(l1, l2)] else []))
      (allNodes (R.root g))
  in
  let kept =
    V.foldl (\acc s -> if V.any (\k -> fst k == fst s) acc then acc else V.pushBack acc s) [] spans
  in J.jArray
       (V.map (\s -> J.jObject [("startLine", J.jInt (fst s)), ("endLine", J.jInt (snd s))]) kept)

-- For each position asked about: the token there, and each node around it,
-- innermost first -- what "expand selection" walks out through.
@pub fun selectionReply (t : String) (g : Green k) (params : Json) : Json =
  let starts = lineStarts t in
  let positions = M.unwrapOr [] (M.andThen J.asArray (J.get "positions" params)) in
  let root = R.root g in
  J.jArray
    (V.map
       (\p ->
         let n = \k -> M.unwrapOr 0 (M.andThen J.asInt (J.get k p)) in
         let at = offsetOf t starts (n "line") (n "character") in
         let chain =
           (match R.tokenAt at root with
            | Just tok -> V.pushFront (R.ancestors tok) tok
            | None -> [root])
         in
         let ranges =
           V.foldl
             (\acc s ->
               if V.any (\r -> r == R.range s) acc then acc else V.pushBack acc (R.range s))
             []
             chain
         in V.foldr
              (\r parent ->
                J.jObject
                  (V.append
                     [("range", rangeJson t starts (Meta (fst r) (snd r)))]
                     (if J.isNull parent then [] else [("parent", parent)])))
              (J.jNull ())
              ranges)
       positions)

-- --- a server, without an editor ---------------------------------------------

-- What `server` writes when it is sent `messages` and then no more: each of
-- its replies and notifications, in order. For a test of a server, which
-- otherwise reads what an editor sends it.
@pub fun told (messages : [Json]) server =
  let bodies = V.map J.render messages in
  -- Which message is next, and how much of it has been read: nothing, the
  -- line that says how long it is, or the empty line after that.
  let feed =
    handle withOutput server with {
      readLine () k ->
        \next part ->
          (match V.get bodies next with
           | None -> (k None) next part
           | Just body ->
               if part == 0 then (k (Just "Content-Length: ${show (stringByteLength body)}")) next 1
               else (k (Just "")) next 2),
      readExact n k -> \next part -> (k (V.get bodies next)) (next + 1) 0,
      return x -> \next part -> x
    }
  in written (snd (feed 0 0))

-- The messages in what a server wrote.
@pub fun written (out : String) : [Json] =
  V.concatMap
    (\piece ->
      match V.get (S.split "\r\n\r\n" piece) 1 with
      | None -> []
      | Just body -> (match J.parse body with | Ok j -> [j] | Err _ -> []))
    (S.split "Content-Length: " out)

-- --- lsp! --------------------------------------------------------------------

use Std.Macro (TokenTree, Loc, isPunct, defineAs)
use Std.Macro.TokenTree.*
use Std.Macro.Loc.*
use Std.Macro.Parse (Tokens, parseTokens, ident, keyword, punct, stringLit)
use Std.String.Parse as P
use Std.String.Parse (Parser)
use Std.String.Parse (keep, skip)
use Lingua.Pipe (named)

-- The features a server can be given, and what each does.
def features : [String] =
  [
    "text", "diagnostics", "tree", "hover", "definition", "references", "completion", "symbols",
    "format", "resolved", "requests", "capabilities", "opened"
  ]

-- `| hover = hoverAt`: a feature, where it was written, and the function.
def featureP : Parser Tokens ((String, Loc), String) =
  P.pure (\f fn -> (f, fn)) |> skip (punct "|") |> keep named |> skip (punct "=") |> keep ident

-- A feature as it is read: its name, where that was written, and the
-- function it is.
type LspFeature = ((String, Loc), String)

def lspCall : Parser Tokens (Bool, String, String, (String, Bool), [LspFeature]) =
  P.pure (\pub name lang db threaded fs -> (M.isSome pub, name, lang, (db, M.isSome threaded), fs))
    |> keep (P.optional (keyword "pub"))
    |> keep ident
    |> keep stringLit
    |> skip (keyword "for")
    |> keep ident
    |> keep (P.optional (keyword "threaded"))
    |> keep (P.some featureP)

@macro
@pub fun lsp (ts : [TokenTree]) : [TokenTree] ! { Expand | e } =
  match parseTokens lspCall ts with
  | Err failed -> failed
  | Ok (pub, name, lang, (db, threaded), fs) ->
      match V.find (\f -> not (V.elem (fst (fst f)) features)) fs with
      | Just f ->
          [Fail
             "a server has no feature `${fst (fst f)}`: the features are ${S.join ", " (V.map (\x -> "`${x}`") features)}"
             (snd (fst f))]
      | None ->
          if not (V.any (\f -> fst (fst f) == "text") fs) then
            [Fail "a server needs `text`: how the editor's text is given to the compiler" Nowhere]
          else if V.any (\f -> fst (fst f) == "resolved") fs
            and not (V.any (\f -> fst (fst f) == "tree") fs) then
            [Fail
               "`resolved` says what the tree's tokens are: a server that has it needs `tree`"
               Nowhere]
          else
            -- A server that has the tree says so, for a prompt over the same
            -- database to colour what is typed as the editor would.
            let u =
              if V.any (\f -> fst (fst f) == "tree") fs then defineAs (serverOf db) name else ()
            in [Code (lspCode (if pub then "@pub " else "") name lang db threaded fs)]

-- What the server of database `db` is recorded under, for `repl!` to find.
@pub fun serverOf (db : String) : String = "LinguaLspFor${db}"

fun lspCode pub name lang db (threaded : Bool) fs =
  let fn = \f -> M.unwrapOr "" (M.map snd (V.find (\x -> fst (fst x) == f) fs)) in
  let has = \f -> V.any (\x -> fst (fst x) == f) fs in
  let arm =
    \f method reply ->
      if has f then "    else if method == \"${method}\" then Just (${reply})\n" else ""
  in
  let requests = if has "requests" then fn "requests" else "[]" in
  -- A language's own answer comes first, so that it may answer in Lingua's
  -- place; and nothing of Lingua's is asked of no file.
  let ownArm =
    if has "requests" then
      "    else if LinguaV.elem method (LinguaLsp.methodsOf ${requests}) then LinguaLsp.answered ${requests} db (LinguaLsp.asked docs method file t offset params)\n    else if file < 0 then None\n"
    else ""
  in
  let tree = "(${fn "tree"} db file)" in
  let refs = "(${fn "references"} db file offset)" in
  -- What a server is given, however it is run.
  let args = "    \"${lang}\"
    [${S.join ", " (V.map (\f -> "\"${fst (fst f)}\"") fs)}]
    (LinguaLsp.methodsOf ${requests})
    ${if has "capabilities" then fn "capabilities" else "[]"}
    (\\file uri -> ${if has "opened" then "${fn "opened"} db file uri" else "()"})
    (\\file t -> ${fn "text"} db file t)
    (\\file -> ${if has "diagnostics" then "${fn "diagnostics"} db file" else "[]"})
    (\\docs method file t offset params ->
    if False then None
${ownArm}${arm "hover" "textDocument/hover" "LinguaLsp.hoverReply t (${fn "hover"} db file offset)"}${arm "tree" "textDocument/semanticTokens/full" "LinguaLsp.tokensReply t (tokens${name} db file)"}${arm "tree" "textDocument/foldingRange" "LinguaLsp.foldingReply t ${tree}"}${arm "tree" "textDocument/selectionRange" "LinguaLsp.selectionReply t ${tree} params"}${arm "definition" "textDocument/definition" "LinguaLsp.locationsReply docs (${fn "definition"} db file offset)"}${arm "references" "textDocument/references" "LinguaLsp.locationsReply docs ${refs}"}${arm "references" "textDocument/documentHighlight" "LinguaLsp.highlightsReply t file ${refs}"}${arm "references" "textDocument/prepareRename" "LinguaLsp.prepareRenameReply t file offset ${refs}"}${arm "references" "textDocument/rename" "LinguaLsp.renameReply docs ${refs} (LinguaLsp.newName params)"}${arm "completion" "textDocument/completion" "LinguaLsp.completionReply (${fn "completion"} db file offset)"}${arm "symbols" "textDocument/documentSymbol" "LinguaLsp.symbolsReply t (${fn "symbols"} db file)"}${arm "format" "textDocument/formatting" "LinguaLsp.formatReply t (${fn "format"} db file)"}    else None)
" in
  let inTurn =
    \called -> "${pub}fun ${called} () =\n  let db = new${db} () in\n  LinguaLsp.serve\n${args}"
  in
  let serving =
    if threaded then
      "-- A language server for ${lang}, on standard input and output, until the\n-- editor says `exit`: reading, looking for what is wrong and answering each\n-- on a thread.\n${pub}fun serve${name} () =\n  let db = new${db} () in\n  LinguaLsp.serveOnThreads\n${args}    (\\() -> interrupt${db} db)\n    (\\() -> allow${db} db)\n\n-- The same server, a message at a time: what a test tells.\n${inTurn "serve${name}InTurn"}"
    else
      "-- A language server for ${lang}, on standard input and output, until the\n-- editor says `exit`.\n${inTurn "serve${name}"}"
  in "use Lingua.Lsp as LinguaLsp
use Std.Collections.Vector as LinguaV
${if has "tree" then "\n-- What ${lang}'s editor colours in a file: each token's bytes, and its class.\n${pub}fun tokens${name} db file = ${if has "resolved" then "LinguaLsp.refined (LinguaLsp.classified display (${fn "tree"} db file)) (${fn "resolved"} db file)" else "LinguaLsp.classified display (${fn "tree"} db file)"}\n" else ""}
${serving}"

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)
use Std.Macro (Expand)
use Std.Collections.HashMap (HashMap)

@test fun aColumnIsCountedInUtf16 () =
  -- `é` is two bytes and one unit; `𝑥` four bytes and two units.
  let t = "é = 1\n𝑥 + y" in
  let starts = lineStarts t in
  let a =
    assertEq
      (V.map (position t starts) [0, 2, 3, 7, 11, 12])
      [(0, 0), (0, 1), (0, 2), (1, 0), (1, 2), (1, 3)]
      "each byte's place"
  in assertEq
       (V.map (\p -> offsetOf t starts (fst p) (snd p)) [(0, 1), (1, 2), (1, 4)])
       [2, 11, 13]
       "and back"

@test fun aTokenIsColouredByItsKindAndItsText () =
  assertEq
    (V.map (\p -> tokenClass (fst p) (snd p)) [
       ("Let", "let"),
       ("Ident", "x"),
       ("Number", "12"),
       ("Plus", "+"),
       ("Comment", "-- hi"),
       ("Whitespace", " ")
     ])
    [Just 0, Just 4, Just 5, Just 7, Just 9, None]
    "keyword, name, number, operator, comment, nothing"

fun request (id : Int) (method : String) (params : Json) : Json =
  J.jObject [
    ("jsonrpc", J.jString "2.0"),
    ("id", J.jInt id),
    ("method", J.jString method),
    ("params", params)
  ]

fun opening (uri : String) (text : String) : Json =
  J.jObject [
    ("jsonrpc", J.jString "2.0"),
    ("method", J.jString "textDocument/didOpen"),
    (
      "params",
      J.jObject [("textDocument", J.jObject [("uri", J.jString uri), ("text", J.jString text)])]
    )
  ]

fun about (uri : String) : Json = J.jObject [("textDocument", J.jObject [("uri", J.jString uri)])]

-- A server with nothing but a language's own requests: how long the file
-- asked about is, and one that is about no file.
fun lengths () =
  let own =
    [
      ("test/length", \db (a : Asked) -> J.jInt (stringByteLength a.text)),
      ("workspace/symbol", \db (a : Asked) -> J.jInt a.file)
    ]
  in serve
       "test"
       ["text"]
       (methodsOf own)
       [("experimental", J.jBool True)]
       (\file uri -> ())
       (\file t -> ())
       (\file -> [])
       (\docs method file t offset params ->
         answered own () (asked docs method file t offset params))

fun resultOf (j : Json) : Maybe Json = J.get "result" j

@test fun aLanguagesOwnRequestIsAnsweredOfTheFileAskedAbout () =
  let said =
    told
      [
        opening "file:///a" "let x = 1",
        request 1 "test/length" (about "file:///a"),
        request 2 "test/other" (about "file:///a")
      ]
      lengths
  in
  let a =
    assertEq
      (M.andThen resultOf (V.get said 1))
      (Just (J.jInt 9))
      "after the file's diagnostics, the language's answer: the text is what was opened"
  in assertEq
       (M.andThen (J.path ["error", "code"]) (V.get said 2))
       (Just (J.jInt (0 - 32601)))
       "and a method nobody answers is said not to be one"

@test fun aRequestAboutNoFileIsAskedOfTheLanguageOnlyIfItIsItsOwn () =
  let said =
    told
      [
        request 1 "workspace/symbol" (J.jObject [("query", J.jString "x")]),
        request 2 "textDocument/hover" (about "file:///nowhere")
      ]
      lengths
  in
  let a =
    assertEq (M.andThen resultOf (V.get said 0)) (Just (J.jInt (0 - 1))) "its own, with file -1"
  in assertEq (M.andThen resultOf (V.get said 1)) (Just (J.jNull ())) "and any other, nothing"

@test fun aServerSaysItCanDoWhatTheLanguageAnswers () =
  let said = told [request 1 "initialize" (J.jObject [])] lengths in
  let can = \k -> M.andThen (J.path ["result", "capabilities", k]) (V.get said 0) in
  let a =
    assertEq (can "workspaceSymbolProvider") (Just (J.jBool True)) "a method of the protocol's"
  in
  let b = assertEq (can "experimental") (Just (J.jBool True)) "what else it says" in
  assertEq (can "hoverProvider") None "and nothing it was not given"

-- A server on threads, given what has arrived for it already: what it wrote.
fun attended (arrived : [Arrived]) setText diagnose answer interrupt allow =
  let inbox = Thread.newChannel () in
  let u = V.foldl (\acc a -> Thread.send inbox a) () arrived in
  written
    (snd
       (withOutput (\() ->
          attending
            ("test", ["text"], ["test/go"], [])
            (\o file t -> setText file t)
            diagnose
            answer
            interrupt
            allow
            inbox
            (emptyDocs ())
            0
            None)))

@test fun aRequestIsAnsweredWhileAFileIsStillBeingLookedAt () =
  -- Looking at the file waits for the request to have been answered: a
  -- server that did one thing at a time would never get to it.
  let gate = Stm.newTVarIO False in
  let said =
    attended
      [
        Arrived.Got (opening "file:///a" "let x = 1"),
        Arrived.Got (request 1 "test/go" (about "file:///a")),
        Arrived.NoMore
      ]
      (\file t -> ())
      (\file ->
        let u = Stm.atomically (\() -> Stm.check (Stm.readTVar gate)) in
        [])
      (\docs method file t offset params ->
        let u = Stm.atomically (\() -> Stm.writeTVar gate True) in
        Just (J.jString "gone"))
      (\() -> ())
      (\() -> ())
  in
  let a =
    assertEq (M.andThen resultOf (V.get said 0)) (Just (J.jString "gone")) "the answer, first"
  in assertEq
       (M.andThen (J.get "method") (V.get said 1))
       (Just (J.jString "textDocument/publishDiagnostics"))
       "and what is wrong in the file when that had been found"

@test fun anEditStopsTheLookingBeforeItSetsTheText () =
  -- Looking at the first text never ends by itself; the second edit
  -- interrupts it, and only what is wrong in the second text is said.
  let gate = Stm.newTVarIO False in
  let held = Stm.newTVarIO "" in
  let stops = Stm.newTVarIO 0 in
  let said =
    attended
      [
        Arrived.Got (opening "file:///a" "first"),
        Arrived.Got (opening "file:///a" "second"),
        Arrived.NoMore
      ]
      (\file t -> Stm.atomically (\() -> Stm.writeTVar held t))
      (\file ->
        let t = Stm.readTVarIO held in
        if t == "first" then (let u = Stm.atomically (\() -> Stm.check (Stm.readTVar gate)) in [])
        else [Diagnostic Severity.Error t (Meta 0 1) [] []])
      (\docs method file t offset params -> None)
      (\() ->
        Stm.atomically (\() ->
          let u = Stm.writeTVar gate True in
          Stm.modifyTVar stops (\n -> n + 1)))
      (\() -> ())
  in
  let a = assertEq (V.len said) 1 "one thing said, not two" in
  let b =
    assertEq
      (M.andThen
         (\j ->
           M.andThen
             (J.get "message")
             (M.andThen
                (\ds -> V.get ds 0)
                (M.andThen J.asArray (J.path ["params", "diagnostics"] j))))
         (V.get said 0))
      (Just (J.jString "second"))
      "what is wrong in the text that is there"
  in assertEq (Stm.readTVarIO stops) 1 "and the looking was stopped once, by the edit"

@test fun tokensAreEncodedFromTheOneBefore () =
  assertEq
    (encode [((0, 0), 3, 0), ((0, 4), 2, 1), ((1, 2), 1, 5)])
    [0, 0, 3, 0, 0, 0, 4, 2, 1, 0, 1, 2, 1, 5, 0]
    "the same line from its column, the next from the start"

@test fun aFileUriIsThePathOnTheDisk () =
