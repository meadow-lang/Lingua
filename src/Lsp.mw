     ])
    ["c:/Users/Chris M/a.idl", "/home/x/café.idl", "C:/x.idl", "untitled:1"]
    "a drive's path without its `/`, escapes as what they are, and any other uri as it is"

-- A server told where each file is when it is opened: it answers what it was
-- told, in order, with each text it was given after.
fun located () =
  let seen = newRef [] in
  let own = [("test/seen", \db (a : Asked) -> J.jString (S.join ", " (getRef seen)))] in
  serve
    "test"
    ["text", "opened"]
    (methodsOf own)
    []
    (\file uri -> setRef seen (V.pushBack (getRef seen) "${show file} at ${pathOf uri}"))
    (\file t -> setRef seen (V.pushBack (getRef seen) "${show file} is ${t}"))
    (\file -> [])
    (\docs method file t offset params -> answered own () (asked docs method file t offset params))

@test fun aServerIsToldWhereAFileIsBeforeItsText () =
  let said =
    told
      [
        opening "file:///w/a.idl" "one",
        J.jObject [
          ("jsonrpc", J.jString "2.0"),
          ("method", J.jString "textDocument/didChange"),
          (
            "params",
            J.jObject [
              ("textDocument", J.jObject [("uri", J.jString "file:///w/a.idl")]),
              ("contentChanges", J.jArray [J.jObject [("text", J.jString "two")]])
            ]
          )
        ],
        request 1 "test/seen" (about "file:///w/a.idl")
      ]
      located
  in assertEq
       (M.andThen resultOf (V.last said))
       (Just (J.jString "1 at /w/a.idl, 1 is one, 1 is two"))
       "where, once, when it is opened; its text then, and at each edit"
