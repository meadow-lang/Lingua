-- `repl!`: a prompt, from what a Lingua compiler already has.
--
--   repl! {
--     pub Repl "miniml" for Session
--     | text = setSessionSource
--     | eval = shownOf
--     | tree = treeOf
--     | errors = errorsOf
--     | completion = completionAt
--     | declarations = declarationsOf
--     | indent = indentStyle
--     | prompt = "> "
--     | history = ".miniml_history"
--   }
--
-- A prompt keeps its compiler's database -- `for Session` makes it with
-- `newSession` -- and what is being typed is a file of it: each feature is a
-- function of the database and that file, as a language server's are
-- (`lsp!`), and several are the server's own:
--
--   text          db -> Int -> String -> ()        set the file's text
--   eval          db -> Int -> String              what entering it prints
--   tree          db -> Int -> Green k             its lossless tree: how it
--                                                  is coloured as it is typed,
--                                                  unless the database has a
--                                                  server -- see below
--   errors        db -> Int -> [Int]               where the parser's errors
--                                                  are: an entry whose only
--                                                  ones are at its end is not
--                                                  finished, and Enter goes on
--                                                  to a new line of it
--   completion    db -> Int -> Int -> [(String, String)]     Tab
--   declarations  db -> Int -> [(String, String, String)]    Ctrl-F: each a
--                                                  name, what it is, and what
--                                                  is said of it
--   search        db -> Int -> String -> [Hit]     Ctrl-F, answered by the
--                                                  language: what a query
--                                                  finds, the likeliest first
--   panes         [(String, db -> Int -> String -> Int -> Opened e)]
--                                                  the language's own panes,
--                                                  each opened by a key
--                                                  (`ctrl-x`) or a command
--                                                  (`:name`) -- see below
--   indent        Green k -> String                what the line after an
--                                                  unfinished entry opens
--                                                  with: a formatter's
--                                                  (`format!`) `indent<Name>`
--   commands      [(String, String, String, db -> String -> Reply)]
--                                                  the language's own lines
--                                                  that start with `:` -- see
--                                                  below
--   prompt        what a line starts with; `history`, the file entries are
--                 kept in between runs; `theme`, the one it starts in
--
-- **Colour.** A database that has a language server (`lsp!`, declared before
-- the prompt) is coloured by it: what is typed is given to the server's
-- `tokens<Server>` -- each token's place and class, which is what it answers
-- an editor's semantic tokens with -- and shown in those classes' colours.
-- So a file and an entry are coloured by one answer. With no server, the
-- prompt asks the tree the same question itself.
--
-- **Themes.** How each class is shown is a theme, and a prompt has several
-- built in -- `soft`, which it starts in unless it says otherwise, `bright`,
-- `quiet`, `editor`, `warm` and `plain`. A line
-- that starts with `:` is for the prompt and not the language: `:theme`
-- lists them, each with a line in its colours and the one that is on
-- marked, and `:theme quiet` turns one on, for what is typed from then on.
--
-- **Panes.** A pane is shown under the line until it is done with -- the
-- finder is one -- and is a state, what a key does to it and how it is
-- drawn (`pane`). A key `Go`es on to another state, `Put`s text on the line
-- (with an entry to run before it), `Enter`s text, or `Close`s it. A
-- language gives its own with `panes`, each opened by a key or a command.
--
-- **Commands.** `:help` says what such lines there are, and `:quit` ends the
-- prompt. A language adds its own with `commands`: each a name, what is
-- written after it, what help says of it, and what it does -- a function of
-- the database and the rest of the line, answering a `Reply`: something
-- `Said`, an `Entry` to be entered as if it had been typed, or `Leave`, which
-- ends the prompt. Where the language names a command as the prompt names
-- one of its own, the language's is the one that is run. Tab completes a
-- command's name.
--
-- Only `text` and `eval` are needed. What is written is `runRepl ()`: entries
-- read, each printed as `eval` says, until there are no more.
--
-- **The line** is `LineEditor`'s: the cursor moved about in what is typed,
-- entries of several lines, the ones before brought back. **Ctrl-F** opens
-- the finder under it: what is typed there narrows the declarations to those
-- it is found in (`Fuzzy`), the likeliest first, with what is known of the
-- one chosen beside them, and Enter puts its name where the cursor was. It
-- is drawn with `Doodle`.
--
-- Where the input is not a terminal -- a file, a pipe -- entries are read a
-- line at a time, as many lines as each takes to be finished, and nothing is
-- drawn: a prompt run by a script prints what it would have.

use Std.Collections.Vector as V
use Std.String as S
use Std.Char as C
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Console (Console, writeOutput)
use Std.Terminal as T
use Std.Terminal (Key, Event)
use Std.Terminal.Code.*
use Lingua.Green (Green)
use Lingua.Green as G
use Lingua.Lsp (classified, serverOf, tokenTypes, classOf)
use LineEditor as LE
use LineEditor (Editor, Outcome, Bound)
use Doodle as D
use Doodle (Buffer, Size, Rect)
use Fuzzy as F

-- --- what the line asks of the text ------------------------------------------

-- Whether `text` is an entry not finished: the parser found something wrong
-- with it, and only at its end -- what is there is right as far as it goes.
@pub fun unfinished (text : String) (errors : [Int]) : Bool =
  let last = stringByteLength (S.trimEnd text) in
  not (V.isEmpty errors) and V.all (\at -> at >= last) errors

-- The tree's text, its tokens coloured by what they are: as an editor
-- colours them, the classes being the server's (`Lingua.Lsp`).
@pub fun coloured (theme : Theme) (name : k -> String) (g : Green k) : String =
  painted theme (G.text g) (classified name g)

-- `text` with each of `classes` -- the bytes a token is from and to, and its
-- class -- as `theme` shows that class: what a language server answers for a
-- file's tokens, shown at a prompt. A line at a time, so that a token over
-- several lines does not colour what starts the next.
@pub fun painted (theme : Theme) (text : String) (classes : [(Int, Int, Int)]) : String =
  let step =
    \acc x ->
      match (acc, x) with
      | ((out, at), (from, to, class)) ->
          if from < at then (out, at)
          else
            let piece = stringSlice text from to in
            let shown =
              (match shownAs theme class with
               | None -> piece
               | Just on ->
                   S.join
                     "\n"
                     (V.map
                        (\l -> if S.isEmpty l then l else on ++ l ++ "\u{1b}[0m")
                        (S.split "\n" piece)))
            in (out ++ stringSlice text at from ++ shown, to)
  in match V.foldl step ("", 0) classes with
     | (out, at) -> out ++ stringSlice text at (stringByteLength text)

-- --- themes ------------------------------------------------------------------
--
-- How each class of token is shown: a theme is its name and, for each class
-- it shows in some way, what turns that way on -- a colour of the
-- terminal's own sixteen, bold, dim -- and a class it does not mention is
-- shown as it is. `:theme` at a prompt says which there are and which is
-- on; `:theme quiet` turns one on.

@pub data Theme = Theme String [(String, String)]

@pub fun themeName (t : Theme) : String = match t with | Theme n _ -> n

-- What turns on how `theme` shows class `class` of `tokenTypes`, if it shows
-- it in any way.
fun shownAs (theme : Theme) (class : Int) : Maybe String =
  match theme with
  | Theme _ ways ->
      M.map (\w -> "\u{1b}[${snd w}m") (V.find (\w -> fst w == V.getOr "" tokenTypes class) ways)

-- The themes a prompt has. The first is the one it starts with: soft shades,
-- which read alike whatever the terminal's own colours are.
@pub def themes : [Theme] =
  [
    -- Soft shades of the terminal's 256, the same whatever its own colours.
    Theme "soft" [
      ("keyword", "1;38;5;183"),
      ("function", "38;5;117"),
      ("type", "38;5;116"),
      ("enumMember", "38;5;216"),
      ("namespace", "38;5;245"),
      ("number", "38;5;215"),
      ("string", "38;5;150"),
      ("comment", "3;38;5;245")
    ],
    -- A colour for everything name resolution tells apart.
    Theme "bright" [
      ("keyword", "1;35"),
      ("function", "93"),
      ("variable", "94"),
      ("type", "36"),
      ("enumMember", "34"),
      ("namespace", "2;36"),
      ("number", "33"),
      ("string", "32"),
      ("comment", "2")
    ],
    -- Few colours: a function, a type and what is written out stand out,
    -- and a keyword is bold. As readable on a light ground as a dark one.
    Theme "quiet" [
      ("keyword", "1"),
      ("function", "34"),
      ("type", "36"),
      ("enumMember", "36"),
      ("namespace", "2"),
      ("number", "35"),
      ("string", "32"),
      ("comment", "2")
    ],
    -- As an editor's dark theme has them: functions blue, types yellow.
    Theme "editor" [
      ("keyword", "1;35"),
      ("function", "94"),
      ("type", "33"),
      ("enumMember", "92"),
      ("namespace", "2;36"),
      ("number", "91"),
      ("string", "32"),
      ("comment", "2;3")
    ],
    -- Warm: red keywords, yellow functions, and numbers apart from both.
    Theme "warm" [
      ("keyword", "1;31"),
      ("function", "93"),
      ("type", "92"),
      ("enumMember", "33"),
      ("namespace", "2;33"),
      ("number", "36"),
      ("string", "32"),
      ("comment", "2")
    ],
    -- Nothing coloured.
    Theme "plain" []
  ]

@pub fun themeNamed (name : String) : Maybe Theme = V.find (\t -> themeName t == name) themes

-- The theme a prompt starts with: the one named, or the first.
@pub fun themeOr (name : String) : Theme =
  M.unwrapOr (V.getOr (Theme "plain" []) themes 0) (themeNamed name)

-- A line showing a theme: its name, and a word of each class as it shows it.
fun sample (theme : Theme) : String =
  let word =
    \class text ->
      match shownAs theme (classOf class) with
      | Just on -> on ++ text ++ "\u{1b}[0m"
      | None -> text
  in S.join "" [
       word "keyword" "let", " ", word "function" "area", " ", word "variable" "r", " : ",
       word "type" "Float", " = ", word "namespace" "Math", ".", word "enumMember" "Pi", " * ",
       word "variable" "r", " * ", word "number" "2", " ", word "string" "\"cm\"", " ",
       word "comment" "-- area"
     ]

-- What a line that starts with `:` does: `:theme` says which themes there
-- are, the one that is on marked; `:theme name` turns one on. What it says,
-- and the theme that is on after it.
@pub fun command (line : String) (on : Theme) (has : [String]) : (String, Theme) =
  let words = V.filter (\w -> not (S.isEmpty w)) (S.split " " (S.trim line)) in
  let listed =
    S.join
      "\n"
      (V.map
         (\t ->
           "${if themeName t == themeName on then "*" else " "} ${themeName t}${S.repeat " " (8 - S.charLength (themeName t))}${sample t}")
         themes)
  in match (V.getOr "" words 0, V.get words 1) with
     | (":theme", None) -> (listed, on)
     | (":theme", Just name) ->
         (match themeNamed name with
          | Just t -> ("${sample t}", t)
          | None -> ("no theme is called `${name}`:\n${listed}", on))
     | (other, _) ->
         (
           "`${other}` is not something this prompt does: it has ${S.join ", " (V.map (\n -> "`:${n}`") has)}",
           on
         )

-- --- commands ----------------------------------------------------------------
--
-- A line that starts with `:` is a command: the prompt's own -- `:help`,
-- `:quit`, `:theme` -- or one the language gave it. A language's command is
-- its name, what is written after it, what help says of it, and what it
-- does, given the database and the rest of the line.

-- What a command answers: something said; an entry, entered as if it had
-- been typed; or something said, and the prompt ended.
@derive(Debug, PartialEq)
@pub data Reply = Said String | Entry String | Leave String

-- The commands every prompt has: each its name, what is written after it,
-- and what help says of it.
@pub def ownCommands : [(String, String, String)] =
  [
    ("help", "", "what this prompt does"),
    ("quit", "", "end the prompt"),
    ("theme", "[NAME]", "the themes there are, or the one named turned on")
  ]

-- A command line's name, without its colon, and the rest of it.
@pub fun commandOf (line : String) : (String, String) =
  let t = S.trim line in
  let word = V.getOr "" (S.split " " t) 0 in
  (
    stringSlice word 1 (stringByteLength word),
    S.trim (stringSlice t (stringByteLength word) (stringByteLength t))
  )

-- Every command a prompt with `commands` has, by name: the language's, then
-- the prompt's own that the language did not give one of the same name.
@pub fun commandNames commands : [String] =
  let given = V.map (\c -> match c with | (n, _, _, _) -> n) commands in
  V.append
    given
    (V.filter
       (\n -> not (V.elem n given))
       (V.map (\c -> match c with | (n, _, _) -> n) ownCommands))

-- What `:help` says: each command, what is written after it, and what it is
-- for -- the language's first.
@pub fun helped commands : String =
  let given = V.map (\c -> match c with | (n, a, about, _) -> (n, a, about)) commands in
  let names = V.map (\c -> match c with | (n, _, _) -> n) given in
  let rows =
    V.append given (V.filter (\o -> match o with | (n, _, _) -> not (V.elem n names)) ownCommands)
  in
  let head =
    \r ->
      match r with
      | (n, a, _) -> if S.isEmpty a then ":${n}" else ":${n} ${a}"
  in
  let wide = V.foldl (\w r -> max w (S.charLength (head r))) 0 rows in
  S.join
    "\n"
    (V.map
       (\r ->
         match r with
         | (_, _, about) -> "${head r}${S.repeat " " (wide + 2 - S.charLength (head r))}${about}")
       rows)

-- What Tab offers in a command line: the commands that start as the name
-- after the colon does, while the cursor is in it, and nothing after it.
@pub fun commandCandidates (text : String) (at : Int) (names : [String]) : (Int, [String]) =
  let from = nameStart text at in
  if S.trim (S.fromChars (V.take (S.chars text) from)) == ":" then
    candidates text at (V.map (\n -> (n, "")) names)
  else (at, [])

fun isNameChar (c : Char) : Bool = C.isAlphaNum c or C.code c == 95 or C.code c == 39

-- Where the name the cursor is at the end of starts: both count characters.
@pub fun nameStart (text : String) (at : Int) : Int =
  let cs = S.chars text in
  let rec back i =
    if i > 0 and isNameChar (V.getOr (C.fromCode 32) cs (i - 1)) then back (i - 1) else i
  in back at

-- The byte character `at` of `text` starts at: what a compiler's features
-- count in.
@pub fun byteAt (text : String) (at : Int) : Int =
  stringByteLength (S.fromChars (V.take (S.chars text) at))

-- What Tab offers: of everything that could be written at the cursor, what
-- starts as the name before it does -- and where that name starts.
@pub fun candidates (text : String) (at : Int) (all : [(String, String)]) : (Int, [String]) =
  let from = nameStart text at in
  let typed = S.fromChars (V.drop (V.take (S.chars text) at) from) in
  (from, V.filter (\n -> S.startsWith typed n and n != typed) (V.map fst all))

-- --- the finder --------------------------------------------------------------

-- What the finder finds: a name; what it is -- its type, its kind; where it
-- is from; what is said of it; the text choosing it puts on the line; and an
-- entry to run before the line it is chosen for, or nothing -- a `use` that
-- brings the name into scope.
@derive(Debug, PartialEq)
@pub data Hit = Hit String String String String String String

@pub fun hitName (h : Hit) : String = match h with | Hit n _ _ _ _ _ -> n

@pub fun hitInsert (h : Hit) : String = match h with | Hit _ _ _ _ i _ -> i

@pub fun hitBefore (h : Hit) : String = match h with | Hit _ _ _ _ _ b -> b

-- `xs` as a query ranks them: what the query's letters are found in, the
-- likeliest first, by the text `textOf` gives each -- and all of them, as
-- they came, for a query of nothing. Fuzzy's ranking, for a language's
-- `search` to use for names.
@pub fun ranked (query : String) (textOf : a -> String) (xs : [a]) : [a] =
  if S.isEmpty (S.trim query) then xs else V.map fst (F.rank query textOf xs)

-- What a query finds among declarations, each a name, what it is and what is
-- said of it: what a finder with no `search` shows.
@pub fun declared (query : String) (decls : [(String, String, String)]) : [Hit] =
  V.map
    (\d -> match d with | (n, what, said) -> Hit n what "" said n "")
    (ranked query (\d -> match d with | (n, what, _) -> n ++ " " ++ what) decls)

-- A finder: what has been typed in it, which of what that finds is chosen,
-- and what a query finds.
@pub data Finder e = Finder String Int (String -> [Hit] ! e)

@pub fun finder (decls : [(String, String, String)]) : Finder e =
  Finder "" 0 (\q -> declared q decls)

-- A finder whose queries `look` answers.
@pub fun finderOf (look : String -> [Hit] ! e) : Finder e = Finder "" 0 look

-- What a key did: the finder goes on; something was chosen; or it was put
-- away.
@derive(Debug, PartialEq)
@pub data Found = Looking | Chose Hit | PutAway

use Found.*

-- What the finder shows: what its query finds.
@pub fun shownIn (f : Finder e) : [Hit] ! e = match f with | Finder query _ look -> look query

@pub fun findKey (f : Finder e) (key : Key) : (Finder e, Found) ! e =
  match f with
  | Finder query at look ->
      let count = V.len (shownIn f) in
      let to = \i -> (Finder query (max 0 (min (count - 1) i)) look, Looking) in
      match key.code with
      | Escape -> (f, PutAway)
      | Enter ->
          (match V.get (shownIn f) at with
           | Just h -> (f, Chose h)
           | None -> (f, PutAway))
      | Up -> to (at - 1)
      | Down -> to (at + 1)
      | Backspace ->
          (Finder (S.fromChars (V.take (S.chars query) (S.charLength query - 1))) 0 look, Looking)
      | Character c ->
          if key.ctrl then
            (if c == "c" or c == "g" or c == "f" then (f, PutAway)
             else if c == "p" then to (at - 1)
             else if c == "n" then to (at + 1)
             else (f, Looking))
          else (Finder (query ++ c) 0 look, Looking)
      | _ -> (f, Looking)

-- The finder, drawn `cols` wide: the query, what it finds with the chosen
-- one marked, and beside them what the chosen one is, where it is from, what
-- is said of it, and what choosing it will do.
@pub fun findDrawn (f : Finder e) (cols : Int) : Buffer ! e =
  match f with
  | Finder query at _ ->
      let found = shownIn f in
      let b0 = D.blank (max 20 (min cols 100)) 12 in
      let b1 = D.border b0 (D.area b0) (D.dimmed D.style) "find" in
      let inner = D.inside (D.area b0) in
      let parts = D.rows inner [Size.Cells 1, Size.Share] in
      let top = V.getOr inner parts 0 in
      let rest = V.getOr inner parts 1 in
      let sides = D.columns rest [Size.Percent 40, Size.Cells 1, Size.Share] in
      let names = V.getOr rest sides 0 in
      let about = V.getOr rest sides 2 in
      let b2 = D.writeSpans b1 top 0 0 [("> ", D.dimmed D.style), (query, D.style)] in
      let b3 = D.list b2 names (V.map (\h -> (hitName h, D.style)) found) at (D.invert D.style) in
      match V.get found at with
      | None -> D.writeIn b3 about 0 0 (D.dimmed D.style) "nothing found"
      | Just (Hit n what from said insert before) ->
          let b4 = D.writeIn b3 about 0 0 (D.bold D.style) n in
          let b5 = D.paragraph b4 (D.rect about.x (about.y + 1) about.w 2) D.style what in
          let b6 = if S.isEmpty from then b5 else D.writeIn b5 about 0 3 (D.dimmed D.style) from in
          let b7 =
            D.paragraph
              b6
              (D.rect about.x (about.y + 4) about.w (about.h - 5))
              (D.dimmed D.style)
              said
          in
          let doing =
            if not (S.isEmpty before) then "first runs: ${before}"
            else if insert != n then "puts: ${insert}"
            else ""
          in if S.isEmpty doing then b7
             else D.writeIn b7 about 0 (about.h - 1) (D.dimmed D.style) doing

-- The finder shown under the cursor's line until something is chosen or it
-- is put away, and then gone: the name, if one was.
@pub fun find (decls : [(String, String, String)]) : Maybe String ! { Console | e } =
  M.map hitName (finding (finder decls))

-- The same, of any finder: what was chosen, if anything was.
@pub fun findWith f = finding f

fun finding f =
  let cols = fst (T.size ()) in
  let u = writeOutput (D.below (findDrawn f (if cols > 0 then cols else 80))) in
  match T.nextEvent () with
  | Event.Closed -> (let w = writeOutput D.eraseBelow in None)
  | Event.Pressed key ->
      (match findKey f key with
       | (f2, Looking) -> finding f2
       | (_, Chose h) -> (let w = writeOutput D.eraseBelow in Just h)
       | (_, PutAway) -> (let w = writeOutput D.eraseBelow in None))
  | _ -> finding f

-- --- panes -------------------------------------------------------------------
--
-- A pane is shown under the line until it is done with: the finder is one,
-- and a language may give others -- a view of what a definition compiles to,
-- what a proof search found, a page of documentation. It is a state, what a
-- key does to it, and how it is drawn; what it ends with is put on the line,
-- entered, or nothing.

-- What a key does to a pane: it goes on, in another state; it puts text on
-- the line, the cursor at a character of it, with an entry to run before
-- the line or nothing; it enters text; or it closes.
@pub data Step a
  = Go a
  | Put String Int String
  | Enter String
  | Close

-- A pane, opened: what a key does to it, and how it is drawn, `cols` wide.
-- Its state is in the two functions, so panes of any state are one type.
@pub data Opened e
  = Opened (Key -> Step (Opened e) ! e) (Int -> Buffer ! e)

-- A pane in state `s`, opened: `key` is what a key does to a state, and
-- `draw` how one is drawn.
@pub fun opened key draw s = Opened (\k -> stepped key draw (key s k)) (\cols -> draw s cols)

fun stepped key draw step =
  match step with
  | Step.Go s2 -> Step.Go (opened key draw s2)
  | Step.Put t at before -> Step.Put t at before
  | Step.Enter t -> Step.Enter t
  | Step.Close -> Step.Close

-- A pane as a language gives it: `open` makes its state from the database,
-- the entry, the entry's text and the cursor; `key` and `draw` as above.
@pub fun pane open key draw = \db file text at -> opened key draw (open db file text at)

@pub fun keyOf (o : Opened e) (k : Key) : Step (Opened e) ! e = match o with | Opened f _ -> f k

@pub fun drawOf (o : Opened e) (cols : Int) : Buffer ! e = match o with | Opened _ d -> d cols

-- A pane shown under the cursor's line until it puts, enters or closes, and
-- then gone: what it came to.
@pub fun showing o =
  let cols = fst (T.size ()) in
  let u = writeOutput (D.below (drawOf o (if cols > 0 then cols else 80))) in
  match T.nextEvent () with
  | Event.Closed -> (let w = writeOutput D.eraseBelow in Step.Close)
  | Event.Pressed key ->
      (match keyOf o key with
       | Step.Go o2 -> showing o2
       | other -> (let w = writeOutput D.eraseBelow in other))
  | _ -> showing o

-- The finder, as a pane over the line `text` with the cursor at character
-- `at`: what it chooses is put in place of the name before the cursor.
@pub fun finderPane look (text : String) (at : Int) =
  opened finderKey finderDraw (finderOf (\q -> look text q), text, at)

fun finderKey st k =
  match st with
  | (f, text, at) ->
      (match findKey f k with
       | (f2, Looking) -> Step.Go (f2, text, at)
       | (_, Chose h) ->
           (match replacedName text at (hitInsert h) with
            | (t2, c2) -> Step.Put t2 c2 (hitBefore h))
       | (_, PutAway) -> Step.Close)

fun finderDraw st cols = match st with | (f, _, _) -> findDrawn f cols

-- `text` with the name before character `at` replaced by `n`: the text, and
-- where the cursor goes, after `n`.
fun replacedName (text : String) (at : Int) (n : String) : (String, Int) =
  let cs = S.chars text in
  let from = nameStart text at in
  (S.fromChars (V.concat [V.take cs from, S.chars n, V.drop cs at]), from + S.charLength n)

-- The key a pane opens with, written `ctrl-x`: none, for an opening that is
-- a command.
@pub fun openingKey (opening : String) : Maybe Key =
  if S.startsWith "ctrl-" opening and S.charLength opening == 6 then
    Just (T.ctrl (S.drop opening 5))
  else None

-- --- the prompt --------------------------------------------------------------

-- The line's editor, of what the compiler says of a text: its tree, where
-- the parser's errors are, what a kind is called, what the next line opens
-- with, what could be written at a byte of it, what a query of the finder
-- finds in it -- nothing, for a prompt with no finder -- and the names of
-- its commands, and the panes a key opens. `pending` is where what a pane
-- brings is kept until the line is entered: the entries to run before it,
-- and the text to enter in its place, if a pane entered one.
@pub fun editorOf
    theme
    pending
    (prompt : String)
    paint
    treeOf
    errorsOf
    name
    indentOf
    completionsOf
    lookOf
    (commands : [String])
    panes =
  let bindings = paneBindings pending lookOf panes in
  {
    LE.editor | prompt,
    continued = S.repeat " " (S.charLength prompt),
    -- A line for the prompt itself -- `:theme` -- is not the language's
    -- to colour, or to call unfinished.
    highlight =
      \t ->
        if isCommand t then t
        else
          match paint with
          | Just shown -> shown (getRef theme) t
          | None -> coloured (getRef theme) name (treeOf t),
    finished = \t -> isCommand t or not (unfinished t (errorsOf t)),
    indent = \t -> indentOf (treeOf t),
    complete =
      \t at ->
        if isCommand t then commandCandidates t at commands
        else candidates t at (completionsOf t (byteAt t at)),
    bindings
  }

-- What each pane a key opens is bound to: shown, and what it ends with made
-- of the line. The finder is Ctrl-F, unless a pane of the language's is.
fun paneBindings pending lookOf panes =
  let act =
    \make text at ->
      match showing (make text at) with
      | Step.Put t c before ->
          (let u = if S.isEmpty before then () else broughtFirst pending before in Bound.Edited t c)
      | Step.Enter t ->
          (let u =
             (match getRef pending with
              | (first, _) -> setRef pending (first, Just t))
           in Bound.Entering)
      | _ -> Bound.Kept
  in
  let keyed =
    V.concatMap
      (\p ->
        match openingKey (fst p) with
        | Just k -> [(k, \text at -> act (snd p) text at)]
        | None -> [])
      panes
  in if V.any (\b -> fst b == T.ctrl "f") keyed then keyed
     else V.pushBack keyed (T.ctrl "f", \text at -> act (finderPane lookOf) text at)

fun broughtFirst pending (entry : String) =
  match getRef pending with
  | (first, instead) -> setRef pending (V.pushBack first entry, instead)

-- Entries read with `editor` and each printed as `eval` says, until there
-- are no more: kept in the file `history`, when it names one.
-- `editorOn` is the editor, given the cell the theme that is on is kept in
-- -- a line that starts with `:` is a command, and may change it -- and the
-- one the entries the finder's choices bring with them wait in. `commands`
-- are the language's own, each given `db` and the rest of its line.
-- `panes` are the language's; those a command opens are opened here.
@pub fun run editorOn (theme : String) (history : String) eval db commands panes =
  let on = newRef (themeOr theme) in
  let pending = newRef ([], None) in
  entering
    (editorOn on pending)
    on
    pending
    history
    eval
    db
    commands
    panes
    (if S.isEmpty history then [] else LE.loadHistory history)

-- Whether a line is for the prompt itself, not the language.
@pub fun isCommand (text : String) : Bool = S.startsWith ":" (S.trimStart text)

-- An entry evaluated: kept in the history's file, and what `eval` says of
-- it written.
fun entered (history : String) eval (text : String) =
  let u = if S.isEmpty history then () else LE.saveEntry history text in
  writeOutput (eval text ++ "\n")

fun entering editor on pending (history : String) eval db commands panes (before : [String]) =
  match LE.readEntry editor before with
  | Outcome.Ended -> ()
  | Outcome.Interrupted -> entering editor on pending history eval db commands panes before
  | Outcome.Entered typed ->
      -- A pane that entered text entered it in place of the line.
      let text =
        (match getRef pending with
         | (first, Just t) -> (let u = setRef pending (first, None) in t)
         | _ -> typed)
      in if S.isEmpty (S.trim text) then
           entering editor on pending history eval db commands panes before
         else if isCommand text then
           let again = V.pushBack before text in
           let say = \said -> if S.isEmpty said then () else writeOutput (said ++ "\n") in
           (match commandOf text with
            | (name, rest) ->
                match V.find (\p -> fst p == ":${name}") panes with
                | Just (_, make) ->
                    (match showing (make rest (S.charLength rest)) with
                     | Step.Put t _ first ->
                         (let u = if S.isEmpty first then () else entered history eval first in
                          let w = entered history eval t in
                          entering editor on pending history eval db commands panes again)
                     | Step.Enter t ->
                         (let w = entered history eval t in
                          entering editor on pending history eval db commands panes again)
                     | _ -> entering editor on pending history eval db commands panes again)
                | None ->
                    match V.find (\c -> match c with | (n, _, _, _) -> n == name) commands with
                    | Just (_, _, _, act) ->
                        (match act db rest with
                         | Reply.Said said ->
                             (let w = say said in
                              entering editor on pending history eval db commands panes again)
                         | Reply.Entry entry ->
                             (let w = entered history eval entry in
                              entering editor on pending history eval db commands panes again)
                         | Reply.Leave said -> say said)
                    | None ->
                        if name == "quit" then ()
                        else if name == "help" then
                          (let w = say (helped commands) in
                           entering editor on pending history eval db commands panes again)
                        else
                          (match command text (getRef on) (commandNames commands) with
                           | (said, now) ->
                               let u = setRef on now in
                               let w = say said in
                               entering editor on pending history eval db commands panes again))
         else
           -- What the finder's choices on this line bring with them -- a `use`
           -- for a name not in scope -- is run first.
           let first = (match getRef pending with | (f, _) -> f) in
           let u = setRef pending ([], None) in
           let r = V.foldl (\acc b -> entered history eval b) () first in
           let w = entered history eval text in
           entering editor on pending history eval db commands panes (V.pushBack before text)

-- --- repl! -------------------------------------------------------------------

use Std.Macro (TokenTree, Loc, isPunct, lookupAs)
use Std.Macro.TokenTree.*
use Std.Macro.Loc.*
use Std.Macro.Parse (Tokens, parseTokens, ident, keyword, punct, stringLit)
use Std.String.Parse as P
use Std.String.Parse (Parser)
use Std.String.Parse (keep, skip)
use Lingua.Pipe (named)
use Std.Macro (Expand)
use Std.Result.Result.*

-- `| eval = shownOf` or `| prompt = "> "`: a feature, where it was written,
-- and what it is -- and whether that was written in quotes.
def replFeature : Parser Tokens ((String, Loc), (String, Bool)) =
  P.pure (\k v -> (k, v))
    |> skip (punct "|")
    |> keep named
    |> skip (punct "=")
    |> keep (P.alt (P.map (\s -> (s, True)) stringLit) (P.map (\w -> (w, False)) ident))

-- A feature as it is read: its name, where that was written, what it is,
-- and whether that was in quotes.
type ReplFeature = ((String, Loc), (String, Bool))

def replCall : Parser Tokens (Bool, String, String, String, [ReplFeature]) =
  P.pure (\pub name lang db fs -> (M.isSome pub, name, lang, db, fs))
    |> keep (P.optional (keyword "pub"))
    |> keep ident
    |> keep stringLit
    |> skip (keyword "for")
    |> keep ident
    |> keep (P.some replFeature)

def replFeatures : [String] =
  [
    "text", "eval", "tree", "errors", "completion", "declarations", "search", "panes", "indent",
    "commands", "prompt", "history", "theme"
  ]

def replWritten : [String] = ["prompt", "history", "theme"]

@macro
@pub fun repl (ts : [TokenTree]) : [TokenTree] ! { Expand | e } =
  match parseTokens replCall ts with
  | Err failed -> failed
  | Ok (pub, name, lang, db, fs) ->
      match V.find (\f -> not (V.elem (fst (fst f)) replFeatures)) fs with
      | Just f ->
          [Fail
             "a prompt has no `${fst (fst f)}`: it has ${S.join ", " (V.map (\x -> "`${x}`") replFeatures)}"
             (snd (fst f))]
      | None ->
          match V.find (\f -> V.elem (fst (fst f)) replWritten != snd (snd f)) fs with
          | Just f ->
              [Fail
                 (if snd (snd f) then "`${fst (fst f)}` is a function's name, not text in quotes"
                  else "`${fst (fst f)}` is text, in quotes")
                 (snd (fst f))]
          | None ->
              match V.find (\k -> not (V.any (\f -> fst (fst f) == k) fs)) ["text", "eval"] with
              | Just k ->
                  [Fail
                     "a prompt needs `${k}`: ${if k == "text" then "how what is typed is given to the compiler" else "what entering it prints"}"
                     Nowhere]
              | None ->
                  -- The database's language server, if one is declared: a
                  -- prompt colours what is typed as it colours a file.
                  let server =
                    (match lookupAs (serverOf db) with
                     | Ok s -> Just s
                     | Err _ -> None)
                  in [Code (replCode (if pub then "@pub " else "") name lang db server fs)]

fun replCode pub name lang db (server : Maybe String) fs =
  let given = \k -> M.map (\f -> fst (snd f)) (V.find (\f -> fst (fst f) == k) fs) in
  let fn = \k -> M.unwrapOr "" (given k) in
  let setting = \t -> "(let _ = ${fn "text"} db 0 ${t} in " in
  -- With no tree there is nothing to colour, indent or call unfinished.
  let tree =
    (match given "tree" with
     | Just f -> "(Just (\\t -> ${setting "t"}${f} db 0)))"
     | None -> "None")
  in
  -- What is typed, coloured: by the server's tokens when the database has a
  -- server, and otherwise -- by the editor it is given -- from the tree.
  let paint =
    (match server with
     | Just s -> "(Just (\\th t -> LinguaRepl.painted th t (${setting "t"}tokens${s} db 0))))"
     | None -> "None")
  in
  let errors =
    (match given "errors" with
     | Just f -> "(\\t -> ${setting "t"}${f} db 0))"
     | None -> "(\\t -> [])")
  in
  let indent =
    (match given "indent" with
     | Just f -> "(\\g -> ${f} g)"
     | None -> "(\\g -> \"\")")
  in
  let completion =
    (match given "completion" with
     | Just f -> "(\\t at -> ${setting "t"}${f} db 0 at))"
     | None -> "(\\t at -> [])")
  in
  -- What the finder shows: what the language's `search` finds, or else its
  -- declarations ranked by the letters of the query.
  let decls =
    (match (given "search", given "declarations") with
     | (Just f, _) -> "(\\t q -> ${setting "t"}${f} db 0 q))"
     | (None, Just f) -> "(\\t q -> LinguaRepl.declared q (${setting "t"}${f} db 0)))"
     | (None, None) -> "(\\t q -> [])")
  in
  let commands = M.unwrapOr "[]" (given "commands") in
  -- The language's panes, each given the database and the entry.
  let panes =
    (match given "panes" with
     | Just f ->
         "(LinguaV.map (\\lingua_p -> match lingua_p with | (lingua_o, lingua_mk) -> (lingua_o, \\t at -> ${setting "t"}lingua_mk db 0 t at))) ${f})"
     | None -> "[]")
  in "use Lingua.Repl as LinguaRepl
use Std.Collections.Vector as LinguaV

-- ${lang}'s prompt: entries read and evaluated until there are no more.
${pub}fun run${name} () =
  let db = new${db} () in
  LinguaRepl.run
    (\\theme pending -> LinguaRepl.editorFor theme pending ${quoted (M.unwrapOr "> " (given "prompt"))} ${paint} ${tree} ${errors} (\\k -> display k) ${indent} ${completion} ${decls} (LinguaRepl.commandNames ${commands}) ${panes})
    ${quoted (fn "theme")}
    ${quoted (fn "history")}
    (\\t -> ${setting "t"}${fn "eval"} db 0))
    db
    ${commands}
    ${panes}
"

fun quoted (s : String) : String =
  "\""
    ++ S.join
      ""
      (V.map
         (\i ->
           let c = stringSlice s i (i + 1) in
           if c == "\"" then "\\\""
           else if c == "\\" then "\\\\"
           else if c == "$" then "\\$"
           else c)
         (V.range 0 (stringByteLength s)))
    ++ "\""

-- The editor a prompt is given: `editorOf`, or -- with no tree to ask -- one
-- that colours nothing and takes every entry as finished.
@pub fun editorFor
    theme
    pending
    (prompt : String)
    paint
    treeOf
    errorsOf
    name
    indentOf
    completionsOf
    lookOf
    (commands : [String])
    panes =
  match treeOf with
  | Just tree ->
      editorOf
        theme
        pending
        prompt
        paint
        tree
        errorsOf
        name
        indentOf
        completionsOf
        lookOf
        commands
        panes
  | None ->
      {
        LE.editor | prompt,
        continued = S.repeat " " (S.charLength prompt),
        highlight =
          \t ->
            match paint with
            | Just shown -> if isCommand t then t else shown (getRef theme) t
            | None -> t,
        complete = \t at -> if isCommand t then commandCandidates t at commands else (at, []),
        bindings = paneBindings pending lookOf panes
      }

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)
use Std.Console (withOutput)

@test fun anEntryIsUnfinishedWhenItsOnlyErrorsAreAtItsEnd () =
  let a = assertEq (unfinished "let x =" [7]) True "something is missing after it" in
  let b = assertEq (unfinished "let x =  \n" [7]) True "and space after it is not something" in
  let c = assertEq (unfinished "let = 1 in x" [4]) False "an error inside it is an error" in
  let d = assertEq (unfinished "let = 1 in" [4, 10]) False "even with one at the end too" in
  assertEq (unfinished "1 + 2" []) False "and none is finished"

@test fun tabOffersWhatStartsAsTheNameDoes () =
  let all =
    [("length", "function"), ("lines", "function"), ("let", "keyword"), ("map", "function")]
  in
  let a =
    assertEq (candidates "x + le" 6 all) (4, ["length", "let"]) "from where the name starts"
  in
  let b = assertEq (candidates "le" 2 all) (0, ["length", "let"]) "at the text's start" in
  let c = assertEq (candidates "let" 3 all) (0, []) "nothing for what is whole" in
  assertEq (byteAt "\u{e9}a" 1) 2 "and a compiler is told the byte, which is not the character"

def things : [(String, String, String)] =
  [
    ("length", "[a] -> Int", "How many there are."),
    ("lines", "String -> [String]", "Each line of a text."),
    ("map", "(a -> b) -> [a] -> [b]", "Each, through a function.")
  ]

fun keys (text : String) : [Key] = V.map (\c -> T.key (Character (C.toString c))) (S.chars text)

fun after (ks : [Key]) : (Finder e, Found) =
  V.foldl (\acc k -> findKey (fst acc) k) (finder things, Looking) ks

-- The name of what was chosen, if anything was.
fun chosen (f : Found) : Maybe String = match f with | Chose h -> Just (hitName h) | _ -> None

@test fun theFinderNarrowsAsItIsTypedIn () =
  let names = \f -> V.map hitName (shownIn f) in
  let a =
    assertEq (names (finder things)) ["length", "lines", "map"] "everything, with nothing typed"
  in
  let b =
    assertEq
      (names (fst (after (keys "li"))))
      ["lines", "length"]
      "what the letters are found in, the likeliest first: `li` starts one, and is an `l` and the `I` of `Int` in the other"
  in
  let c = assertEq (names (fst (after (keys "String")))) ["lines"] "by what it is, too" in
  let d = assertEq (names (fst (after (keys "lix")))) [] "nothing, when a letter is in none" in
  assertEq
    (names (fst (after (V.append (keys "lix") [T.key Backspace]))))
    ["lines", "length"]
    "and what there was, with the letter taken back"

@test fun theFinderChoosesOrIsPutAway () =
  let a =
    assertEq (chosen (snd (after [T.key Down, T.key Enter]))) (Just "lines") "the second, chosen"
  in
  let b =
    assertEq
      (chosen (snd (after [T.key Down, T.key Down, T.key Down, T.key Up, T.key Enter])))
      (Just "lines")
      "no further down than the last"
  in
  let c =
    assertEq
      (chosen (snd (after (V.append (keys "ma") [T.key Enter]))))
      (Just "map")
      "the one found"
  in
  let d = assertEq (snd (after [T.key Escape])) PutAway "Escape puts it away" in
  assertEq
    (snd (after (V.append (keys "zzz") [T.key Enter])))
    PutAway
    "and so does choosing nothing"

@test fun theFinderIsDrawnWithWhatIsChosenBesideIt () =
  let drawn = D.plain (findDrawn (fst (after [T.key Down])) 60) in
  let a =
    assertEq
      (V.getOr "" drawn 0)
      "╭─ find ───────────────────────────────────────────────────╮"
      "a border, titled"
  in
  let b = assertEq (S.startsWith "│> " (V.getOr "" drawn 1)) True "the query's line" in
  let c =
    assertEq
      (S.contains "lines" (V.getOr "" drawn 3)
         and S.contains "String -> [String]" (V.getOr "" drawn 3))
      True
      "the chosen name's row, and what it is beside the list"
  in assertEq (V.len drawn) 12 "twelve rows of it"

@test fun aNameIsFoundFromKeys () =
  let events = V.map (\k -> Event.Pressed k) (V.append (keys "ma") [T.key Enter]) in
  let got = withOutput (\() -> T.withEvents events (\() -> find things)) in
  assertEq (fst got) (Just "map") "what was chosen"

@test fun whatAServerClassifiesIsPaintedWhereItIs () =
  -- A keyword, a name and a number, and an operator, which has no colour.
  let bright = themeOr "bright" in
  let a =
    assertEq
      (painted bright "let x = 12" [
         (0, 3, classOf "keyword"),
         (4, 5, classOf "variable"),
         (8, 10, classOf "number")
       ])
      "\u{1b}[1;35mlet\u{1b}[0m \u{1b}[94mx\u{1b}[0m = \u{1b}[33m12\u{1b}[0m"
      "each token in its class's colour, and what is between them as it was"
  in assertEq
       (painted bright "a -- one\nb" [(2, 8, classOf "comment")])
       "a \u{1b}[2m-- one\u{1b}[0m\nb"
       "and nothing of a line's colour on the next"

@test fun aThemeSaysHowEachClassIsShown () =
  let classes = [(0, 3, classOf "keyword"), (4, 5, classOf "variable")] in
  let a =
    assertEq
      (painted (themeOr "quiet") "let x" classes)
      "\u{1b}[1mlet\u{1b}[0m x"
      "a keyword bold, and a name as it is"
  in
  let b = assertEq (painted (themeOr "plain") "let x" classes) "let x" "nothing coloured" in
  assertEq (themeName (themeOr "no such theme")) "soft" "and a theme nobody has is the first"

@test fun aLineForThePromptChoosesATheme () =
  let on = themeOr "bright" in
  let command = \line th -> command line th ["help", "quit", "theme"] in
  let a = assertEq (themeName (snd (command ":theme warm" on))) "warm" "the one named" in
  let b =
    assertEq
      (themeName (snd (command ":theme" on)))
      "bright"
      "asked which there are, the one that is on stays"
  in
  let listed = S.split "\n" (fst (command ":theme" on)) in
  let c =
    assertEq
      (
        V.len listed,
        S.startsWith "  soft" (V.getOr "" listed 0),
        S.startsWith "* bright" (V.getOr "" listed 1)
      )
      (6, True, True)
      "each on a line, the one that is on marked"
  in
  let d =
    assertEq
      (
        themeName (snd (command ":theme mauve" on)),
        S.startsWith "no theme is called `mauve`" (fst (command ":theme mauve" on))
      )
      ("bright", True)
      "one nobody has changes nothing, and is said"
  in assertEq
       (fst (command ":mauve" on))
       "`:mauve` is not something this prompt does: it has `:help`, `:quit`, `:theme`"
       "and what is not a command is said not to be, with what there is"

def spoken : [(String, String, String, () -> String -> Reply)] =
  [
    ("type", "EXPR", "what an expression is", \db rest -> Reply.Said "${rest} : Int"),
    ("quit", "", "leave, saying so", \db rest -> Reply.Leave "bye")
  ]

@test fun aCommandIsItsNameAndTheRestOfItsLine () =
  let a = assertEq (commandOf ":type  1 + 2 ") ("type", "1 + 2") "the name, and what is after it" in
  let b = assertEq (commandOf "  :help") ("help", "") "with nothing after it" in
  assertEq (commandOf ":") ("", "") "and a colon alone names nothing"

@test fun aPromptHasItsOwnCommandsAndTheLanguages () =
  let a =
    assertEq (commandNames (V.take spoken 0)) ["help", "quit", "theme"] "its own, with none given"
  in
  let b =
    assertEq
      (commandNames spoken)
      ["type", "quit", "help", "theme"]
      "the language's first, and its own `quit` in place of the prompt's"
  in assertEq
       (S.split "\n" (helped spoken))
       [
         ":type EXPR     what an expression is",
         ":quit          leave, saying so",
         ":help          what this prompt does",
         ":theme [NAME]  the themes there are, or the one named turned on"
       ]
       "and help says each, what is written after it, and what it is for"

@test fun tabCompletesACommandsName () =
  let names = commandNames spoken in
  let a =
    assertEq (commandCandidates ":t" 2 names) (1, ["type", "theme"]) "what starts as it does"
  in
  let b = assertEq (commandCandidates ":" 1 names) (1, names) "every one, after the colon alone" in
  assertEq (commandCandidates ":type qu" 8 names) (8, []) "and nothing after the name"

-- A language's own search: `map`'s type, from a library not in scope.
fun library (q : String) : [Hit] =
  if q == "(a -> b) -> [a] -> [b]" or S.isEmpty q then
    [Hit
       "map"
       "(a -> b) -> [a] -> [b]"
       "Std.List"
       "Each, through a function."
       "List.map"
       "use Std.List as List"]
  else []

@test fun aLanguagesSearchAnswersTheFinder () =
  let typed = \text -> V.map (\c -> T.key (Character (C.toString c))) (S.chars text) in
  let f =
    V.foldl (\acc k -> fst (findKey acc k)) (finderOf library) (typed "(a -> b) -> [a] -> [b]")
  in
  let a = assertEq (V.map hitName (shownIn f)) ["map"] "found by its type" in
  let drawn = D.plain (findDrawn f 80) in
  let b =
    assertEq
      (
        V.any (\l -> S.contains "Std.List" l) drawn,
        V.any (\l -> S.contains "first runs: use Std.List as List" l) drawn
      )
      (True, True)
      "where it is from, and that choosing it runs the `use` that brings it in"
  in assertEq (chosen (snd (findKey f (T.key Enter)))) (Just "map") "and it is what Enter chooses"

@test fun aChoiceRunsWhatItBringsBeforeItsLine () =
  -- The finder's choice puts `List.map` on the line, and the `use` it needs
  -- is entered just before that line is.
  let editorOn =
    \theme pending ->
      editorOf
        theme
        pending
        "> "
        None
        (\t -> G.token "Text" t)
        (\t -> [])
        (\k -> "")
        (\g -> "")
        (\t at -> [])
        (\t q -> library q)
        []
        []
  in
  let events = V.map (\k -> Event.Pressed k) [T.ctrl "f", T.key Enter, T.key Enter] in
  let out =
    snd
      (withOutput (\() ->
         T.withEvents events (\() -> run editorOn "plain" "" (\t -> "ran ${t}") () [] [])))
  in assertEq
       (S.contains "ran use Std.List as List\nran List.map\n" out)
       True
       "the `use`, then the line"

-- A pane that counts: Up counts one more, Enter puts the count on the line,
-- `x` enters text of its own, and Escape closes it.
def counter =
  pane
    (\db file text at -> 0)
    (\n (k : Key) ->
      match k.code with
      | Up -> Step.Go (n + 1)
      | Enter -> Step.Put "n=${show n}" 3 ""
      | Character c -> if c == "x" then Step.Enter "x!" else Step.Go n
      | _ -> Step.Close)
    (\n cols -> D.writeIn (D.blank 20 1) (D.area (D.blank 20 1)) 0 0 D.style "count ${show n}")

-- What a prompt with `counter` opened by Ctrl-T and by `:count` writes for
-- `events`, evaluating an entry as `ran` and it.
fun counting (events : [Key]) =
  let panes = [("ctrl-t", \t at -> counter () 0 t at), (":count", \t at -> counter () 0 t at)] in
  let editorOn =
    \theme pending ->
      editorOf
        theme
        pending
        "> "
        (Just (\th t -> t))
        (\t -> G.token "Text" t)
        (\t -> [])
        (\k -> "")
        (\g -> "")
        (\t at -> [])
        (\t q -> [])
        []
        panes
  in snd
       (withOutput (\() ->
          T.withEvents (V.map (\k -> Event.Pressed k) events) (\() ->
            run editorOn "plain" "" (\t -> "ran ${t}") () [] panes)))

@test fun aPaneAKeyOpensPutsWhatItEndsWithOnTheLine () =
  let a =
    assertEq
      (S.contains "ran n=2\n" (counting [T.ctrl "t", T.key Up, T.key Up, T.key Enter, T.key Enter]))
      True
      "two counted, put on the line, and the line entered"
  in
  let b =
    assertEq
      (S.contains "ran x!\n" (counting [T.ctrl "t", T.key (Character "x")]))
      True
      "and text it enters is entered"
  in assertEq
       (S.contains "ran" (counting [T.ctrl "t", T.key Escape]))
       False
       "closed, it leaves nothing"

@test fun aPaneACommandOpensIsShownToo () =
  let typed = V.map (\c -> T.key (Character (C.toString c))) (S.chars ":count") in
  assertEq
    (S.contains "ran n=1\n" (counting (V.concat [typed, [T.key Enter, T.key Up, T.key Enter]])))
    True
    "opened by its command, and what it puts entered"
