-- `format!`: a formatter, declared against a grammar's rules.
--
--   format! {
--     pub Style for Mini
--     indent 2
--     width 80
--     | Let   = "let" recursive name params "="
--                 group(indent(line value) line "in") newline body
--     | Lam   = "fun" params "->" indent(line body)
--     | If    = "if" cond indent(line "then" yes) indent(line "else" no)
--     | Paren = "(" indent(cut expr) cut ")"
--   }
--
-- A rule of the formatter is a rule of the grammar, written again as what a
-- node of it holds, in the order the grammar has them: a token as it is
-- written, `"let"`, and a child by its label -- or, where the grammar gave it
-- none, by the name its accessor has, `expr` for an `Expr`. Around and
-- between them:
--
--   indent(…)   what it encloses is a level in from where the node began
--   indent 3(…) what it encloses is 3 columns in -- or, `indent -1(…)`, out
--   group(…)    what it encloses goes on one line if it fits, and breaks
--               together if it does not; a rule is a group as a whole
--   line        a space -- or a line's end, where its group breaks
--   cut         nothing -- or a line's end, where its group breaks
--   newline     a line's end, always: its group, and every one around it,
--               breaks
--   tight       nothing: two things with no space between
--
-- Two things with none of these between them are a space apart. A rule or a
-- child the grammar does not have is an error where it was named. A rule that
-- begins `nogroup` is not a group of its own: its partings break with the
-- group around it -- so a chain of nodes, each holding the next, breaks as
-- one.
--
-- **With a width**, `formatStyle` lays a program out: each node with a rule
-- on one line if that fits in the width, and broken where its rule says if
-- not, a child laid out in its turn by its own rule. A node no rule is for is
-- written as it was -- its breaks where they were, set in by what is around
-- it -- so a formatter is written a rule at a time. A comment keeps a line of
-- its own before what it was written before, which breaks whatever holds it
-- -- or, written at the end of a line, stays at its end, a break after it.
-- A parting a rule begins or ends with parts its node from what is around it,
-- and stands with the partings there: `Sep = newline sep tight` parts the
-- items it is between by a break, and only that. Between two of the nodes a
-- child names when it is many, a blank line the text had is kept, one at
-- most. A token with no text -- one a layout pass put in -- is written as
-- nothing and parts nothing: what is around it stands as if it were not there.
-- What laying out changes is the space between tokens, and nothing else:
-- every token that was in the text is in it after, a child the rule did not
-- name -- something the parser could not place -- written where it was.
-- Lines are broken by [Pretty](https://github.com/meadow-lang/Pretty).
--
-- **Without one**, it only indents: where lines break is as the program was
-- written, and each line is set in by what the rules say of the place it
-- starts at -- one level for each node that began on an earlier line and
-- whose indented part the line starts in, once for each such *line*, not
-- each node: `let x = fun y ->` opens a `let` and a `fun` on one line, and
-- what follows is in by one level, not two. A line that starts inside a
-- token -- a string or a comment over several lines -- is left alone. The
-- partings say nothing then, and a group is what it encloses.
--
-- **Where the next line goes.** Of an entry that is not finished -- what a
-- REPL has when Enter is pressed -- `indentStyle` says what the line after it
-- should open with: a level for each line on which a node began that is
-- still open at the end, in its indented part. A node is open there when
-- what it has of that part runs to the end -- `let x = 1 +` -- or when it
-- has none of it yet and nothing after it -- `let x =`. So an entry is
-- indented as it is typed the way the formatter would indent it once it is
-- whole.
--
-- What is written, for a formatter `Style` of a grammar `Mini`:
--
-- - `formatStyle : Green Mini -> String`, the tree's text laid out, or with
--   every line set in, as the formatter has a width or not;
-- - `indentStyle : Green Mini -> String`, what the line after an unfinished
--   entry opens with.
--
-- Underneath, a formatter is a `Style`: the rules as data, matched against a
-- node's children as they are met -- so a tree with something missing in it,
-- or something wrong, is formatted as far as it can be read.

use Std.Collections.Vector as V
use Std.Collections.HashMap as HashMap
use Std.Collections.HashMap (HashMap)
use Std.String as S
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Sort (sortOn)
use Lingua.Green (Green)
use Lingua.Green as G
use Lingua.Red (Syntax)
use Lingua.Red as R
use Pretty as PP
use Pretty (Doc)

-- What a rule says a node holds: a token, by its text; a child, by the names
-- of the kinds it may be -- one, or as many as there are; several of those a
-- level in; several that go on one line or break together; and, between
-- them, how they are parted (`Parting`).
@pub data Elem
  = Tok String
  | Child [String] Bool
  | Indent [Elem]
  | IndentBy Int [Elem]
  | Group [Elem]
  | Mark Int
  | NoGroup

use Elem.*

-- How two things are parted, weakest first: by nothing; by nothing, or a
-- break where the group breaks; by a space, or a break where it breaks; by a
-- break, always; by a blank line, which is kept where the text had one.
def tightly : Int = 0
def cutting : Int = 1
def lining : Int = 2
def breaking : Int = 3
def blanking : Int = 4

-- The same, as functions: what `format!` writes a rule with.
@pub fun tok (t : String) : Elem = Tok t

@pub fun child (kinds : [String]) (many : Bool) : Elem = Child kinds many

@pub fun indented (es : [Elem]) : Elem = Indent es

@pub fun indentedBy (n : Int) (es : [Elem]) : Elem = IndentBy n es

-- A rule's first element, for a rule that is not a group of its own.
@pub def nogroup : Elem = NoGroup

@pub fun grouped (es : [Elem]) : Elem = Group es

@pub def tight : Elem = Mark tightly

@pub def cut : Elem = Mark cutting

@pub def line : Elem = Mark lining

@pub def newline : Elem = Mark breaking

-- A formatter: how wide a level is, how wide a line may be -- 0 for one that
-- only indents -- what a kind is called, which kinds are trivia, the rules,
-- each under the name of its node's kind, and -- while it lays a text out --
-- that text.
@pub data Style k
  = Style Int Int (k -> String) (k -> Bool) (HashMap String [Elem]) String

@pub fun style
    (unit : Int)
    (width : Int)
    (name : k -> String)
    (trivia : k -> Bool)
    (rules : [(String, [Elem])])
    : Style k =
  Style
    unit
    width
    name
    trivia
    (V.foldl (\m r -> HashMap.insert (fst r) (snd r) m) HashMap.empty rules)
    ""

fun unitOf st = match st with | Style u _ _ _ _ _ -> u
fun widthOf st = match st with | Style _ w _ _ _ _ -> w
fun nameOf st = match st with | Style _ _ n _ _ _ -> n
fun triviaOf st = match st with | Style _ _ _ t _ _ -> t
fun rulesOf st = match st with | Style _ _ _ _ r _ -> r
fun sourceOf st = match st with | Style _ _ _ _ _ t -> t

fun reading (st : Style k) (t : String) : Style k =
  match st with | Style u w n tr r _ -> Style u w n tr r t

-- What an error node's kind is called, whatever the grammar: `syntax!` gives
-- every grammar one.
def errorNode : String = "ErrorNode"

def absent : (Int, Int) = (0 - 1, 0 - 1)

fun present (r : (Int, Int)) : Bool = fst r >= 0

-- --- a rule against a node ---------------------------------------------------

-- The tokens and children a rule names, in order, through what encloses them.
fun leaves (es : [Elem]) : [Elem] =
  V.concatMap
    (\e ->
      match e with
      | Indent inner -> leaves inner
      | IndentBy _ inner -> leaves inner
      | Group inner -> leaves inner
      | Mark _ -> []
      | NoGroup -> []
      | other -> [other])
    es

-- Each leaf against `kids`, from the first on: which of them it is -- the
-- first and the last, or `absent`.
fun matchLeaves (st : Style k) (kids : [Syntax k]) (ls : [Elem]) : [(Int, Int)] =
  fst
    (V.foldl
       (\acc e ->
         match acc with
         | (out, at) ->
             (match matchOne st kids e at with
              | (r, next) -> (V.pushBack out r, next)))
       ([], 0)
       ls)

fun matchOne (st : Style k) (kids : [Syntax k]) (e : Elem) (i : Int) : ((Int, Int), Int) =
  match e with
  | Tok t ->
      (match firstFrom (\c -> R.isTokenOf c and R.text c == t) kids i with
       | Just j -> ((j, j), j + 1)
       | None -> (absent, i))
  | Child kinds many ->
      let j = pastErrors st kids i in
      if fits st kinds kids j then
        let k = if many then lastFitting st kinds kids j else j in
        ((j, k), k + 1)
      else (absent, i)
  | _ -> (absent, i)

fun firstFrom (p : Syntax k -> Bool) (kids : [Syntax k]) (i : Int) : Maybe Int =
  match V.get kids i with
  | None -> None
  | Just c -> if p c then Just i else firstFrom p kids (i + 1)

fun kindName (st : Style k) (c : Syntax k) : String = (nameOf st) (R.kindOf c)

-- Past what the parser could not read: an error node is no child of a rule.
fun pastErrors (st : Style k) (kids : [Syntax k]) (i : Int) : Int =
  match V.get kids i with
  | Just c -> if kindName st c == errorNode then pastErrors st kids (i + 1) else i
  | None -> i

fun fits (st : Style k) (kinds : [String]) (kids : [Syntax k]) (j : Int) : Bool =
  match V.get kids j with
  | Just c -> V.elem (kindName st c) kinds
  | None -> False

fun lastFitting (st : Style k) (kinds : [String]) (kids : [Syntax k]) (j : Int) : Int =
  if fits st kinds kids (j + 1) then lastFitting st kinds kids (j + 1) else j

-- Which leaves each `indent(…)` of a rule encloses, at any depth: the first,
-- the one after the last, and how far in it is -- `unit` for a level.
fun indentSpans (unit : Int) (es : [Elem]) (from : Int) : [(Int, Int, Int)] =
  let spanOf =
    \out at width inner ->
      (
        V.append
          (V.pushBack out (at, at + V.len (leaves inner), width))
          (indentSpans unit inner at),
        at + V.len (leaves inner)
      )
  in fst
       (V.foldl
          (\acc e ->
            match acc with
            | (out, at) ->
                (match e with
                 | Indent inner -> spanOf out at unit inner
                 | IndentBy n inner -> spanOf out at n inner
                 | Group inner ->
                     (V.append out (indentSpans unit inner at), at + V.len (leaves inner))
                 | Mark _ -> (out, at)
                 | NoGroup -> (out, at)
                 | _ -> (out, at + 1)))
          ([], from)
          es)

fun kidsOf (st : Style k) (s : Syntax k) : [Syntax k] =
  V.filter (\c -> not ((triviaOf st) (R.kindOf c))) (R.children s)

-- --- the indented parts of a tree --------------------------------------------

-- An indented part: where it starts and ends in the text, where the node it
-- is part of began, and how far in it is.
data Region = Region Int Int Int Int

fun regionStart r = match r with | Region a _ _ _ -> a
fun regionEnd r = match r with | Region _ b _ _ -> b
fun regionOwner r = match r with | Region _ _ o _ -> o
fun regionWidth r = match r with | Region _ _ _ w -> w

-- A node with a rule: where it began and ends, and each `indent(…)` of its
-- rule -- where it is in the text, if any of it is there, whether anything
-- the rule names after it is, and how far in it is.
fun ruled (st : Style k) (g : Green k) : [(Int, Int, [((Int, Int), Bool, Int)])] =
  V.concatMap
    (\i ->
      if G.isTokenAt g i then []
      else
        let s = R.Syntax g i in
        match HashMap.lookup (kindName st s) (rulesOf st) with
        | None -> []
        | Just elems ->
            let kids = kidsOf st s in
            let found = matchLeaves st kids (leaves elems) in
            let place =
              \r ->
                if present r then
                  (
                    fst (R.textRange (V.getOr s kids (fst r))),
                    snd (R.textRange (V.getOr s kids (snd r)))
                  )
                else absent
            in
            let parts =
              V.map
                (\span ->
                  match span with
                  | (a, b, width) ->
                      let inside =
                        V.filter present (V.map (\j -> V.getOr absent found j) (V.range a b))
                      in
                      let spot =
                        (match (V.get inside 0, V.last inside) with
                         | (Just x, Just y) -> (fst (place x), snd (place y))
                         | _ -> absent)
                      in (spot, V.any present (V.drop found b), width))
                (indentSpans (unitOf st) elems 0)
            in [(G.startAt g i, G.endAt g i, parts)])
    (V.range 0 (G.slots g))

-- Every indented part that is there, in the order they start.
fun regions (st : Style k) (g : Green k) : [Region] =
  sortOn
    regionStart
    (V.concatMap
       (\n ->
         match n with
         | (from, _, parts) ->
             V.concatMap
               (\p ->
                 match p with
                 | (r, _, width) -> if present r then [Region (fst r) (snd r) from width] else [])
               parts)
       (ruled st g))

-- --- lines -------------------------------------------------------------------

fun lineStarts (t : String) : [Int] =
  V.foldl
    (\acc i -> if toInt (stringByteAt t i) == 10 then V.pushBack acc (i + 1) else acc)
    [0]
    (V.range 0 (stringByteLength t))

-- Which line `at` is on: the last that starts at or before it.
fun lineOf (starts : [Int]) (at : Int) : Int = searchLine starts at 0 (V.len starts - 1)

fun searchLine (starts : [Int]) (at : Int) (lo : Int) (hi : Int) : Int =
  if lo >= hi then lo
  else
    let mid = (lo + hi + 1) / 2 in
    if V.getOr 0 starts mid <= at then searchLine starts at mid hi
    else searchLine starts at lo (mid - 1)

-- Where a line's first character that is not a space or a tab is.
fun pastBlanks (t : String) (i : Int) (stop : Int) : Int =
  if i < stop and (toInt (stringByteAt t i) == 32 or toInt (stringByteAt t i) == 9) then
    pastBlanks t (i + 1) stop
  else i

-- How far in the parts of `open` set a line: for each line one of their
-- nodes began on, the farthest in of those parts -- a level, or what
-- `indent 3(…)` says.
fun levels (starts : [Int]) (open : [Region]) : Int =
  let widest =
    V.foldl
      (\seen r ->
        let l = lineOf starts (regionOwner r) in
        match V.find (\x -> fst x == l) seen with
        | Just _ -> V.map (\x -> if fst x == l then (l, max (snd x) (regionWidth r)) else x) seen
        | None -> V.pushBack seen (l, regionWidth r))
      []
      open
  in max 0 (V.foldl (\n x -> n + snd x) 0 widest)

-- --- indenting ---------------------------------------------------------------

-- The tree's text, each line set in as the rules say, and broken where it was.
@pub fun reindent (st : Style k) (g : Green k) : String =
  let t = G.text g in
  let starts = lineStarts t in
  let all = regions st g in
  let total = stringByteLength t in
  let step =
    \acc l ->
      match acc with
      | (out, open, next) ->
          let from = V.getOr 0 starts l in
          let stop = (if l + 1 < V.len starts then V.getOr total starts (l + 1) - 1 else total) in
          let at = pastBlanks t from stop in
          -- The parts this line starts in: those open before that have not
          -- ended, and those that start by here.
          let upTo = startingBy all next at in
          let entered =
            V.filter
              (\r -> regionEnd r > at)
              (V.map (\i -> V.getOr (Region 0 0 0 0) all i) (V.range next upTo))
          in
          let open2 = V.append (V.filter (\r -> regionEnd r > at) open) entered in
          let line =
            (if at >= stop then ""
             else if insideToken g from then stringSlice t from stop
             else
               let counted = V.filter (\r -> lineOf starts (regionOwner r) < l) open2 in
               S.repeat " " (levels starts counted) ++ stringSlice t at stop)
          in (V.pushBack out line, open2, upTo)
  in match V.foldl step ([], [], 0) (V.range 0 (V.len starts)) with
     | (out, _, _) -> S.join "\n" out

-- The first region from `i` on that starts after `at`.
fun startingBy (all : [Region]) (i : Int) (at : Int) : Int =
  match V.get all i with
  | Just r -> if regionStart r <= at then startingBy all (i + 1) at else i
  | None -> i

-- Whether a line starting at `from` starts inside a token that began before
-- it, and is not blank space: a string or a comment that runs over lines.
fun insideToken (g : Green k) (from : Int) : Bool =
  if from == 0 then False
  else
    match R.tokenAt from (R.root g) with
    | Just tok ->
        let r = R.textRange tok in
        fst r < from and not (S.isEmpty (S.trim (stringSlice (G.text g) (fst r) from)))
    | None -> False

-- What the line after the tree's text opens with, the text being unfinished:
-- a level for each line on which a node began that is still open at the end,
-- in its indented part.
@pub fun continuation (st : Style k) (g : Green k) : String =
  let t = G.text g in
  let starts = lineStarts t in
  let last = lastEnd st g in
  if last < 0 then ""
  else
    let open =
      V.concatMap
        (\n ->
          match n with
          | (from, to, parts) ->
              V.concatMap
                (\p ->
                  match p with
                  | (r, later, width) ->
                      -- There, and running to the end; or not
                      -- there, with nothing after it, in a node
                      -- that runs to the end.
                      if present r then
                        (if snd r >= last then [Region (fst r) (snd r) from width] else [])
                      else if to >= last and not later then [Region last last from width]
                      else [])
                parts)
        (ruled st g)
    in S.repeat " " (levels starts open)

-- Where the last token that is not trivia ends: -1 when there is none.
fun lastEnd (st : Style k) (g : Green k) : Int =
  V.foldl
    (\acc i ->
      if G.isTokenAt g i and not ((triviaOf st) (G.kindAt g i)) and G.endAt g i > G.startAt g i then
        max acc (G.endAt g i)
      else acc)
    (0 - 1)
    (V.range 0 (G.slots g))

-- --- laying out --------------------------------------------------------------

-- A piece of a node being laid out: a parting -- how strong, and how many
-- columns in -- or something to write, at a column, and the partings it
-- begins and ends with of its own, a level in, or -1 for none: a break it
-- begins or ends with stands with one beside it rather than as well as it.
data Item = Parting Int Int | Written Int (Doc ()) Int Int

use Item.*

-- The tree's text laid out within the formatter's width: each node with a
-- rule on one line if it fits, and broken where its rule says if not.
@pub fun layout (style : Style k) (g : Green k) : String =
  let t = G.text g in
  let st = reading style t in
  match PP.render (widthOf st) (docOf st (R.root g)) with
  | Ok out ->
      -- A line of nothing but its indent is an empty one; and the text ends
      -- with a line's end if it did.
      let lines = V.map (\l -> if S.isEmpty (S.trim l) then "" else l) (S.split "\n" out) in
      S.trimEnd (S.join "\n" lines)
        ++ (if S.endsWith "\n" t and not (S.isEmpty (S.trim out)) then "\n" else "")
  | Err _ -> t

fun docOf (st : Style k) (s : Syntax k) : Doc () =
  if R.isTokenOf s then PP.text (R.text s)
  else
    match HashMap.lookup (kindName st s) (rulesOf st) with
    | Just elems -> ruledDoc st s elems
    | None -> writtenDoc st s

-- How many breaks a parting is: none, one, or -- a blank line -- two.
fun breaksOf (strength : Int) : Int =
  if strength >= blanking then 2 else if strength >= breaking then 1 else 0

-- A node no rule is for, as it was written: its tokens and children in turn,
-- a break where there was one -- and a blank line where there was -- and the
-- spaces between as they were. Blank space before its first thing and after
-- its last is not its to keep: what is around the node parts it from them.
-- A comment that ends it is followed by a break, so that nothing after the
-- node is taken for part of the comment -- but not at the end of the text.
-- A child with a rule that begins or ends with a break -- its own, or a level
-- in -- has it where the text has none, and none more where the text has
-- one; and a token with no text is nothing. A line the text broke to is as
-- far in from the line the node began on as it was -- in a language whose
-- layout is part of its meaning, a line further in goes on with the one
-- before -- but for a child whose rule begins with a break, which its rule
-- sets in.
--
-- So the breaks are written when what follows them is: the fold holds what
-- is written, the breaks owed, how many it ends with already, the space the
-- text had, which a break that follows drops, how far in the line the text
-- broke to was written, and how far in the line being written is set.
fun writtenDoc (st : Style k) (s : Syntax k) : Doc () =
  match writtenParts st s with | (d, n) -> breaksAfter d n

-- A node no rule is for, as `writtenDoc` writes it, but for the breaks it
-- ends with: how many, for what holds it to write as a parting.
fun writtenParts (st : Style k) (s : Syntax k) : (Doc (), Int) =
  let all = R.children s in
  let base = indentOfLine (sourceOf st) (R.offset s) in
  let blank = \c -> (triviaOf st) (R.kindOf c) and S.isEmpty (S.trim (R.text c)) in
  let solid =
    V.filter
      (\i ->
        match V.get all i with
        | Just c -> not (blank c)
        | None -> False)
      (V.range 0 (V.len all))
  in match (V.get solid 0, V.last solid) with
     | (Just first, Just last) ->
         -- What is written so far with `d` after it, which begins with
         -- `opens` breaks of its own: what to go on with -- the text so far,
         -- and how far in the line it ends on is set.
         let put =
           \acc opens d ->
             match acc with
             | (doc, owed, broke, gap, col, cur) ->
                 let n = max 0 (owed - broke - opens) in
                 let fresh = owed > 0 or broke > 0 or opens > 0 in
                 let set =
                   if not fresh then cur else if opens > 0 or col < 0 then 0 else max 0 (col - base)
                 in
                 let lead = if fresh then breaksAfter PP.nil n else PP.text gap in
                 (PP.append doc (PP.nest set (PP.append lead d)), set)
         in
         let written =
           \acc opens d ->
             (match put acc opens d with
              | (doc, set) -> (doc, 0, 0, "", 0 - 1, set))
         in
         let step =
           \acc i ->
             match (acc, V.get all i) with
             | (_, None) -> acc
             | ((doc, owed, broke, gap, col, cur), Just c) ->
                 if (triviaOf st) (R.kindOf c) then
                   let t = R.text c in
                   if not (S.isEmpty (S.trim t)) then written acc 0 (PP.text (S.trim t))
                   else
                     let lines = S.split "\n" t in
                     let n = min 2 (V.len lines - 1) in
                     if n == 0 then
                       (if owed > 0 or broke > 0 then acc else (doc, owed, broke, t, col, cur))
                     else
                       (
                         doc,
                         max owed n,
                         broke,
                         "",
                         stringByteLength (V.getOr "" lines (V.len lines - 1)),
                         cur
                       )
                 else if R.isTokenOf c then
                   (if S.isEmpty (R.text c) then acc else written acc 0 (PP.text (R.text c)))
                 else
                   match HashMap.lookup (kindName st c) (rulesOf st) with
                   | None ->
                       (match writtenParts st c with
                        | (d, n) ->
                            (match put acc 0 d with
                             | (doc2, set) -> (doc2, n, 0, "", 0 - 1, set)))
                   | Just elems ->
                       (match ruledParts st c elems with
                        | (lead, body, trail) ->
                            let owing = max owed (breaksOf lead) in
                            (match body with
                             | Just (d, opens, closes) ->
                                 (match put
                                    (doc, owing, broke, gap, col, cur)
                                    (breaksOf opens)
                                    d with
                                  | (doc2, set) ->
                                      (doc2, breaksOf trail, breaksOf closes, "", 0 - 1, set))
                             | None -> (doc, max owing (breaksOf trail), broke, gap, col, cur)))
         in
         let body =
           (match V.foldl step (PP.nil, 0, 0, "", 0 - 1, 0) (V.range first (last + 1)) with
            | (doc, owed, broke, _, _, _) -> (doc, max 0 (owed - broke)))
         in
         let endsInComment =
           (match V.get all last with
            | Just c -> (triviaOf st) (R.kindOf c)
            | None -> False)
         in if endsInComment and M.isSome (R.parent s) then (fst body, max 1 (snd body)) else body
     | _ -> (PP.nil, 0)

-- How far in the line of `t` that `at` is on starts: its spaces and tabs.
fun indentOfLine (t : String) (at : Int) : Int =
  let start = lineStartBefore t (min at (stringByteLength t)) in
  pastBlanks t start (stringByteLength t) - start

fun lineStartBefore (t : String) (at : Int) : Int =
  if at <= 0 then 0
  else if toInt (stringByteAt t (at - 1)) == 10 then at
  else lineStartBefore t (at - 1)

-- `doc` and `n` breaks after it.
fun breaksAfter (doc : Doc ()) (n : Int) : Doc () =
  if n <= 0 then doc else breaksAfter (PP.append doc PP.hardline) (n - 1)

-- A rule's items as one document: a group, unless the rule says `nogroup`.
fun asRule (st : Style k) (elems : [Elem]) (items : [Item]) : Doc () =
  if V.any (\e -> match e with | NoGroup -> True | _ -> False) elems then assemble st items
  else PP.group (assemble st items)

-- A node as its rule lays it out: a group of what the rule names, each child
-- laid out in turn, with a space between two things nothing parts.
fun ruledDoc (st : Style k) (s : Syntax k) (elems : [Elem]) : Doc () =
  asRule st elems (ruledItems st s elems)

-- A node as its rule lays it out, as what is around it sees it: the parting
-- its rule begins with -- the strongest, if several -- what it writes, a
-- group, and the partings that begins and ends with of its own, a level in;
-- and the parting its rule ends with. A parting is -1 where there is none,
-- and a node with nothing to write -- a layout `;` -- is its partings.
fun ruledParts (st : Style k) (s : Syntax k) (elems : [Elem])
    : (Int, Maybe (Doc (), Int, Int), Int) =
  let items = ruledItems st s elems in
  let outer = \i -> (match i with | Parting _ 0 -> True | _ -> False) in
  let strength = \i -> (match i with | Parting n _ -> n | _ -> 0 - 1) in
  let leading = V.len (V.takeWhile outer items) in
  let middle = V.drop items leading in
  -- What it ends with, at any level, parts it from what follows -- which a
  -- break is set in as, whatever level it was written at.
  let trailing = V.len (V.takeWhile isParting (V.reverse middle)) in
  let inner = V.take middle (V.len middle - trailing) in
  let strongest = \is -> V.foldl (\m i -> max m (strength i)) (0 - 1) is in
  (
    strongest (V.take items leading),
    (if V.isEmpty inner then None
     else Just (asRule st elems inner, openingOf inner, closingOf inner)),
    strongest (V.drop middle (V.len middle - trailing))
  )

fun isParting (i : Item) : Bool = match i with | Parting _ _ -> True | _ -> False

fun ruledItems (st : Style k) (s : Syntax k) (elems : [Elem]) : [Item] =
  let all = R.children s in
  -- Where each child that is not trivia is among them all.
  let places =
    V.filter
      (\i ->
        match V.get all i with
        | Just c -> not ((triviaOf st) (R.kindOf c))
        | None -> False)
      (V.range 0 (V.len all))
  in
  let kids = V.map (\i -> V.getOr s all i) places in
  let found = matchLeaves st kids (leaves elems) in
  match itemsOf st all places kids found elems 0 0 (0 - 1) with
  | (items, _, taken) ->
      let rest =
        V.concatMap (\j -> kidItem st all places kids 0 j) (V.range (taken + 1) (V.len kids))
      in
      let after = trailing st all (V.getOr (0 - 1) places (V.len kids - 1)) in
      V.concat [items, rest, after]

-- The items of `es`, `level` columns in: `leaf` is how many leaves came
-- before, and `taken` the last child written. A child the rule did not name
-- -- something the parser could not place -- is written before the next one
-- it did, so nothing that was in the text is left out. Between two of the
-- nodes a child that is many names, a blank line in the text is kept.
fun itemsOf
    (st : Style k)
    (all : [Syntax k])
    (places : [Int])
    (kids : [Syntax k])
    (found : [(Int, Int)])
    (es : [Elem])
    (level : Int)
    (leaf : Int)
    (taken : Int)
    : ([Item], Int, Int) =
  -- What `indent(…)` encloses: nothing at all where it has nothing to
  -- write -- an empty list -- not the partings around that nothing.
  let within =
    \out at done inner columns ->
      match itemsOf st all places kids found inner columns at done with
      | (items, at2, done2) ->
          if V.all isParting items then (out, at2, done2) else (V.append out items, at2, done2)
  in V.foldl
       (\acc e ->
         match acc with
         | (out, at, done) ->
             (match e with
              | Mark strength -> (V.pushBack out (Parting strength level), at, done)
              | NoGroup -> acc
              | Indent inner -> within out at done inner (level + unitOf st)
              | IndentBy n inner -> within out at done inner (level + n)
              | Group inner ->
                  (match itemsOf st all places kids found inner 0 at done with
                   | (items, at2, done2) ->
                       -- What it ends with parts it from what follows.
                       let tail = V.len (V.takeWhile isParting (V.reverse items)) in
                       let body = V.take items (V.len items - tail) in
                       let after =
                         V.map
                           (\i ->
                             match i with
                             | Parting n _ -> Parting n level
                             | other -> other)
                           (V.drop items (V.len items - tail))
                       in if V.isEmpty body then (V.append out after, at2, done2)
                          else
                            (
                              V.concat [
                                out,
                                [Written
                                   level
                                   (PP.group (assemble st body))
                                   (openingOf body)
                                   (0 - 1)],
                                after
                              ],
                              at2,
                              done2
                            ))
              | _ ->
                  let r = V.getOr absent found at in
                  if not (present r) then (out, at + 1, done)
                  else
                    let skipped =
                      V.concatMap
                        (\j -> kidItem st all places kids level j)
                        (V.range (done + 1) (fst r))
                    in
                    let named =
                      V.concatMap
                        (\j ->
                          let kept =
                            if j > fst r and blankBefore all places j then [Parting blanking level]
                            else []
                          in V.append kept (kidItem st all places kids level j))
                        (V.range (fst r) (snd r + 1))
                    in (V.concat [out, skipped, named], at + 1, snd r)))
       ([], leaf, taken)
       es

-- Whether the text between child `j` and the one before it has a blank line.
fun blankBefore (all : [Syntax k]) (places : [Int]) (j : Int) : Bool =
  let from = V.getOr 0 places (j - 1) + 1 in
  let text =
    S.join
      ""
      (V.map
         (\i -> M.unwrapOr "" (M.map R.text (V.get all i)))
         (V.range from (V.getOr from places j)))
  in
  let pieces = S.split "\n" text in
  V.any (\i -> S.isEmpty (S.trim (V.getOr "x" pieces i))) (V.range 1 (V.len pieces - 1))

-- The parting items begin with, of their own -- or -1.
fun openingOf (items : [Item]) : Int =
  match V.get items 0 with
  | Just (Parting n _) -> n
  | Just (Written _ _ o _) -> o
  | None -> 0 - 1

-- The parting items end with, of their own -- or -1.
fun closingOf (items : [Item]) : Int =
  match V.last items with
  | Just (Parting n _) -> n
  | Just (Written _ _ _ c) -> c
  | None -> 0 - 1

-- Child `j`, with the comments written before it, each on a line of its own:
-- the partings its rule begins and ends with, standing with those around it,
-- and what it writes. A token with no text is nothing -- but the comments. A
-- comment on the line of what is before it stays at that line's end, and a
-- break follows it. Nothing written ends with a break: a break written at the
-- end of something is set in as what follows it is, not as itself, so a break
-- after it is a parting, which what follows sets in.
fun kidItem
    (st : Style k)
    (all : [Syntax k])
    (places : [Int])
    (kids : [Syntax k])
    (level : Int)
    (j : Int)
    : [Item] =
  let at = V.getOr 0 places j in
  let before = (if j == 0 then 0 else V.getOr 0 places (j - 1) + 1) in
  let textAt = \i -> M.unwrapOr "" (M.map R.text (V.get all i)) in
  let found =
    V.concatMap
      (\i -> (let t = S.trim (textAt i) in if S.isEmpty t then [] else [(i, t)]))
      (V.range before at)
  in
  let endsLine =
    (match V.get found 0 with
     | Just (i, _) -> j > 0 and not (V.any (\k -> S.contains "\n" (textAt k)) (V.range before i))
     | None -> False)
  in
  let none = 0 - 1 in
  let atEnd =
    (match (endsLine, V.get found 0) with
     | (True, Just (_, t)) -> [Written level (PP.text t) none none, Parting breaking level]
     | _ -> [])
  in
  let comments = V.map snd (if endsLine then V.drop found 1 else found) in
  let commented =
    \own -> V.foldr (\c d -> PP.append (PP.append (PP.text c) PP.hardline) d) own comments
  in
  let onlyComments =
    if V.isEmpty comments then []
    else
      [
        Written level (PP.intersperse (V.map PP.text comments) PP.hardline) none none,
        Parting breaking level
      ]
  in
  let opening = \opens -> if V.isEmpty comments then opens else none in
  let own =
    (match V.get kids j with
     | None -> []
     | Just c ->
         if R.isTokenOf c then
           (if S.isEmpty (R.text c) then onlyComments
            else [Written level (commented (PP.text (R.text c))) none none])
         else
           match HashMap.lookup (kindName st c) (rulesOf st) with
           | None ->
               (match writtenParts st c with
                | (d, n) ->
                    V.append
                      [Written level (commented d) none none]
                      (if n > 0 then [Parting (if n > 1 then blanking else breaking) level]
                       else []))
           | Just elems ->
               (match ruledParts st c elems with
                | (lead, body, trail) ->
                    V.concat [
                      (if lead >= 0 then [Parting lead level] else []),
                      (match body with
                       | Just (d, opens, closes) ->
                           [Written level (commented d) (opening opens) closes]
                       | None -> onlyComments),
                      (if trail >= 0 then [Parting trail level] else [])
                    ]))
  in V.append atEnd own

-- The trivia from child `from` up to `to` that is not blank: comments.
fun commentsIn (all : [Syntax k]) (from : Int) (to : Int) : [String] =
  V.concatMap
    (\i ->
      match V.get all i with
      | Just c -> (let t = S.trim (R.text c) in if S.isEmpty t then [] else [t])
      | None -> [])
    (V.range from to)

-- Comments after a node's last child: each written, and a break after it,
-- so that nothing which follows is taken for part of it.
fun trailing (st : Style k) (all : [Syntax k]) (last : Int) : [Item] =
  V.concatMap
    (\c -> [Written 0 (PP.text c) (0 - 1) (0 - 1), Parting breaking 0])
    (commentsIn all (last + 1) (V.len all))

-- Items as one document: each at its column, a parting as what it is, and a
-- space between two written things nothing parts. Of several partings in a
-- row the strongest stands -- and of a parting and a break beside it that
-- something written begins or ends with of its own, what the stronger asks.
fun assemble (st : Style k) (items : [Item]) : Doc () =
  match V.foldl
    (\acc item ->
      match acc with
      | (doc, pending, level, closed) ->
          (match item with
           | Parting strength at -> (doc, max pending strength, at, closed)
           | Written at d opens closes ->
               -- What ended the last written thing is there only if it is a
               -- break: a softer parting at the end of a group writes nothing.
               let beside = max opens (if closed >= breaking then closed else 0 - 1) in
               -- A break is set in as what follows it is, so the two
               -- are nested together.
               let sep =
                 (if pending >= 0 then besides pending beside
                  else if closed >= 0 or opens >= 0 then PP.nil
                  else PP.space)
               in (PP.append doc (PP.nest at (PP.append sep d)), 0 - 1, 0, closes)))
    (PP.nil, 0 - 1, 0, tightly)
    items with
  -- A parting with nothing after it parts nothing -- unless it is a
  -- break that was asked for.
  | (doc, pending, level, closed) ->
      if pending >= breaking and closed < breaking then PP.append doc (PP.nest level PP.hardline)
      else doc

-- A parting, where what is beside it begins or ends with one of its own,
-- `beside`: only what the parting asks for that that does not.
fun besides (pending : Int) (beside : Int) : Doc () =
  if beside < 0 then partingDoc pending
  else if pending <= beside then PP.nil
  else if pending >= blanking and beside >= breaking then PP.hardline
  else partingDoc pending

fun partingDoc (strength : Int) : Doc () =
  if strength == tightly then PP.nil
  else if strength == cutting then PP.line_
  else if strength == lining then PP.line
  else if strength == breaking then PP.hardline
  else PP.append PP.hardline PP.hardline

-- --- format! -----------------------------------------------------------------

use Std.Macro (TokenTree, Delim, Loc, isPunct, lookupAs)
use Std.Macro.TokenTree.*
use Std.Macro.Loc.*
use Std.Macro.Delim.*
use Std.Macro.Parse (Tokens, parseTokens, ident, keyword, punct, number, treesUntil)
use Std.String.Parse as P
use Std.String.Parse (Parser)
use Std.String.Parse (keep, skip)
use Lingua.Pipe (named)
use Std.Macro (Expand)
use Std.Result.Result.*
use Lingua.Lang (Lang, Sort, Prod, Field, Ty, Keeping, TokenField)
use Lingua.Lang.Lang.*
use Lingua.Lang.Sort.*
use Lingua.Lang.Prod.*
use Lingua.Lang.Field.*
use Lingua.Lang.Ty.*
use Lingua.Lang.Keeping.*
use Lingua.Lang.TokenField.*

-- An element as it was written: a token, a child's name and where it was
-- written, or what `indent(…)` encloses -- a level in, or so many columns.
data Written
  = WTok String
  | WName String Loc
  | WIndent [Written]
  | WIndentBy Int [Written]
  | WGroup [Written]
  | WMark String

use Written.*

-- `indent` and `group` before parentheses are what they say; anywhere else
-- they are a child's name. The partings are words of their own.
def partings : [String] = ["tight", "cut", "line", "newline"]

fun writtenOf (ts : [TokenTree]) : [Written] = writing ts 0 []

fun writing (ts : [TokenTree]) (i : Int) (out : [Written]) : [Written] =
  match (V.get ts i, V.get ts (i + 1)) with
  | (Just (Word "indent" _), Just (Group Paren inner _)) ->
      writing ts (i + 2) (V.pushBack out (WIndent (writtenOf inner)))
  | (Just (Word "indent" _), Just (Num n _)) ->
      (match V.get ts (i + 2) with
       | Just (Group Paren inner _) ->
           writing ts (i + 3) (V.pushBack out (WIndentBy n (writtenOf inner)))
       | _ -> writing ts (i + 1) (V.pushBack out (WName "indent" Nowhere)))
  | (Just (Word "indent" _), Just minus) ->
      (match (isPunct "-" minus, V.get ts (i + 2), V.get ts (i + 3)) with
       | (True, Just (Num n _), Just (Group Paren inner _)) ->
           writing ts (i + 4) (V.pushBack out (WIndentBy (0 - n) (writtenOf inner)))
       | _ ->
           (match V.get ts i with
            | Just (Word w at) -> writing ts (i + 1) (V.pushBack out (WName w at))
            | _ -> writing ts (i + 1) out))
  | (Just (Word "group" _), Just (Group Paren inner _)) ->
      writing ts (i + 2) (V.pushBack out (WGroup (writtenOf inner)))
  | (Just (Str s _), _) -> writing ts (i + 1) (V.pushBack out (WTok s))
  | (Just (Word w at), _) ->
      writing ts (i + 1) (V.pushBack out (if V.elem w partings then WMark w else WName w at))
  | (Just _, _) -> writing ts (i + 1) out
  | (None, _) -> out

def formatRule : Parser Tokens ((String, Loc), [TokenTree]) =
  P.pure (\r body -> (r, body))
    |> skip (punct "|")
    |> keep named
    |> skip (punct "=")
    |> keep (treesUntil (isPunct "|"))

-- A rule as it is read: its name, where that was written, and its body.
type FormatRule = ((String, Loc), [TokenTree])

-- A call: whether it is public, its name, the grammar's, how wide a level
-- and a line are, and the rules.
type FormatCall = (Bool, String, (String, Loc), Maybe Int, Maybe Int, [FormatRule])

def formatCall : Parser Tokens FormatCall =
  P.pure (\pub name grammar unit width rules -> (M.isSome pub, name, grammar, unit, width, rules))
    |> keep (P.optional (keyword "pub"))
    |> keep ident
    |> skip (keyword "for")
    |> keep named
    |> keep (P.optional (P.skipThen (keyword "indent") number))
    |> keep (P.optional (P.skipThen (keyword "width") number))
    |> keep (P.many formatRule)

@macro
@pub fun format (ts : [TokenTree]) : [TokenTree] ! { Expand | e } =
  match parseTokens formatCall ts with
  | Err failed -> failed
  | Ok (pub, name, grammar, unit, width, rules) ->
      match lookupAs (fst grammar) with
      | Err _ ->
          [Fail
             "no grammar is called ${fst grammar}: `format!` is of a grammar `syntax!` declared"
             (snd grammar)]
      | Ok l ->
          match l with
          | Lang _ _ sorts _ _ keeping _ ->
              (match keeping with
               | AsTables ->
                   [Fail "${fst grammar} is kept as tables: a formatter is of a tree" (snd grammar)]
               | AsTrees _ trivia tokenFields ->
                   let prods = V.concatMap (\s -> match s with | Sort _ ps -> ps) sorts in
                   let done = V.map (\r -> ruleCode sorts prods tokenFields r) rules in
                   match V.find (\d -> match d with | Err _ -> True | Ok _ -> False) done with
                   | Just (Err failed) -> failed
                   | _ ->
                       formatCode
                         (if pub then "@pub " else "")
                         name
                         (fst grammar)
                         (M.unwrapOr 2 unit)
                         (M.unwrapOr 0 width)
                         trivia
                         (V.concatMap (\d -> match d with | Ok c -> [c] | Err _ -> []) done))

-- A rule as the data `Style` holds: the node's kind, and its elements.
fun ruleCode sorts prods tokenFields (r : ((String, Loc), [TokenTree]))
    : Result [TokenTree] String =
  match r with
  | ((n, at), body) ->
      match V.find
        (\p ->
          match p with
          | Prod m fs -> m == n and not (isEnumProd sorts p))
        prods with
      | None ->
          Err
            [Fail
               "no rule of the grammar is called ${n} -- or it is a choice of rules, and has no node of its own"
               at]
      | Just (Prod _ fs) ->
          -- `nogroup` first: the rule is not a group of its own.
          let ungrouped =
            (match V.get body 0 with
             | Just (Word "nogroup" _) ->
                 not (V.any (\f -> match f with | Field m _ _ _ -> m == "nogroup") fs)
             | _ -> False)
          in match elemsCode
               sorts
               tokenFields
               n
               fs
               (writtenOf (if ungrouped then V.drop body 1 else body)) with
             | Err failed -> Err failed
             | Ok code ->
                 Ok
                   "(\"Node${n}\", ${if ungrouped then "LinguaV.pushFront ${code} LinguaF.nogroup" else code})"

-- An enum's production holds only the enum's sort, under its own name.
fun isEnumProd sorts p =
  match p with
  | Prod n fs ->
      V.any (\s -> match s with | Sort m _ -> m == n) sorts
        and V.len fs == 1
        and V.any (\f -> match f with | Field _ (TSort m) _ _ -> m == n | _ -> False) fs

fun elemsCode sorts tokenFields rule fs (ws : [Written]) : Result [TokenTree] String =
  let each = V.map (\w -> elemCode sorts tokenFields rule fs w) ws in
  match V.find (\d -> match d with | Err _ -> True | Ok _ -> False) each with
  | Just (Err failed) -> Err failed
  | _ -> Ok "[${S.join ", " (V.concatMap (\d -> match d with | Ok c -> [c] | Err _ -> []) each)}]"

fun elemCode sorts tokenFields rule fs (w : Written) : Result [TokenTree] String =
  match w with
  | WTok t -> Ok "LinguaF.tok ${quote t}"
  | WMark m -> Ok "LinguaF.${m}"
  | WGroup inner ->
      (match elemsCode sorts tokenFields rule fs inner with
       | Ok code -> Ok "LinguaF.grouped ${code}"
       | Err failed -> Err failed)
  | WIndent inner ->
      (match elemsCode sorts tokenFields rule fs inner with
       | Ok code -> Ok "LinguaF.indented ${code}"
       | Err failed -> Err failed)
  | WIndentBy n inner ->
      (match elemsCode sorts tokenFields rule fs inner with
       | Ok code ->
           Ok
             "LinguaF.indentedBy (0 + ${if n < 0 then "(0 - ${show (0 - n)})" else show n}) ${code}"
       | Err failed -> Err failed)
  | WName n at ->
      match V.find (\f -> match f with | Field m _ _ _ -> m == n) fs with
      | None ->
          Err
            [Fail
               "${rule} has no child called `${n}`: it has ${S.join ", " (V.map (\f -> match f with | Field m _ _ _ -> "`${m}`") fs)} -- and its tokens, each written as it is, in quotes"
               at]
      | Just (Field _ ty _ token) ->
          let many = (match ty with | TMany _ -> True | _ -> False) in
          let kinds =
            (if token then
               V.concatMap
                 (\tf ->
                   match tf with
                   | TokenField r f ks -> if r == rule and f == n then ks else [])
                 tokenFields
             else V.map (\k -> "Node${k}") (kindsOf sorts (sortOf ty) []))
          in Ok
               "LinguaF.child [${S.join ", " (V.map quote kinds)}] ${if many then "True" else "False"}"

fun sortOf (ty : Ty) : String =
  match ty with
  | TSort n -> n
  | TMany t -> sortOf t
  | TOpt t -> sortOf t
  | TPrim _ -> ""

-- The rules a child of sort `n` may be a node of: its productions, and those
-- of each that is a choice of rules itself.
fun kindsOf sorts (n : String) (seen : [String]) : [String] =
  if V.elem n seen then []
  else
    match V.find (\s -> match s with | Sort m _ -> m == n) sorts with
    | None -> [n]
    | Just (Sort _ ps) ->
        V.concatMap
          (\p ->
            match p with
            | Prod m _ ->
                if m != n and V.any (\s -> match s with | Sort k _ -> k == m) sorts then
                  kindsOf sorts m (V.pushBack seen n)
                else [m])
          ps

fun quote (s : String) : String =
  "\""
    ++ S.join
      ""
      (V.map
         (\i ->
           let c = stringSlice s i (i + 1) in
           if c == "\"" then "\\\""
           else if c == "\\" then "\\\\"
           else if c == "$" then "\\$"
           else c)
         (V.range 0 (stringByteLength s)))
    ++ "\""

fun formatCode pub name grammar (unit : Int) (width : Int) (trivia : [String]) (rules : [String])
    : [TokenTree] =
  -- What the lexer skipped -- blank space before the first token, say --
  -- the parser keeps as `Unknown`, and trivia.
  let isTrivia =
    S.join "" (V.map (\k -> " | ${grammar}.${k} -> True") (V.pushBack trivia "Unknown"))
  in [Code "use Lingua.Format as LinguaF
use Std.Collections.Vector as LinguaV

-- `${name}`: how a ${grammar} tree is set out.
def lingua${name}_style =
  LinguaF.style ${show unit} ${show width} (\\k -> show k) (\\k -> match k with${isTrivia} | _ -> False) [${S.join ", " rules}]

-- The tree's text as `${name}` sets it out: ${if width > 0 then "laid out within ${show width} columns" else "every line set in, and broken where it was"}.
${pub}fun format${name} g = LinguaF.${if width > 0 then "layout" else "reindent"} lingua${name}_style g

-- What the line after an unfinished entry opens with.
${pub}fun indent${name} g = LinguaF.continuation lingua${name}_style g
"]
