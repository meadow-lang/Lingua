-- The editor: a language server over the compiler's own queries (`lsp!`).
-- Each feature asks the session, which works out only what the last edit
-- changed: hovering reads the elaboration, going to a definition the binders,
-- and neither runs again until the file does.

use Lingua (lsp!, repl!, mcp!)
use Lingua.Mcp as Mcp
use Lingua.Green (Green)
use Lingua.Repl (Reply)
use Lingua.Lsp (Asked, positionIn, pathOf)
use Std.Json as J
use Std.String as S
use Lingua.Red (Syntax)
use Lingua.Red as R
use Lingua.Diagnostic (renderToOutput)
use Lingua.Lang (Meta)
use MiniML.Syntax
use MiniML.Types
use MiniML.Infer
use MiniML.Compiler
use MiniML.Names
use Std.Collections.Vector as V
use Std.Maybe as M
use Std.Exn (toResult)
use Std.Result.Result.*

lsp! {
  pub Server "miniml" for Session threaded
    | opened = placeOf
    | text = setSessionSource
    | diagnostics = diagnosticsOf
    | tree = treeOf
    | hover = hoverAt
    | definition = definitionAt
    | references = referencesAt
    | completion = completionAt
    | symbols = symbolsOf
    | format = formattedOf
    | resolved = resolvedOf
    | requests = serverRequests
}

-- What MiniML's server answers itself: a request of its own, for what the
-- program in a file is, and one of the protocol's that Lingua has no
-- feature for -- a hint after the program, saying the same.
def serverRequests =
  [
    ("miniml/type", \db (a : Asked) -> J.jString (typeIn db a.file)),
    ("miniml/place", \db (a : Asked) -> J.jString (answered "" (\() -> sessionPlace db a.file))),
    ("textDocument/inlayHint", hintsOf)
  ]

-- Where a file the editor opened is on the disk: what a language whose
-- files are checked with their package's would read the rest of it from.
fun placeOf db file uri = setSessionPlace db file (pathOf uri)

fun typeIn db file = answered "" (\() -> match sessionTyped db file with | Ok t -> t | Err _ -> "")

fun hintsOf db (a : Asked) =
  let t = typeIn db a.file in
  if S.isEmpty t then J.jArray []
  else
    J.jArray
      [J.jObject [
         ("position", positionIn a (stringByteLength (S.trimEnd a.text))),
         ("label", J.jString ": ${t}"),
         ("paddingLeft", J.jBool True)
       ]]

-- The prompt (`repl!`), over the same session and with the server's own
-- features: what is typed is coloured from its tree, an entry the parser
-- found nothing wrong with but its end goes on to a new line -- indented as
-- the formatter says -- Tab completes from what can be seen where the cursor
-- is, and Ctrl-F finds a name among what the entry binds.
repl! {
  pub Prompt "miniml" for Session
    | text = setSessionSource
    | eval = shownIn
    | tree = treeOf
    | errors = errorsOf
    | completion = completionAt
    | declarations = declarationsOf
    | indent = indentStyle
    | commands = promptCommands
    | modes = promptModes
    | prompt = "> "
    | history = ".miniml_history"
}

-- A mode (`repl!` written `for Session mode`): a prompt of its own, entered
-- with `:scratch`, where each entry is run as at the prompt, and `:keep`
-- leaves it, handing the last entry back to begin the next line below.
repl! {
  Scratch "scratch" for Session mode
    | text = setSessionSource
    | eval = keptIn
    | commands = scratchCommands
    | start = scratchStarted
    | status = scratchStatus
    | prompt = "scratch> "
}

def promptModes = [("scratch", modeScratch)]

-- What the mode keeps between lines goes in an input of the database: the
-- last entry, as file 99. The entry being typed is file 0, and its text is
-- whatever is on the line.
def keptFile : Int = 99

fun keptIn db file =
  let u = setSessionSource db keptFile (answered "" (\() -> sessionSource db file)) in
  shownIn db file

fun scratchStarted db (arg : String) =
  if S.isEmpty arg then "scratch: try things, and :keep the last" else "scratch: ${arg}"

fun scratchStatus db file = "-- scratch --"

def scratchCommands =
  [
    (
      "keep",
      "",
      "leave, with the last entry for the line below",
      \db rest -> Reply.Back (answered "" (\() -> sessionSource db keptFile))
    ),
    ("drop", "", "leave, with nothing", \db rest -> Reply.Leave "")
  ]

-- What entering a program prints: its value and type, or its diagnostics
-- drawn against it.
fun shownIn db file =
  match toResult (\() -> sessionResult db file) with
  | Ok (Ok out) -> out
  | Ok (Err ds) -> renderToOutput "input.ml" (answered "" (\() -> sessionSource db file)) ds
  | Err e -> "miniml: a query could not be answered"

-- MiniML's own lines at the prompt: `:type`, what an expression is without
-- running it, and `:try`, which enters one to see.
def promptCommands =
  [
    ("type", "EXPR", "what an expression is, without running it", typeOfEntry),
    (
      "try",
      "",
      "enter an example",
      \db rest -> Reply.Entry "let double = fun x -> x + x in double 21"
    ),
    ("scratch", "[NOTE]", "try things in a scratch prompt", \db rest -> Reply.Mode "scratch" rest)
  ]

fun typeOfEntry db rest =
  let u = setSessionSource db 0 rest in
  match toResult (\() -> sessionTyped db 0) with
  | Ok (Ok t) -> Reply.Said "${rest} : ${t}"
  | Ok (Err ds) -> Reply.Said (renderToOutput "input.ml" rest ds)
  | Err e -> Reply.Said "miniml: a query could not be answered"

-- Where the parser found something wrong.
fun errorsOf db file = answered [] (\() -> V.map fst (snd (sessionParsed db file)))

-- What there is to find: everything the entry binds, and what kind of thing
-- each is.
fun declarationsOf db file =
  V.concatMap
    (\(b : Binder) ->
      if b.kind == "import" then [] else [(b.name, b.kind, "Bound in what is being typed.")])
    (bindersOf db file)

-- The file as MiniML's formatter sets it out (`format!`, in `Syntax`).
fun formattedOf db file = formatStyle (treeOf db file)

-- A query's answer, or `fallback` if it has none -- an input never set.
fun answered fallback act = match toResult act with | Ok x -> x | Err _ -> fallback

fun diagnosticsOf db file =
  answered [] (\() -> match sessionTyped db file with | Ok _ -> [] | Err ds -> ds)

fun treeOf db file = answered (fst (parseMini "")) (\() -> fst (sessionParsed db file))

fun contains (m : Meta) (at : Int) = match m with | Meta a b -> a <= at and at <= b

-- The type of the innermost expression the editor is on.
fun hoverAt db file at =
  answered None (\() ->
    match sessionElaborated db file with
    | Err _ -> None
    | Ok t ->
        let a = typedArena t in
        let around =
          V.filter (\x -> contains (metaTypedExpr a x) at) (subexpressions a (typedExpr t))
        in match V.get around (V.len around - 1) with
           | Just x -> Just (metaTypedExpr a x, "```\n${typeName (tyTypedExpr a x)}\n```")
           | None -> None)

-- The binders of a file: the side table name resolution filled.
fun bindersOf db file = answered [] (\() -> sessionNames db file)

-- The binder the editor is on, or the one the name it is on is a use of.
fun binderAt (bs : [Binder]) (at : Int) : Maybe Binder =
  V.find
    (\(b : Binder) ->
      b.kind != "import" and (contains b.at at or V.any (\u -> contains u at) b.uses))
    bs

fun definitionAt db file at =
  match binderAt (bindersOf db file) at with
  | Just b -> [(file, b.at)]
  | None -> []

-- The binder and every use of it.
fun referencesAt db file at =
  match binderAt (bindersOf db file) at with
  | Just b -> V.map (\m -> (file, m)) (V.pushFront b.uses b.at)
  | None -> []

-- The names that can be seen where the editor is, innermost first, and the
-- keywords.
fun completionAt db file at =
  let seen = V.filter (\(b : Binder) -> V.any (\s -> contains s at) b.scopes) (bindersOf db file) in
  let named =
    V.foldr
      (\(b : Binder) acc ->
        if V.any (\x -> fst x == b.name) acc then acc else V.pushBack acc (b.name, b.kind))
      []
      seen
  in V.append
       named
       (V.map (\k -> (k, "keyword")) [
          "let", "rec", "in", "fun", "if", "then", "else", "true", "false"
        ])

-- What name resolution knows of a name that its spelling does not: a name
-- bound to a function is a function's, where it is bound and wherever it is
-- used. Each by the byte it starts at. An entry still being typed -- `let f
-- x = x`, with no `in` yet -- is not a program, and has no names resolved:
-- then it is what the tree itself shows.
fun resolvedOf db file =
  let binders = bindersOf db file in
  if V.isEmpty binders then written (treeOf db file)
  else
    V.concatMap
      (\(b : Binder) ->
        if b.kind != "function" then []
        else V.map (\m -> match m with | Meta a _ -> (a, "function")) (V.pushFront b.uses b.at))
      binders

-- The same of a tree nothing was resolved in, by what is written: the name
-- of a `let` with parameters after it, or whose value is a `fun`, is a
-- function's -- and so is a name spelled as one of those, wherever it is.
-- No scope is known here, so a name that hides another is not told from
-- it; that is for when the entry is whole.
fun written (g : Green Mini) : [(Int, String)] =
  let nodes = everyNode (R.root g) in
  let bound =
    V.concatMap
      (\s ->
        match asMiniLet s with
        | None -> []
        | Just l ->
            (match miniLetName l with
             | None -> []
             | Just n ->
                 if not (V.isEmpty (miniLetParams l)) or isFun (miniLetValue l) then
                   [syntaxMiniName n]
                 else []))
      nodes
  in
  let names = V.map R.text bound in
  V.append
    (V.map (\n -> (R.offset n, "function")) bound)
    (V.concatMap
       (\s ->
         match asMiniNameRef s with
         | Just _ -> if V.elem (R.text s) names then [(R.offset s, "function")] else []
         | None -> [])
       nodes)

fun isFun (v : Maybe MiniExpr) : Bool = match v with | Just (MiniExpr.Lam _) -> True | _ -> False

fun everyNode (s : Syntax Mini) : [Syntax Mini] =
  if R.isTokenOf s then [] else V.pushFront (V.concatMap everyNode (R.children s)) s

-- Everything a `let` binds.
fun symbolsOf db file =
  V.concatMap
    (\(b : Binder) ->
      if b.kind == "parameter" or b.kind == "import" then [] else [(b.name, b.kind, b.at)])
    (bindersOf db file)

-- --- tests -------------------------------------------------------------------
--
-- What the server answers, asked of a session directly.

use Std.Test (assertEq)
use Std.Json as J
use Lingua.Lsp (formatReply)

fun editing src =
  let db = newSession () in
  let u = setSessionSource db 1 src in
  db

fun spelled src (ps : [(Int, Meta)]) =
  V.map
    (\p ->
      match snd p with
      | Meta a b -> "${stringSlice src a b}@${show a}")
    ps

@test fun aNameGoesToItsBinder () =
  let src = "let x = 1 in let x = x + 1 in x" in
  let db = editing src in
  -- The `x` in `x + 1` is the outer one: a `let` is not recursive.
  let a = assertEq (spelled src (definitionAt db 1 21)) ["x@4"] "the value's `x`" in
  assertEq (spelled src (definitionAt db 1 30)) ["x@17"] "the body's `x`"

@test fun aBinderIsFoundWithEveryUse () =
  let src = "let rec f n = if n < 2 then 1 else f (n - 1) in f 3" in
  let db = editing src in
  let a = assertEq (spelled src (referencesAt db 1 17)) ["n@10", "n@17", "n@38"] "a parameter" in
  assertEq
    (spelled src (referencesAt db 1 49))
    ["f@8", "f@35", "f@48"]
    "a recursive function, from a use"

@test fun completionOffersWhatCanBeSeen () =
  let src = "let id = fun x -> x in id 1" in
  let db = editing src in
  let names = \at -> V.filter (\n -> V.elem n ["id", "x"]) (V.map fst (completionAt db 1 at)) in
  -- Inside the function its parameter can be seen, and `id` cannot yet.
  let a = assertEq (names 18) ["x"] "in the lambda" in
  assertEq (names 23) ["id"] "in the body"

@test fun hoverSaysTheTypeWhereItIs () =
  let db = editing "let id = fun x -> x in id 1" in
  assertEq (hoverAt db 1 23) (Just (Meta 23 25, "```\n(Int -> Int)\n```")) "`id` at its use"

@test fun theSymbolsAreWhatLetsBind () =
  let db = editing "let id = fun x -> x in let one = id 1 in one" in
  assertEq
    (symbolsOf db 1)
    [("id", "function", Meta 4 6), ("one", "variable", Meta 27 30)]
    "not the parameter"

@test fun aFileIsFormattedAsOneEdit () =
  let src = "let x =\n1\nin x" in
  let db = editing src in
  let a =
    assertEq
      (formattedOf db 1)
      "let x = 1 in\nx"
      "the value after its `=`, and the body on its own line"
  in
  let b =
    assertEq
      (J.render (formatReply src (formattedOf db 1)))
      "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":2,\"character\":4}},\"newText\":\"let x = 1 in\\nx\"}]"
      "the whole file, replaced"
  in assertEq (J.render (formatReply "1" "1")) "[]" "and nothing to do for one already set out"

-- The prompt, given keys.

use Std.Console (withOutput)
use Std.Terminal as T
use Std.Terminal (Event, Key)
use Std.Terminal.Code.*
use Std.Char as C
use Std.Fs (removeFile)

fun typing (text : String) : [Key] = V.map (\c -> T.key (Character (C.toString c))) (S.chars text)

-- What the prompt writes, given `keys` and then no more: the last lines of
-- it that are not what it drew of the entries.
fun prompted (keys : [Key]) =
  let out =
    snd
      (withOutput (\() -> T.withEvents (V.map (\k -> Event.Pressed k) keys) (\() -> runPrompt ())))
  in
  let u = removeFile ".miniml_history" in
  out

@test fun anEntryIsEvaluatedWhenItIsEntered () =
  assertEq
    (S.contains "\n\r3 : Int\n" (prompted (V.append (typing "1 + 2") [T.key Enter])))
    True
    "its value and type, on a line of their own"

@test fun anUnfinishedEntryGoesOnIndented () =
  -- `let x =` is right as far as it goes: Enter starts a new line, a level
  -- in, and the entry is entered when it is whole.
  let out =
    prompted (V.concat [typing "let x =", [T.key Enter], typing "41 + 1 in x", [T.key Enter]])
  in
  let a = assertEq (S.contains "42 : Int" out) True "the whole of it, evaluated" in
  assertEq
    (S.contains "\n\r    \u{1b}[38;5;215m41" out)
    True
    "its second line after the prompt's width and a level in, the number coloured"

@test fun aWrongEntryIsEnteredAndSaidToBeWrong () =
  assertEq
    (S.contains "cannot unify" (prompted (V.append (typing "1 + true") [T.key Enter])))
    True
    "an error inside it is not something to go on from"

@test fun aNameIsFoundAndPutWhereTheCursorWas () =
  -- Ctrl-F, `tot` to find `total`, Enter to take it, Enter to enter the entry.
  let out =
    prompted
      (V.concat [
         typing "let total = 7 in to",
         [T.ctrl "f"],
         typing "tot",
         [T.key Enter, T.key Enter]
       ])
  in assertEq (S.contains "7 : Int" out) True "`to` became `total`"

@test fun tabCompletesANameThatCanBeSeen () =
  assertEq
    (S.contains
       "7 : Int"
       (prompted (V.concat [typing "let total = 7 in tot", [T.key Tab, T.key Enter]])))
    True
    "the one way it could go on"

-- Colour: by spelling, and by what a name resolved to.

use Lingua.Lsp (classOf)

@test fun aNameIsColouredByWhatItResolvedTo () =
  -- `f` is bound to a function and `x` is not: the same spelling of token,
  -- told apart where each is bound and where each is used.
  let src = "let f = fun x -> x in f 1" in
  let db = editing src in
  let classes = tokensServer db 1 in
  let at =
    \from -> V.concatMap (\c -> match c with | (a, _, k) -> if a == from then [k] else []) classes
  in
  let a =
    assertEq (at 4, at 22) ([classOf "function"], [classOf "function"]) "`f`, bound and used"
  in
  let b = assertEq (at 12, at 17) ([classOf "variable"], [classOf "variable"]) "`x`, a parameter" in
  assertEq
    (at 0, at 24)
    ([classOf "keyword"], [classOf "number"])
    "and what a spelling says is as it was"

@test fun thePromptShowsAFunctionsNameAndAnotherNameApart () =
  -- `f` is a function's name and `x` is not. In the theme a prompt starts
  -- in, a function's name has a colour and another name is as it is; in
  -- `bright`, each has its own.
  let out = prompted (V.append (typing "let f = fun x -> x in f 1") [T.key Enter]) in
  let a =
    assertEq
      (S.contains "\u{1b}[38;5;117mf\u{1b}[0m" out, S.contains " x " out)
      (True, True)
      "the function's name coloured, the parameter's plain"
  in
  let bright =
    prompted
      (V.concat [
         typing ":theme bright",
         [T.key Enter],
         typing "let f = fun x -> x in f 1",
         [T.key Enter]
       ])
  in assertEq
       (S.contains "\u{1b}[93mf\u{1b}[0m" bright, S.contains "\u{1b}[94mx\u{1b}[0m" bright)
       (True, True)
       "and in `bright`, a colour each"

@test fun anUnfinishedEntrysFunctionsAreColouredAsTheyAreWritten () =
  -- No `in` yet, so nothing is resolved: a `let` with parameters after its
  -- name, a `let rec`, and a `let` of a `fun` are functions by how they are
  -- written, and so is a use of one.
  let functions =
    \src ->
      V.concatMap
        (\c ->
          match c with
          | (a, b, k) ->
              if k == classOf "function" then ["${stringSlice src a b}@${show a}"] else [])
        (tokensServer (editing src) 1)
  in
  let a = assertEq (functions "let foo a = a") ["foo@4"] "parameters after the name" in
  let b =
    assertEq (functions "let rec f n = f n") ["f@8", "f@14"] "a `let rec`, and its use of itself"
  in
  let c = assertEq (functions "let g = fun x ->") ["g@4"] "a `fun` as the value" in
  let d = assertEq (functions "let x = 1") [] "and a plain `let` is no function" in
  assertEq
    (functions "let foo a = a in foo 1")
    ["foo@4", "foo@17"]
    "whole, it is resolved, as before"

@test fun aThemeIsChosenAtThePrompt () =
  -- `:theme quiet` is for the prompt, not MiniML: it is not evaluated, and
  -- what is typed after it is shown as that theme shows it -- a number
  -- magenta, where it was orange.
  let out =
    prompted
      (V.concat [
         typing "12",
         [T.key Enter],
         typing ":theme quiet",
         [T.key Enter],
         typing "34",
         [T.key Enter]
       ])
  in
  let a =
    assertEq
      (S.contains "\u{1b}[38;5;215m12\u{1b}[0m" out)
      True
      "before, as the first theme has a number"
  in
  let b = assertEq (S.contains "\u{1b}[35m34\u{1b}[0m" out) True "after, as `quiet` has it" in
  assertEq
    (S.contains "34 : Int" out and not (S.contains "Error" out))
    True
    "and the line that chose it was no program"

@test fun aCommandOfTheLanguagesIsRunWithTheRestOfItsLine () =
  let out = prompted (V.append (typing ":type 1 + 2") [T.key Enter]) in
  assertEq
    (S.contains "1 + 2 : Int\n" out and not (S.contains "3 : Int" out))
    True
    "what it is, and it was not run"

@test fun aCommandMayEnterAnEntry () =
  assertEq
    (S.contains "42 : Int\n" (prompted (V.append (typing ":try") [T.key Enter])))
    True
    "what `:try` enters is evaluated as if it had been typed"

@test fun helpSaysTheLanguagesCommandsAndThePromptsOwn () =
  let out = prompted (V.append (typing ":help") [T.key Enter]) in
  assertEq
    (S.contains ":type EXPR" out and S.contains ":theme [NAME]" out and S.contains ":quit" out)
    True
    "each with what is written after it"

@test fun quitEndsThePrompt () =
  let out = prompted (V.concat [typing ":quit", [T.key Enter], typing "12", [T.key Enter]]) in
  assertEq (S.contains "12 : Int" out) False "what is typed after it is not read"

@test fun tabCompletesACommandAtThePrompt () =
  assertEq
    (S.contains
       "7 : Int\n"
       (prompted (V.concat [typing ":ty", [T.key Tab], typing " 7", [T.key Enter]])))
    True
    "`:ty`, Tab, is `:type`"

-- --- the server, told what an editor would tell it ---------------------------

use Lingua.Lsp (told)
use Std.Json (Json)

fun message (fields : [(String, Json)]) : Json =
  J.jObject (V.pushFront fields ("jsonrpc", J.jString "2.0"))

fun asking (id : Int) (method : String) (params : Json) : Json =
  message [("id", J.jInt id), ("method", J.jString method), ("params", params)]

fun inFile (uri : String) : Json = J.jObject [("textDocument", J.jObject [("uri", J.jString uri)])]

fun opening (uri : String) (text : String) : Json =
  message [
    ("method", J.jString "textDocument/didOpen"),
    (
      "params",
      J.jObject [("textDocument", J.jObject [("uri", J.jString uri), ("text", J.jString text)])]
    )
  ]

@test fun theServerAnswersARequestOfMiniMLsOwn () =
  let said =
    told
      [opening "file:///a.ml" "1 + 2\n", asking 1 "miniml/type" (inFile "file:///a.ml")]
      serveServerInTurn
  in assertEq
       (M.andThen (J.get "result") (V.get said 1))
       (Just (J.jString "Int"))
       "what the program is, from the session an edit set the text of"

@test fun theServerAnswersAMethodLinguaHasNoFeatureFor () =
  let said =
    told
      [
        asking 1 "initialize" (J.jObject []),
        opening "file:///a.ml" "1 + 2\n",
        asking 2 "textDocument/inlayHint" (inFile "file:///a.ml")
      ]
      serveServerInTurn
  in
  let a =
    assertEq
      (M.andThen (J.path ["result", "capabilities", "inlayHintProvider"]) (V.get said 0))
      (Just (J.jBool True))
      "it says it gives hints, having been given what answers them"
  in assertEq
       (M.andThen (J.get "result") (V.get said 2))
       (Just
          (J.jArray
             [J.jObject [
                ("position", J.jObject [("line", J.jInt 0), ("character", J.jInt 5)]),
                ("label", J.jString ": Int"),
                ("paddingLeft", J.jBool True)
              ]]))
       "a hint where the program ends, saying what it is"

@test fun aModeIsEnteredWorkedInAndLeftWithWhatItKept () =
  let out =
    prompted
      (V.concat [
         typing ":scratch",
         [T.key Enter],
         typing "40 + 1",
         [T.key Enter],
         typing "40 + 2",
         [T.key Enter],
         typing ":keep",
         [T.key Enter],
         [T.key Enter]
       ])
  in
  let a =
    assertEq
      (S.contains "scratch: try things" out and S.contains "-- scratch --" out)
      True
      "it says it began, and shows its status above its lines"
  in
  let b = assertEq (S.contains "41 : Int" out) True "what is entered in it is run" in
  assertEq
    (S.contains "scratch> " out and V.len (S.split "42 : Int" out) == 3)
    True
    "under its own prompt; and what it kept begins the next line below, entered there too"

@test fun theServerIsToldWhereAnOpenedFileIs () =
  let said =
    told
      [
        opening "file:///c%3A/work/a.ml" "1 + 2\n",
        asking 1 "miniml/place" (inFile "file:///c%3A/work/a.ml")
      ]
      serveServerInTurn
  in assertEq
       (M.andThen (J.get "result") (V.get said 1))
       (Just (J.jString "c:/work/a.ml"))
       "its path"

-- --- tools for an agent (`mcp!`) ---------------------------------------------
--
-- MiniML over the Model Context Protocol, from the same session: a tool that
-- says what type a program has, and one that gives its type and value as
-- data, in a file of the agent's choosing.
mcp! {
  pub Agent "miniml" for Session
    | instructions = "Type and run MiniML programs."
    | tool typeOf "the type of a MiniML program" (source : String) = typeTool
    | tool describe "a program's type and value, in a file" (source : String, file : Maybe Int) =
        describeTool
}

fun typeTool db (source : String) =
  let u = setSessionSource db 1 source in
  match sessionTyped db 1 with
  | Ok t -> Ok t
  | Err _ -> Err "the program has no type: it has a mistake in it"

fun describeTool db (source : String) (file : Maybe Int) =
  let n = M.unwrapOr 1 file in
  let u = setSessionSource db n source in
  match sessionTyped db n with
  | Ok t ->
      Ok
        (J.jObject [
           ("file", J.jInt n),
           ("type", J.jString t),
           ("shown", J.jString (sessionShown db n))
         ])
  | Err _ -> Err "the program has no type: it has a mistake in it"

@test fun anAgentIsServedTheLanguagesTools () =
  let callTool =
    \id n args ->
      J.jObject [
        ("jsonrpc", J.jString "2.0"),
        ("id", J.jInt id),
        ("method", J.jString "tools/call"),
        ("params", J.jObject [("name", J.jString n), ("arguments", args)])
      ]
  in
  let said =
    Mcp.told
      [
        J.jObject [
          ("jsonrpc", J.jString "2.0"),
          ("id", J.jInt 1),
          ("method", J.jString "tools/list")
        ],
        callTool 2 "typeOf" (J.jObject [("source", J.jString "fun x -> x + 1")]),
        callTool 3 "typeOf" (J.jObject [("source", J.jString "1 + true")]),
        callTool 4 "describe" (J.jObject [("source", J.jString "1 + 2"), ("file", J.jInt 7)])
      ]
      serveAgent
  in
  let names =
    V.map
      (\t -> M.andThen J.asString (J.get "name" t))
      (M.unwrapOr [] (M.andThen J.asArray (M.andThen (J.path ["result", "tools"]) (V.get said 0))))
  in
  let required =
    M.andThen (J.path ["result", "tools"]) (V.get said 0)
      |> M.andThen (J.index 1)
      |> M.andThen (J.path ["inputSchema", "required"])
  in
  let a =
    assertEq
      (names, required)
      ([Just "typeOf", Just "describe"], Just (J.jArray [J.jString "source"]))
      "the tools, a `Maybe` one not required"
  in
  let b =
    assertEq
      (
        M.andThen (J.path ["result", "content"]) (V.get said 1)
          |> M.andThen (J.index 0)
          |> M.andThen (J.get "text"),
        M.andThen (J.path ["result", "isError"]) (V.get said 2)
      )
      (Just (J.jString "(Int -> Int)"), Just (J.jBool True))
      "a type, and a program with none an error of the tool's"
  in assertEq
       (M.andThen (J.path ["result", "structuredContent"]) (V.get said 3) |> M.map J.render)
       (Just
          (J.render
             (J.jObject [
                ("file", J.jInt 7),
                ("type", J.jString "Int"),
                ("shown", J.jString "3 : Int")
              ])))
       "a value as data, in the file asked for"
