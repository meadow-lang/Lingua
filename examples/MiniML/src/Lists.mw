-- A grammar in the shapes Meadow's own has, for what `format!` does with
-- them: a list whose commas are tokens between its items, with one after
-- the last or not; a `match` with arms; and a `let` whose body is a level of
-- precedence -- a node holding one node -- above the `let` it may be; an
-- operator; and an attribute on what follows it.

use Scythe (lexer!)
use Lingua (syntax!, format!)
use Std.Collections.Vector as V
use Std.String as S
use Std.Test (assertEq)

@derive(Lexer)
@pub data Tok
  = @regex("[ \t\r\n]+") Space
  | @regex("--[^\n]*") Comment
  | @token("let") Let
  | @token("in") In
  | @token("match") Match
  | @token("with") With
  | @token("|") Bar
  | @token("->") Arrow
  | @token("=") Equals
  | @token("[") Open
  | @token("]") Close
  | @token(",") Comma
  | @token("+") Plus
  | @token("@") At
  | @token("(") LParen
  | @token(")") RParen
  | @regex("[a-z0-9]+") Name String

syntax! {
  Lists
  lexer Tok
  trivia { Space, Comment }
  tokens {
    "let" = Let,
    "in" = In,
    "match" = Match,
    "with" = With,
    "|" = Bar,
    "->" = Arrow,
    "=" = Equals,
    "[" = Open,
    "]" = Close,
    "," = Comma,
    "+" = Plus,
    "@" = At,
    "(" = LParen,
    ")" = RParen,
    "name" = Name _
  }
  grammar {
    File = items:Expr*
    Expr = first:Term rest:Tail*
    Tail = op:"+" operand:Term
    Term = List | LetE | MatchE | Tagged | Var
    Tagged = attr:Attr expr:Expr
    Attr = "@" name:Var "(" arg:Var ")"
    List = "[" items:(Expr ("," Expr)* ","?)? "]"
    LetE = "let" name:Var "=" value:Expr "in" body:Expr
    MatchE = "match" scrutinee:Expr "with" arms:(Arm Arm*)
    Arm = "|" pat:Var "->" body:Expr
    Var = "name"
  }
}

-- A list's items parted by their commas, which break with it; a `match` and
-- its arms on one line only while there are two arms at most; and a chain of
-- `let`s a step to a line once it is two steps long. An operator is spaced
-- as it was written; and what `@fmt(skip)` is on is kept as it was.
format! {
  Listed for Lists
  indent 2
  width 40
  skip "@fmt(skip)"
    | File = items(newline)
    | Tagged = attr aswritten expr
    | Expr = first rest
    | Tail = kept op kept operand
    | List = "[" indent(cut items(tight "," line)) cut "]"
    | LetE = "let" name "=" value "in" line body breaks 2 body
    | MatchE = "match" scrutinee "with" indent(arms) breaks 3 arms
    | Arm = line "|" pat "->" body
}

fun listed (src : String) : String = formatListed (fst (parseLists src))

format! {
  Plain for Lists
  indent 2
  width 60
}

fun plain (src : String) : String = formatPlain (fst (parseLists src))

@test fun aListsCommasAreBetweenItsItems () =
  let a = assertEq (listed "[a,b ,  c]") "[a, b, c]" "each after an item, and a space after it" in
  let b = assertEq (listed "[a, b,]") "[a, b,]" "one after the last is kept, as it was" in
  let c = assertEq (listed "[]") "[]" "and none of nothing" in
  assertEq
    (listed "[aaaaaaaaaa, bbbbbbbbbb, cccccccccc, dddddddddd,]")
    "[\n  aaaaaaaaaa,\n  bbbbbbbbbb,\n  cccccccccc,\n  dddddddddd,\n]"
    "broken, an item a line, each comma at the end of its item's line"

@test fun aBlankLineBetweenItemsIsKept () =
  assertEq (listed "[a,\n\n\nb]") "[\n  a,\n\n  b\n]" "one, which breaks the list"

@test fun aGroupBreaksWhenWhatItCountsIsLongEnough () =
  let a =
    assertEq
      (listed "match x with | a -> b | c -> d")
      "match x with | a -> b | c -> d"
      "two arms: one line, as it fits"
  in
  let b =
    assertEq
      (listed "match x with | a -> b | c -> d | e -> f")
      "match x with\n  | a -> b\n  | c -> d\n  | e -> f"
      "three: an arm a line, though they would fit on one"
  in assertEq
       (listed "match x with | a -> b\n\n| c -> d")
       "match x with\n  | a -> b\n\n  | c -> d"
       "and two with a blank line between them"

@test fun aChainIsCountedThroughWhatHoldsEachStep () =
  let a = assertEq (listed "let a = x in a") "let a = x in a" "one step: one line" in
  let b =
    assertEq
      (listed "let a = x in let b = y in b")
      "let a = x in\nlet b = y in\nb"
      "two: a step to a line, the inner one too, though each would fit"
  in assertEq
       (listed "let a = [x, let b = y in b] in a")
       "let a = [x, let b = y in b] in a"
       "and a `let` inside another's value is no step of its chain"

@test fun aListLaidOutChangesOnlyTheSpace () =
  let srcs =
    [
      "[a, b,]",
      "[a,,b]",
      "[a b]",
      "match x with | a -> [b, c,] | d -> e | f -> g",
      "let a = [x,\n-- one\ny] in let b = a in b"
    ]
  in
  let squeezed = \s -> S.join "" (S.split " " (S.join "" (S.split "\n" s))) in
  let a =
    assertEq
      (V.map (\s -> squeezed (listed s)) srcs)
      (V.map squeezed srcs)
      "every token still there, in order"
  in assertEq (V.map (\s -> listed (listed s)) srcs) (V.map listed srcs) "and twice is once"

@test fun anOperatorIsSpacedAsItWasWritten () =
  assertEq
    (V.map listed ["a+b", "a + b", "a+ b", "a  +\n   b", "[a+b, c + d]"])
    ["a+b", "a + b", "a+ b", "a + b", "[a+b, c + d]"]
    "touching stays touching, apart stays apart, and apart is one space"

@test fun whatAnAttributeKeepsIsAsItWasWritten () =
  let a =
    assertEq
      (listed "[a,@fmt(skip) [b,c  ,d],e]")
      "[a, @fmt(skip) [b,c  ,d], e]"
      "what it is on as it was, and what is around it laid out"
  in
  let b =
    assertEq
      (listed "[a,@other(x) [b,c  ,d],e]")
      "[a, @other(x) [b, c, d], e]"
      "another attribute keeps nothing"
  in
  let c =
    assertEq
      (listed "[aaaaaaaaaa, @fmt(skip) [b,\n    c], dddddddddd, eeeeeeeeee]")
      "[\n  aaaaaaaaaa,\n  @fmt(skip) [b,\n    c],\n  dddddddddd,\n  eeeeeeeeee\n]"
      "its lines as they were, wherever it is put"
  in assertEq
       (formatListedWithin 0 (fst (parseLists "[a,\n@fmt(skip) [b,\nc],\nd]")))
       "[a,\n  @fmt(skip) [b,\nc],\n  d]"
       "and when only indenting, a line that starts inside it is left alone"

@test fun aCommentThatEndsALineStaysAtItsEnd () =
  let a = assertEq (listed "[x] -- after\n[y]") "[x] -- after\n[y]" "after a separator's break" in
  assertEq
    (listed "[aaaaaaaaaa, -- one\nbbbbbbbbbb, cccccccccc, dddddddddd]")
    "[\n  aaaaaaaaaa, -- one\n  bbbbbbbbbb,\n  cccccccccc,\n  dddddddddd\n]"
    "and after the comma it followed, the list broken"

@test fun aBlankLineAfterACommentIsKept () =
  let a =
    assertEq
      (listed "-- top\n\n[x]\n\n-- c\n\n[y]\n")
      "-- top\n\n[x]\n\n-- c\n\n[y]\n"
      "after a comment, as before one"
  in assertEq (listed "[x]\n-- c\n\n[y]") "[x]\n-- c\n\n[y]" "and only where it was"

@test fun theRootsLinesStayWhereTheyWere () =
  assertEq
    (plain "[x]\n[y]\n\n  [z]")
    "[x]\n[y]\n\n  [z]"
    "a file with no rule: its items are not taken for lines that go on"

@test fun asWrittenKeepsABreakASpaceOrNothing () =
  assertEq
    (V.map listed ["@a(b)\n[x]", "@a(b)   [x]", "@a(b)[x]", "@a(b)\n\n\n[x]"])
    ["@a(b)\n[x]", "@a(b) [x]", "@a(b)[x]", "@a(b)\n\n[x]"]
    "a break, a space, nothing, and a blank line, as the text had them"

-- The same shapes from a lexer that skips blank space and comments, as Meadow's
-- does: the parser keeps what it skipped as runs, a comment and the breaks
-- around it in one piece.
@derive(Lexer)
@pub data Bare
  = @regex("[ \t\r\n]+") @skip Space
  | @regex("--[^\n]*") @skip Comment
  | @token("[") Open
  | @token("]") Close
  | @token(",") Comma
  | @regex("[a-z0-9]+") Name String

syntax! {
  Skips
  lexer Bare
  tokens { "[" = Open, "]" = Close, "," = Comma, "name" = Name _ }
  grammar {
    File = items:Item*
    Item = List | Var
    List = "[" items:(Var ("," Var)*)? "]"
    Var = "name"
  }
}

format! {
  SkipsPlain for Skips
  indent 2
  width 40
}

format! {
  SkipsFiled for Skips
  indent 2
  width 40
    | File = items(newline)
    | List = "[" items(tight "," line) "]"
}

@test fun aCommentRunIsWrittenWithItsBreaks () =
  let src = "-- a comment\nx\n\ny -- after\n-- before z\nz\n" in
  let a = assertEq (formatSkipsPlain (fst (parseSkips src))) src "with no rule" in
  assertEq (formatSkipsFiled (fst (parseSkips src))) src "and with a rule for the file"
